---
import { getCollection, render } from 'astro:content';
import { isDefaultLocaleId } from '../../i18n/config';
import Post from '../../layouts/Post.astro';

export async function getStaticPaths() {
	const posts = await getCollection('low-spoon-cooking', p => !p.data.draft && isDefaultLocaleId(p.id));
	return posts.map(p => ({ params: { slug: p.id }, props: p }));
}

const post = Astro.props;
const { Content } = await render(post);
---

<Post
	title={post.data.title}
	description={post.data.description}
	pubDate={post.data.pubDate}
	updatedDate={post.data.updatedDate}
	section="low-spoon-cooking"
	sectionLabel="Low Spoon Cooking"
	sectionHref="/low-spoon-cooking/"
	series={post.data.series}
	ogImage={post.data.ogImage}
	lastModified={post.data.lastModified}
	spoons={post.data.spoons}
>
	<Content />
</Post>
