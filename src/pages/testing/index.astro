---
import { getCollection } from 'astro:content';
import { isDefaultLocaleId } from '../../i18n/config';
import Page from '../../layouts/Page.astro';
import SectionIndex from '../../components/SectionIndex.astro';

const posts = (await getCollection('testing', p => !p.data.draft && isDefaultLocaleId(p.id)))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map(p => ({ ...p, href: `/testing/${p.id}/` }));
---

<Page
	title="Testing: Headaches & Heartbeats"
	description="Structured first-person accounts of specific interventions for post-viral syndrome, with data where available."
>
			<SectionIndex
				title="Testing"
				description="Structured first-person accounts of interventions"
				section="testing"
				posts={posts}
				intro="Structured write-ups of specific things I'm trying: Nurosym vagal nerve stimulation, diaphragmatic breathing, recumbent exercise, medications, and supplements, with HRV and RHR data where I have it. Each intervention gets an introductory post, then periodic updates."
			/>
</Page>
