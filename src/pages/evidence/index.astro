---
import { getCollection } from 'astro:content';
import { isDefaultLocaleId } from '../../i18n/config';
import Page from '../../layouts/Page.astro';
import SectionIndex from '../../components/SectionIndex.astro';

const posts = (await getCollection('evidence', p => !p.data.draft && isDefaultLocaleId(p.id)))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map(p => ({ ...p, href: `/evidence/${p.id}/` }));
---

<Page
	title="Evidence: Headaches & Heartbeats"
	description="Accessible summaries of the research behind specific interventions and diagnostic concepts in post-viral syndrome and dysautonomia."
>
			<SectionIndex
				title="Evidence"
				description="Evidence reviews"
				section="evidence"
				posts={posts}
				intro="Accessible readings of the research behind interventions and diagnostic concepts, written from an educated-amateur standpoint with appropriate caveats. These pieces always weave in my own data and experience rather than just summarising literature."
			/>
</Page>
