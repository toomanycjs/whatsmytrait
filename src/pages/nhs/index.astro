---
import { getCollection } from 'astro:content';
import { isDefaultLocaleId } from '../../i18n/config';
import Page from '../../layouts/Page.astro';
import SectionIndex from '../../components/SectionIndex.astro';

const posts = (await getCollection('nhs', p => !p.data.draft && isDefaultLocaleId(p.id)))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map(p => ({ ...p, href: `/nhs/${p.id}/` }));
---

<Page
	title="NHS: Headaches & Heartbeats"
	description="Practical, experience-based guidance on getting appropriate care for post-viral conditions through the NHS."
>
			<SectionIndex
				title="NHS"
				description="Navigating the system"
				section="nhs"
				posts={posts}
				intro="Practical, experience-based guidance on getting appropriate care for post-viral conditions through the NHS: what to ask for, how to frame it, how referral pathways work, and how to advocate for yourself without alienating clinicians. Always framed as personal experience, not complaints."
			/>
</Page>
