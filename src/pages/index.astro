---
import { getCollection } from 'astro:content';
import { isDefaultLocaleId } from '../i18n/config';
import Page from '../layouts/Page.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { GUIDE, QUESTIONNAIRE_GROUPS, TRACKERS } from '../tools/catalogue';

const [testing, evidence, cooking] = await Promise.all([
	getCollection('testing', p => !p.data.draft && isDefaultLocaleId(p.id)),
	getCollection('evidence', p => !p.data.draft && isDefaultLocaleId(p.id)),
	getCollection('low-spoon-cooking', p => !p.data.draft && isDefaultLocaleId(p.id)),
]);

type PostItem = {
	id: string;
	data: { title: string; description: string; pubDate: Date };
	section: 'testing' | 'evidence' | 'low-spoon-cooking';
	label: string;
	href: string;
};

const allPosts: PostItem[] = [
	...testing.map(p => ({ ...p, section: 'testing' as const, label: 'Testing', href: `/testing/${p.id}/` })),
	...evidence.map(p => ({ ...p, section: 'evidence' as const, label: 'Evidence', href: `/evidence/${p.id}/` })),
	...cooking.map(p => ({ ...p, section: 'low-spoon-cooking' as const, label: 'Low Spoon Cooking', href: `/low-spoon-cooking/${p.id}/` })),
].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const recentPosts = allPosts.slice(0, 6);
const toolCount = QUESTIONNAIRE_GROUPS.reduce((n, g) => n + g.tools.length, 0);
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<header class="intro">
		<h1>Post Viral Recovery</h1>
		<p class="lede">
			Validated questionnaires with instant scoring, trackers that keep your data on your own device, plain readings of the evidence, and practical guidance on getting care through the NHS. For post-viral illness, dysautonomia, POTS and ME/CFS.
		</p>
	</header>

	<section class="tools" aria-labelledby="tools-heading">
		<div class="section-head">
			<h2 id="tools-heading">Questionnaires and tools</h2>
			<a href="/tools/" class="all-link">All {toolCount} tools</a>
		</div>
		<p class="section-note">
			Free, no sign-up, scored in the browser. Results can be saved on your device and brought to an appointment.
			<span class="saved-results" hidden><a href="/tools/my-results/">Your saved results <span class="saved-count"></span></a></span>
		</p>
		<dl class="index">
			{QUESTIONNAIRE_GROUPS.map(group => (
				<div class="index-row">
					<dt>{group.name}</dt>
					<dd>
						{group.tools.map((tool, i) => (
							<>
								{i > 0 && <span class="sep" aria-hidden="true">·</span>}
								<a href={tool.href}>{tool.short}</a>
							</>
						))}
					</dd>
				</div>
			))}
			<div class="index-row">
				<dt>Trackers</dt>
				<dd>
					{TRACKERS.map((tool, i) => (
						<>
							{i > 0 && <span class="sep" aria-hidden="true">·</span>}
							<a href={tool.href}>{tool.short}</a>
						</>
					))}
				</dd>
			</div>
		</dl>
		<p class="start">
			Not sure where to begin? <a href={GUIDE.href}>{GUIDE.short}</a> or <a href="/testing/do-i-have-pots/">Do I have POTS?</a>
		</p>
	</section>

	{recentPosts.length > 0 && (
		<section class="recent" aria-labelledby="recent-heading">
			<div class="section-head">
				<h2 id="recent-heading">Recent posts</h2>
			</div>
			<ul class="post-list">
				{recentPosts.map(post => (
					<li>
						<a href={post.href} class="post-item">
							<div class="post-meta">
								<span class={`section-label ${post.section}`}>{post.label}</span>
								<time class="post-date"><FormattedDate date={post.data.pubDate} /></time>
							</div>
							<h3>{post.data.title}</h3>
							<p>{post.data.description}</p>
						</a>
					</li>
				))}
			</ul>
		</section>
	)}

	<section class="areas" aria-labelledby="areas-heading">
		<div class="section-head">
			<h2 id="areas-heading">What is here</h2>
		</div>
		<dl class="index">
			<div class="index-row">
				<dt><a href="/testing/" class="section-label testing">Testing</a></dt>
				<dd>Intervention logs: Nurosym, breathing, recumbent exercise, medications and supplements, with heart rate and HRV data where it exists. Also practical guidance on getting care through the NHS.</dd>
			</div>
			<div class="index-row">
				<dt><a href="/evidence/" class="section-label evidence">Evidence</a></dt>
				<dd>Readings of the research behind interventions and diagnostic concepts, with the caveats left in.</dd>
			</div>
			<div class="index-row">
				<dt><a href="/tools/" class="section-label tools">Tools</a></dt>
				<dd>Interactive versions of validated clinical questionnaires, plus trackers for HRV, symptoms and stand tests.</dd>
			</div>
			<div class="index-row">
				<dt><a href="/low-spoon-cooking/" class="section-label low-spoon-cooking">Low Spoon Cooking</a></dt>
				<dd>Recipes that are low effort but high reward, rated from one to five spoons, with UK supermarket costs per portion.</dd>
			</div>
		</dl>
	</section>
</Page>

<script>
	// Link to /tools/my-results/ with a count, shown only when this browser has saved results.
	import { readAll } from '../scripts/results/resultsStore';
	const n = readAll().length;
	const link = document.querySelector<HTMLElement>('.saved-results');
	if (link && n > 0) {
		link.querySelector('.saved-count')!.textContent = `(${n})`;
		link.hidden = false;
	}
</script>

<style>
	.intro {
		padding-bottom: 1.75em;
		border-bottom: 1px solid rgb(var(--gray-dark));
		margin-bottom: 2.25em;
	}
	h1 {
		font-size: 2.6em;
		margin-bottom: 0.35em;
	}
	.lede {
		font-size: 1.08em;
		color: rgb(var(--gray-dark));
		line-height: 1.6;
		margin: 0;
		text-wrap: pretty;
	}

	section { margin-bottom: 3em; }
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1em;
		margin-bottom: 0.6em;
	}
	.section-head h2 { margin: 0; font-size: 1.5em; }
	.all-link {
		font-size: 0.9em;
		white-space: nowrap;
	}
	.section-note {
		color: rgb(var(--gray));
		font-size: 0.92em;
		margin: 0 0 1em;
	}
	.saved-results { font-weight: 700; margin-left: 0.35em; }
	.saved-results a { color: var(--accent); }
	.saved-count { font-weight: 400; color: rgb(var(--gray)); }

	/* The index: a subject on the left, its entries on the right, ruled rows */
	.index {
		margin: 0;
		padding: 0;
		border-top: 1px solid rgb(var(--gray-dark));
	}
	.index-row {
		display: grid;
		grid-template-columns: 13.5em 1fr;
		gap: 0 1.5em;
		padding: 0.8em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.index dt {
		font-weight: 700;
		color: rgb(var(--black));
		font-size: 0.95em;
		line-height: 1.5;
	}
	.index dd {
		margin: 0;
		font-size: 0.95em;
		line-height: 1.7;
		color: rgb(var(--gray-dark));
	}
	.index dd a {
		color: rgb(var(--black));
		text-decoration: none;
		white-space: nowrap;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.index dd a:hover { color: var(--accent); border-bottom-color: var(--accent); }
	.sep { color: rgb(var(--gray)); margin: 0 0.45em; }
	.start {
		margin: 1em 0 0;
		font-size: 0.95em;
		color: rgb(var(--gray-dark));
	}

	/* Recent posts */
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid rgb(var(--gray-dark));
	}
	.post-item {
		display: block;
		padding: 1em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
		text-decoration: none;
	}
	.post-item:hover h3 { color: var(--accent); }
	.post-meta {
		display: flex;
		align-items: baseline;
		gap: 0.6em;
		margin-bottom: 0.2em;
	}
	.post-date {
		font-size: 0.82em;
		color: rgb(var(--gray));
	}
	.post-item h3 {
		margin: 0 0 0.25em;
		font-size: 1.15em;
		color: rgb(var(--black));
		line-height: 1.3;
	}
	.post-item p {
		margin: 0;
		font-size: 0.9em;
		color: rgb(var(--gray));
		line-height: 1.5;
	}

	.areas .index dt .section-label { font-size: 1em; }

	@media (max-width: 600px) {
		.index-row { grid-template-columns: 1fr; gap: 0.15em 0; }
		.index dt { font-size: 0.9em; }
		.section-head { flex-direction: column; gap: 0.2em; }
	}
</style>
