---
import Page from '../../../layouts/Page.astro';
---

<Page
	title="Free HRV and resting heart rate tracker: log daily readings, see medians and trends"
	description="A free HRV and resting heart rate tracker that runs in your browser. Log daily readings or import a CSV from Garmin, Oura, Whoop, Apple Health or a spreadsheet. Rolling medians and trend charts, stored on your device only."
>
	<Fragment slot="head">
		<script type="application/ld+json">
	{
	  "@context": "https://schema.org",
	  "@graph": [
	    {
	      "@type": "BreadcrumbList",
	      "itemListElement": [
	        {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.postviralrecovery.com/"},
	        {"@type": "ListItem", "position": 2, "name": "Tools", "item": "https://www.postviralrecovery.com/tools/"},
	        {"@type": "ListItem", "position": 3, "name": "HRV and resting heart rate tracker", "item": "https://www.postviralrecovery.com/tools/trackers/hrv-tracker/"}
	      ]
	    },
	    {
	      "@type": "FAQPage",
	      "mainEntity": [
	        {
	          "@type": "Question",
	          "name": "Where is my HRV data stored?",
	          "acceptedAnswer": {"@type": "Answer", "text": "In your browser's local storage on the device you are using. Nothing is sent to this site or anywhere else. Clearing browser data or switching devices loses the record, so export a CSV now and then."}
	        },
	        {
	          "@type": "Question",
	          "name": "Do I have to type in months of old readings?",
	          "acceptedAnswer": {"@type": "Answer", "text": "No. The rolling medians and charts work from the day you start. If you already have history, most wearable dashboards can export a CSV, and the page imports it directly."}
	        },
	        {
	          "@type": "Question",
	          "name": "Why medians rather than averages?",
	          "acceptedAnswer": {"@type": "Answer", "text": "HRV readings are skewed and one unusual night can drag an average a long way. A median is far less affected by single outliers, which makes it a better picture of where you actually are."}
	        }
	      ]
	    }
	  ]
	}
		</script>
	</Fragment>

			<div class="page-header">
				<a href="/tools/" class="section-label tools">Tools</a>
				<h1>HRV and resting heart rate tracker</h1>
				<p class="subtitle">Log daily readings, or import them, and see your medians and trends</p>
			</div>

			<div class="content">
				<p>Heart rate variability (HRV) and resting heart rate (RHR) are two of the most accessible objective markers for people with post-viral conditions, POTS and ME/CFS. Most wearables measure both overnight. Tracked over weeks, they can show whether an intervention or a change in pacing is shifting anything, in a way that a single day's number never can.</p>

				<p><strong>You do not need to enter any history.</strong> Start today and the medians and charts build themselves as you go. If you already have readings in a wearable app or a spreadsheet, the <a href="#import">import section</a> below takes a CSV so nothing needs retyping.</p>

				<!-- Log a reading -->
				<section id="log">
					<h2>Log a reading</h2>
					<p class="small-note">One entry per day. Logging a date that already exists updates it. Use whichever of the two you have.</p>
					<form id="log-form" class="log-form">
						<div class="field-row">
							<label>Date <input type="date" id="log-date" required /></label>
							<label>HRV (ms) <input type="number" id="log-hrv" min="1" max="300" step="0.1" inputmode="decimal" placeholder="e.g. 32" /></label>
							<label>Resting heart rate (bpm) <input type="number" id="log-rhr" min="25" max="200" step="1" inputmode="numeric" placeholder="e.g. 68" /></label>
							<label class="grow">Note (optional) <input type="text" id="log-note" maxlength="200" placeholder="e.g. poor sleep, started new medication" /></label>
						</div>
						<div class="form-actions">
							<button type="submit" class="primary-btn">Save reading</button>
							<span id="log-saved" class="saved-note" hidden></span>
							<span id="log-error" class="error-note" hidden></span>
						</div>
					</form>
				</section>

				<!-- Empty state -->
				<div id="empty" class="empty" hidden>
					<p>No readings yet. Save today's reading above, or <a href="#import">import a file</a> if you have history elsewhere. Charts appear once there are two or more readings.</p>
				</div>

				<!-- Summary -->
				<section id="summary-section" hidden>
					<h2>Where you are</h2>
					<p class="small-note">Medians over the last 7 and 30 days. The 7-day figure needs at least 3 readings, the 30-day figure at least 10. Compare yourself only with your own earlier numbers: HRV differs a lot between people and between devices.</p>
					<div class="summary-grid">
						<div class="summary-card" id="summary-hrv">
							<h3>HRV</h3>
							<div class="stats"></div>
						</div>
						<div class="summary-card" id="summary-rhr">
							<h3>Resting heart rate</h3>
							<div class="stats"></div>
						</div>
					</div>
				</section>

				<!-- Charts -->
				<section id="chart-section" hidden>
					<h2>Trends</h2>
					<div class="range-row" role="group" aria-label="Chart range">
						<span>Show:</span>
						<button type="button" class="range-btn" data-range="30">30 days</button>
						<button type="button" class="range-btn active" data-range="90">90 days</button>
						<button type="button" class="range-btn" data-range="180">6 months</button>
						<button type="button" class="range-btn" data-range="365">1 year</button>
						<button type="button" class="range-btn" data-range="0">All</button>
					</div>

					<div class="chart-block" id="chart-hrv-block">
						<h3>HRV <span class="unit">ms, higher is generally better</span></h3>
						<div class="chart" id="chart-hrv"></div>
					</div>
					<div class="chart-block" id="chart-rhr-block">
						<h3>Resting heart rate <span class="unit">bpm, lower is generally better</span></h3>
						<div class="chart" id="chart-rhr"></div>
					</div>
					<p class="small-note">Each dot is a daily reading. The solid line is the 7-day rolling median and the dashed line the 30-day rolling median. Hover or tap a dot for the exact values. A day-to-day wobble is normal; it is the lines you are watching.</p>
				</section>

				<!-- Entries -->
				<section id="entries-section" hidden>
					<h2>Your readings</h2>
					<div class="table-wrap">
						<table id="entries-table">
							<thead><tr><th>Date</th><th>HRV (ms)</th><th>RHR (bpm)</th><th>Note</th><th></th></tr></thead>
							<tbody></tbody>
						</table>
					</div>
					<button type="button" id="show-all-btn" class="secondary-btn" hidden></button>
				</section>

				<!-- Import -->
				<section id="import">
					<h2>Import readings</h2>
					<p>Bring in history from a wearable export, the old Google Sheets template, or anything with a date column and a column of numbers. Choose a file or paste rows, check the preview, then import. Dates you already have are updated, everything else is added.</p>

					<div class="import-box">
						<div class="import-inputs">
							<label class="file-label">
								<span class="secondary-btn linklike">Choose a CSV file</span>
								<input type="file" id="import-file" accept=".csv,.tsv,.txt,text/csv,text/plain" />
								<span id="import-filename" class="filename"></span>
							</label>
							<details class="paste-details">
								<summary>Or paste rows instead</summary>
								<textarea id="import-paste" rows="6" placeholder={"Date,HRV,RHR\n2026-09-01,34,66\n2026-09-02,29,70\n\nCopying cells from a spreadsheet works too, as does one line per day such as 2026-09-03 31 68."}></textarea>
								<button type="button" id="paste-btn" class="secondary-btn">Preview pasted rows</button>
							</details>
						</div>

						<div id="import-preview" hidden>
							<h3>Check the columns</h3>
							<div class="map-grid">
								<label>Date column <select id="map-date"></select></label>
								<label>HRV column <select id="map-hrv"></select></label>
								<label>Resting HR column <select id="map-rhr"></select></label>
							</div>
							<div id="date-order" class="date-order" hidden>
								<span>These dates could read either way:</span>
								<label><input type="radio" name="date-order" value="dmy" /> day / month / year</label>
								<label><input type="radio" name="date-order" value="mdy" /> month / day / year</label>
							</div>
							<p id="import-summary" class="import-summary"></p>
							<div class="table-wrap">
								<table id="preview-table">
									<thead><tr><th>Date</th><th>HRV (ms)</th><th>RHR (bpm)</th></tr></thead>
									<tbody></tbody>
								</table>
							</div>
							<div class="form-actions">
								<button type="button" id="import-btn" class="primary-btn">Import these readings</button>
								<button type="button" id="import-cancel" class="secondary-btn">Cancel</button>
								<span id="import-done" class="saved-note" hidden></span>
							</div>
						</div>
						<p id="import-error" class="error-note" hidden></p>
					</div>

					<details class="help">
						<summary>Getting a file out of your device or app</summary>
						<p class="small-note">Makers move these menus around, so treat this as a starting point and check their help pages if something has changed. Values in "ms" for HRV and "bpm" for resting heart rate are all the importer needs. Mixed columns it does not recognise are ignored.</p>
						<dl>
							<dt>Garmin</dt>
							<dd>On the Garmin Connect website, open Reports, then Health and Fitness. The Resting Heart Rate and HRV Status reports each have an export option once you have picked a date range. Import the two files one after the other; the second updates the same dates with the missing column.</dd>
							<dt>Oura</dt>
							<dd>The Oura web app has a Trends view where you can select Average HRV and Lowest Resting Heart Rate for a date range and download them as CSV.</dd>
							<dt>Whoop</dt>
							<dd>Request a data export from the app's settings. The cycles file has a "Heart rate variability (ms)" and a "Resting heart rate (bpm)" column, which the importer recognises.</dd>
							<dt>Apple Watch</dt>
							<dd>Apple Health only exports a very large XML archive, which this page cannot read. A small app such as Health Auto Export, or an iOS Shortcut using "Find Health Samples", can write just HRV and resting heart rate to a CSV. Apple reports HRV as SDNN rather than RMSSD, which is fine for tracking your own trend but not comparable with other devices.</dd>
							<dt>Fitbit and Google Pixel Watch</dt>
							<dd>Fitbit's export goes through Google Takeout and splits HRV into one small file per night, which is the least convenient of the lot. For a short backlog, the quickest route is to open Health Metrics in the app and use the paste box above with one line per day.</dd>
							<dt>Polar</dt>
							<dd>Polar Flow's account export produces JSON files rather than CSV. If you also log Nightly Recharge values in a spreadsheet, export that instead.</dd>
							<dt>The Google Sheets template</dt>
							<dd>If you used the earlier spreadsheet version of this tracker, open it and choose File, Download, Comma Separated Values. The date, HRV and RHR columns are picked up automatically.</dd>
							<dt>Any spreadsheet</dt>
							<dd>Select the date and value columns, copy, and paste into the box above. Tab-separated cells copied from Excel, Numbers or Google Sheets are read directly.</dd>
						</dl>
					</details>
				</section>

				<!-- Data -->
				<section class="data-section">
					<h2>Your data</h2>
					<p class="small-note">Everything on this page lives in your browser's local storage on this device. It survives closing the tab, but not clearing site data or switching device. Export a CSV now and then, and to move to another device import that file there.</p>
					<div class="data-actions">
						<button type="button" id="export-btn" class="secondary-btn">Export as CSV</button>
						<button type="button" id="clear-btn" class="danger-btn">Clear all data on this device</button>
						<span id="clear-confirm" hidden>
							This deletes every reading. It cannot be undone.
							<button type="button" id="clear-yes" class="danger-btn">Yes, delete everything</button>
							<button type="button" id="clear-no" class="secondary-btn">Cancel</button>
						</span>
					</div>
				</section>

				<section class="notes">
					<h2>Getting useful numbers</h2>
					<ul>
						<li><strong>Same method every day.</strong> Overnight readings from a wearable and a morning reading with a chest strap are different measurements. Pick one and stick with it, or the trend is noise.</li>
						<li><strong>Your baseline is the only comparison.</strong> Devices use different calculations and published "normal" ranges are wide. The question is whether your median is moving.</li>
						<li><strong>Give it weeks.</strong> A single low night after a bad day is expected. A 7-day median falling for a couple of weeks, or a resting heart rate creeping up, is the kind of pattern worth noticing.</li>
						<li><strong>Note what changed.</strong> The note field is for medication changes, infections, travel, a crash. Those notes are what make the chart explain itself later.</li>
					</ul>
					<p class="note">Pairing this with the <a href="/tools/trackers/symptom-diary/">symptom diary</a> lets you set objective markers against how you actually felt. For the reasoning behind tracking HRV at all, and its limits, see <a href="/evidence/hrv-as-a-tracking-metric/">HRV as a tracking metric</a>.</p>
				</section>

			</div>

			<aside class="tool-foot" aria-label="About this tool">
				<div class="disclaimer">
					<p>
						<strong>This is a record keeper.</strong> It stores your readings, works out rolling medians and draws the trend.
						It does not interpret them or tell you what to do. Everything you enter stays in this browser on this
						device and is never sent anywhere.
					</p>
					<p>This page keeps your record and does arithmetic on it. It does not diagnose anything, and a change in HRV or resting heart rate on its own does not mean something is wrong or right. If you see a pattern that worries you, the export button gives you a file to take to your clinician.</p>
				</div>
			</aside>
</Page>

<script>
import {
	loadStore, saveStore, clearStore, upsertEntry, removeEntry, todayISO, dayNumber, isoFromDayNumber,
	fmtDate, fmtDateLong, windowMedian, rollingMedian, latest, downloadCSV,
	parseDelimited, guessColumns, detectDateOrder, hasSlashDates, buildImport, mergeImport, LIMITS,
	type Entry, type Metric, type ParsedTable, type ColumnGuess, type DateOrder,
} from '../../../scripts/hrv-store';

const store = loadStore();
const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

// ── Log form ──
const dateEl = $<HTMLInputElement>('log-date');
const hrvEl = $<HTMLInputElement>('log-hrv');
const rhrEl = $<HTMLInputElement>('log-rhr');
const noteEl = $<HTMLInputElement>('log-note');
const savedEl = $('log-saved');
const errorEl = $('log-error');
dateEl.value = todayISO();
dateEl.max = todayISO();

function showNote(el: HTMLElement, text: string) {
	el.textContent = text;
	el.hidden = false;
	window.setTimeout(() => { el.hidden = true; }, 4000);
}

$<HTMLFormElement>('log-form').addEventListener('submit', ev => {
	ev.preventDefault();
	errorEl.hidden = true;
	const date = dateEl.value;
	const hrv = hrvEl.value === '' ? undefined : parseFloat(hrvEl.value);
	const rhr = rhrEl.value === '' ? undefined : parseFloat(rhrEl.value);
	if (!date) { showNote(errorEl, 'Pick a date.'); return; }
	if (hrv === undefined && rhr === undefined) { showNote(errorEl, 'Enter an HRV or a resting heart rate, or both.'); return; }
	if (hrv !== undefined && (hrv < LIMITS.hrv.min || hrv > LIMITS.hrv.max)) { showNote(errorEl, `HRV should be between ${LIMITS.hrv.min} and ${LIMITS.hrv.max} ms.`); return; }
	if (rhr !== undefined && (rhr < LIMITS.rhr.min || rhr > LIMITS.rhr.max)) { showNote(errorEl, `Resting heart rate should be between ${LIMITS.rhr.min} and ${LIMITS.rhr.max} bpm.`); return; }

	const existed = upsertEntry(store, { date, hrv, rhr, note: noteEl.value });
	saveStore(store);
	showNote(savedEl, existed ? `Updated ${fmtDateLong(date)}.` : `Saved ${fmtDateLong(date)}.`);

	// Backfilling: step the date back a day if that day is still empty, so a run of history is quick to type.
	const prev = isoFromDayNumber(dayNumber(date) - 1);
	dateEl.value = store.entries.some(e => e.date === prev) ? todayISO() : prev;
	hrvEl.value = ''; rhrEl.value = ''; noteEl.value = '';
	hrvEl.focus();
	renderAll();
});

// ── Summary ──
function renderSummary() {
	const section = $('summary-section');
	const any = store.entries.length > 0;
	section.hidden = !any;
	if (!any) return;
	for (const metric of ['hrv', 'rhr'] as Metric[]) {
		const card = $(`summary-${metric}`);
		const box = card.querySelector('.stats') as HTMLElement;
		const unit = metric === 'hrv' ? 'ms' : 'bpm';
		const last = latest(store.entries, metric);
		if (!last) { card.hidden = true; continue; }
		card.hidden = false;
		const today = todayISO();
		const w7 = windowMedian(store.entries, metric, today, 7, 3);
		const w30 = windowMedian(store.entries, metric, today, 30, 10);
		const lastVal = last[metric] as number;
		let vs = '';
		if (w30) {
			const diff = ((lastVal - w30.value) / w30.value) * 100;
			const dir = diff > 0 ? 'above' : diff < 0 ? 'below' : 'level with';
			vs = Math.abs(diff) < 0.5 ? 'Latest is level with the 30-day median.' : `Latest is ${Math.abs(diff).toFixed(0)}% ${dir} the 30-day median.`;
		}
		box.innerHTML = `
			<div class="stat"><span class="stat-label">Latest</span><span class="stat-value">${fmt(lastVal)}<small> ${unit}</small></span><span class="stat-sub">${fmtDate(last.date)}</span></div>
			<div class="stat"><span class="stat-label">7-day median</span><span class="stat-value">${w7 ? fmt(w7.value) + `<small> ${unit}</small>` : '<span class="muted">—</span>'}</span><span class="stat-sub">${w7 ? `${w7.count} readings` : 'needs 3 readings'}</span></div>
			<div class="stat"><span class="stat-label">30-day median</span><span class="stat-value">${w30 ? fmt(w30.value) + `<small> ${unit}</small>` : '<span class="muted">—</span>'}</span><span class="stat-sub">${w30 ? `${w30.count} readings` : 'needs 10 readings'}</span></div>
			${vs ? `<p class="stat-vs">${vs}</p>` : ''}`;
	}
}
function fmt(n: number): string { return Number.isInteger(n) ? String(n) : n.toFixed(1); }

// ── Charts ──
let rangeDays = 90;
document.querySelectorAll<HTMLButtonElement>('.range-btn').forEach(btn => {
	btn.addEventListener('click', () => {
		rangeDays = parseInt(btn.dataset.range || '0', 10);
		document.querySelectorAll('.range-btn').forEach(b => b.classList.toggle('active', b === btn));
		renderCharts();
	});
});

function renderCharts() {
	const section = $('chart-section');
	const withHrv = store.entries.filter(e => typeof e.hrv === 'number').length;
	const withRhr = store.entries.filter(e => typeof e.rhr === 'number').length;
	section.hidden = withHrv < 2 && withRhr < 2;
	if (section.hidden) return;
	$('chart-hrv-block').hidden = withHrv < 2;
	$('chart-rhr-block').hidden = withRhr < 2;
	if (withHrv >= 2) renderChart('hrv', $('chart-hrv'), 'ms', 'HRV');
	if (withRhr >= 2) renderChart('rhr', $('chart-rhr'), 'bpm', 'Resting heart rate');
}

function renderChart(metric: Metric, wrap: HTMLElement, unit: string, label: string) {
	const all = store.entries.filter(e => typeof e[metric] === 'number');
	const todayN = dayNumber(todayISO());
	const cutoff = rangeDays > 0 ? todayN - rangeDays + 1 : -Infinity;
	let daily = all.filter(e => dayNumber(e.date) >= cutoff);
	if (daily.length < 2) daily = all; // range has too little in it: show everything rather than nothing
	const m7 = rollingMedian(store.entries, metric, 7, 3).filter(p => dayNumber(p.date) >= dayNumber(daily[0].date));
	const m30 = rollingMedian(store.entries, metric, 30, 10).filter(p => dayNumber(p.date) >= dayNumber(daily[0].date));

	const W = 640, H = 240, L = 44, R = 14, T = 14, B = 30;
	const x0 = dayNumber(daily[0].date), x1 = dayNumber(daily[daily.length - 1].date);
	const span = Math.max(1, x1 - x0);
	const xs = (d: string) => L + ((dayNumber(d) - x0) / span) * (W - L - R);

	const vals = [...daily.map(e => e[metric] as number), ...m7.map(p => p.value), ...m30.map(p => p.value)];
	let lo = Math.min(...vals), hi = Math.max(...vals);
	if (hi - lo < 4) { lo -= 2; hi += 2; }
	const pad = (hi - lo) * 0.12;
	lo = Math.max(0, Math.floor(lo - pad)); hi = Math.ceil(hi + pad);
	const ticks = niceTicks(lo, hi, 5);
	lo = ticks[0]; hi = ticks[ticks.length - 1];
	const ys = (v: number) => T + (1 - (v - lo) / (hi - lo)) * (H - T - B);

	// x ticks: up to 6 evenly spaced dates
	const nx = Math.min(6, span + 1);
	const xt: number[] = [];
	for (let i = 0; i < nx; i++) xt.push(Math.round(x0 + (i / Math.max(1, nx - 1)) * span));
	const spansYears = isoFromDayNumber(x0).slice(0, 4) !== isoFromDayNumber(x1).slice(0, 4);
	const xLabel = (n: number) => fmtDate(isoFromDayNumber(n), spansYears ? { day: 'numeric', month: 'short', year: '2-digit' } : { day: 'numeric', month: 'short' });

	const path = (pts: { date: string; value: number }[]) => {
		let d = '', prev: number | null = null;
		for (const p of pts) {
			const n = dayNumber(p.date);
			const cmd = prev === null || n - prev > 10 ? 'M' : 'L';
			d += `${cmd}${xs(p.date).toFixed(1)},${ys(p.value).toFixed(1)}`;
			prev = n;
		}
		return d;
	};

	const first = daily[0].date, last = daily[daily.length - 1].date;
	wrap.innerHTML = `
		<div class="chart-inner">
			<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${label} from ${fmtDateLong(first)} to ${fmtDateLong(last)}: ${daily.length} daily readings with 7-day and 30-day rolling medians. Values are listed in the table below.">
				${ticks.map(v => `<line x1="${L}" y1="${ys(v).toFixed(1)}" x2="${W - R}" y2="${ys(v).toFixed(1)}" class="grid"></line><text x="${L - 8}" y="${(ys(v) + 4).toFixed(1)}" class="axis" text-anchor="end">${v}</text>`).join('')}
				${xt.map((n, i) => `<text x="${(L + ((n - x0) / span) * (W - L - R)).toFixed(1)}" y="${H - 8}" class="axis" text-anchor="${i === 0 ? 'start' : i === xt.length - 1 ? 'end' : 'middle'}">${xLabel(n)}</text>`).join('')}
				<path d="${path(m30)}" class="line-30"></path>
				<path d="${path(m7)}" class="line-7"></path>
				${daily.map(e => `<circle cx="${xs(e.date).toFixed(1)}" cy="${ys(e[metric] as number).toFixed(1)}" r="3" class="dot" data-date="${e.date}"><title>${fmtDateLong(e.date)}: ${fmt(e[metric] as number)} ${unit}</title></circle>`).join('')}
				<line class="guide" x1="0" x2="0" y1="${T}" y2="${H - B}" hidden></line>
				<rect class="hit" x="${L}" y="${T}" width="${W - L - R}" height="${H - T - B}" fill="transparent"></rect>
			</svg>
			<div class="tooltip" hidden></div>
		</div>
		<div class="legend">
			<span><i class="sw dot"></i>Daily reading</span>
			<span><i class="sw l7"></i>7-day median</span>
			<span><i class="sw l30"></i>30-day median</span>
		</div>`;

	// Hover / tap layer
	const svg = wrap.querySelector('svg') as SVGSVGElement;
	const hit = wrap.querySelector('.hit') as SVGRectElement;
	const guide = wrap.querySelector('.guide') as SVGLineElement;
	const tip = wrap.querySelector('.tooltip') as HTMLElement;
	const inner = wrap.querySelector('.chart-inner') as HTMLElement;
	const m7Map = new Map(m7.map(p => [p.date, p.value]));
	const m30Map = new Map(m30.map(p => [p.date, p.value]));

	const show = (clientX: number) => {
		const rect = svg.getBoundingClientRect();
		const vx = ((clientX - rect.left) / rect.width) * W;
		let best = daily[0], bd = Infinity;
		for (const e of daily) { const d = Math.abs(xs(e.date) - vx); if (d < bd) { bd = d; best = e; } }
		const px = xs(best.date);
		guide.setAttribute('x1', String(px)); guide.setAttribute('x2', String(px));
		guide.hidden = false;
		const v7 = m7Map.get(best.date), v30 = m30Map.get(best.date);
		tip.innerHTML = `<strong>${fmtDateLong(best.date)}</strong><br>${label}: ${fmt(best[metric] as number)} ${unit}` +
			(v7 !== undefined ? `<br>7-day median: ${fmt(v7)}` : '') +
			(v30 !== undefined ? `<br>30-day median: ${fmt(v30)}` : '') +
			(best.note ? `<br><em>${escapeHtml(best.note)}</em>` : '');
		tip.hidden = false;
		const leftPx = (px / W) * rect.width;
		const innerW = inner.clientWidth;
		tip.style.left = leftPx > innerW / 2 ? 'auto' : `${leftPx + 12}px`;
		tip.style.right = leftPx > innerW / 2 ? `${innerW - leftPx + 12}px` : 'auto';
		tip.style.top = `${(ys(best[metric] as number) / H) * rect.height - 10}px`;
		wrap.querySelectorAll('.dot').forEach(c => c.classList.toggle('hot', (c as SVGElement).dataset.date === best.date));
	};
	const hide = () => { guide.hidden = true; tip.hidden = true; wrap.querySelectorAll('.dot.hot').forEach(c => c.classList.remove('hot')); };
	hit.addEventListener('pointermove', ev => show(ev.clientX));
	hit.addEventListener('pointerdown', ev => show(ev.clientX));
	hit.addEventListener('pointerleave', hide);
}

function niceTicks(lo: number, hi: number, n: number): number[] {
	const raw = (hi - lo) / Math.max(1, n - 1);
	const mag = Math.pow(10, Math.floor(Math.log10(raw)));
	const norm = raw / mag;
	const step = (norm <= 1 ? 1 : norm <= 2 ? 2 : norm <= 2.5 ? 2.5 : norm <= 5 ? 5 : 10) * mag;
	const start = Math.floor(lo / step) * step;
	const end = Math.ceil(hi / step) * step;
	const out: number[] = [];
	for (let v = start; v <= end + 1e-9; v += step) out.push(Math.round(v * 100) / 100);
	return out;
}

function escapeHtml(s: string): string {
	return s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
}

// ── Entries table ──
let showAll = false;
const PAGE = 30;
$('show-all-btn').addEventListener('click', () => { showAll = !showAll; renderEntries(); });

function renderEntries() {
	const section = $('entries-section');
	section.hidden = store.entries.length === 0;
	if (section.hidden) return;
	const rows = [...store.entries].reverse();
	const shown = showAll ? rows : rows.slice(0, PAGE);
	const tbody = $('entries-table').querySelector('tbody') as HTMLElement;
	tbody.innerHTML = shown.map(e => `
		<tr data-date="${e.date}">
			<td>${fmtDateLong(e.date)}</td>
			<td>${e.hrv !== undefined ? fmt(e.hrv) : '<span class="muted">—</span>'}</td>
			<td>${e.rhr !== undefined ? fmt(e.rhr) : '<span class="muted">—</span>'}</td>
			<td class="note-cell">${e.note ? escapeHtml(e.note) : ''}</td>
			<td class="row-actions"><button type="button" class="link-btn edit" data-date="${e.date}">Edit</button> <button type="button" class="link-btn delete" data-date="${e.date}">Delete</button></td>
		</tr>`).join('');
	const btn = $<HTMLButtonElement>('show-all-btn');
	btn.hidden = rows.length <= PAGE;
	btn.textContent = showAll ? `Show the latest ${PAGE} only` : `Show all ${rows.length} readings`;

	tbody.querySelectorAll<HTMLButtonElement>('.edit').forEach(b => b.addEventListener('click', () => {
		const e = store.entries.find(x => x.date === b.dataset.date) as Entry;
		dateEl.value = e.date; hrvEl.value = e.hrv !== undefined ? String(e.hrv) : ''; rhrEl.value = e.rhr !== undefined ? String(e.rhr) : ''; noteEl.value = e.note ?? '';
		$('log').scrollIntoView({ behavior: 'smooth', block: 'start' });
		hrvEl.focus();
	}));
	tbody.querySelectorAll<HTMLButtonElement>('.delete').forEach(b => b.addEventListener('click', () => {
		const d = b.dataset.date as string;
		if (!window.confirm(`Delete the reading for ${fmtDateLong(d)}?`)) return;
		removeEntry(store, d);
		saveStore(store);
		renderAll();
	}));
}

// ── Import ──
let table: ParsedTable | null = null;
let cols: ColumnGuess = { date: -1, hrv: -1, rhr: -1 };
let order: DateOrder = 'dmy';

const fileEl = $<HTMLInputElement>('import-file');
const pasteEl = $<HTMLTextAreaElement>('import-paste');
const previewEl = $('import-preview');
const importErr = $('import-error');
const mapDate = $<HTMLSelectElement>('map-date');
const mapHrv = $<HTMLSelectElement>('map-hrv');
const mapRhr = $<HTMLSelectElement>('map-rhr');

fileEl.addEventListener('change', () => {
	const f = fileEl.files?.[0];
	if (!f) return;
	$('import-filename').textContent = f.name;
	f.text().then(startPreview).catch(() => showImportError('That file could not be read.'));
});
$('paste-btn').addEventListener('click', () => startPreview(pasteEl.value));
$('import-cancel').addEventListener('click', resetImport);

function showImportError(msg: string) { importErr.textContent = msg; importErr.hidden = false; previewEl.hidden = true; }

function resetImport() {
	table = null; previewEl.hidden = true; importErr.hidden = true;
	fileEl.value = ''; $('import-filename').textContent = '';
}

function startPreview(text: string) {
	importErr.hidden = true;
	$('import-done').hidden = true;
	if (!text.trim()) { showImportError('Nothing to read yet.'); return; }
	table = parseDelimited(text);
	if (table.rows.length === 0) { showImportError('No rows found in that text.'); return; }
	cols = guessColumns(table.headers, table.rows);
	if (cols.date < 0) { showImportError('No date column could be found. Make sure the first row has headings, or that one column holds dates like 2026-09-01 or 01/09/2026.'); return; }
	for (const [sel, key] of [[mapDate, 'date'], [mapHrv, 'hrv'], [mapRhr, 'rhr']] as [HTMLSelectElement, keyof ColumnGuess][]) {
		sel.innerHTML = `<option value="-1">${key === 'date' ? 'Choose' : 'None'}</option>` + table.headers.map((h, i) => `<option value="${i}">${escapeHtml(h || `Column ${i + 1}`)}</option>`).join('');
		sel.value = String(cols[key]);
		sel.onchange = () => { cols[key] = parseInt(sel.value, 10); refreshPreview(); };
	}
	// Date order: only ask when the dates are of the ambiguous numeric shape and the data cannot settle it.
	const dateCells = table.rows.map(r => r[cols.date] ?? '');
	const detected = detectDateOrder(dateCells);
	order = detected ?? 'dmy';
	const orderBox = $('date-order');
	orderBox.hidden = !(hasSlashDates(dateCells) && !detected);
	orderBox.querySelectorAll<HTMLInputElement>('input').forEach(r => {
		r.checked = r.value === order;
		r.onchange = () => { order = r.value as DateOrder; refreshPreview(); };
	});
	previewEl.hidden = false;
	refreshPreview();
	previewEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function refreshPreview() {
	if (!table) return;
	const result = buildImport(table, cols, order);
	const tbody = $('preview-table').querySelector('tbody') as HTMLElement;
	const importBtn = $<HTMLButtonElement>('import-btn');
	if (result.entries.length === 0) {
		$('import-summary').textContent = `No usable readings with these columns. ${result.skipped} rows were skipped because the date or the values could not be read.`;
		tbody.innerHTML = '';
		importBtn.disabled = true;
		return;
	}
	importBtn.disabled = false;
	const nHrv = result.entries.filter(e => e.hrv !== undefined).length;
	const nRhr = result.entries.filter(e => e.rhr !== undefined).length;
	const existing = new Set(store.entries.map(e => e.date));
	const overlap = result.entries.filter(e => existing.has(e.date)).length;
	const first = result.entries[0].date, last = result.entries[result.entries.length - 1].date;
	const parts = [
		`${result.entries.length} days from ${fmtDateLong(first)} to ${fmtDateLong(last)}: ${nHrv} with HRV, ${nRhr} with resting heart rate.`,
	];
	if (overlap) parts.push(`${overlap} of these dates are already in your log and will be updated.`);
	if (result.skipped) parts.push(`${result.skipped} rows skipped (no readable date or value).`);
	if (result.duplicates) parts.push(`${result.duplicates} repeated dates in the file; the last value for each day is kept.`);
	$('import-summary').textContent = parts.join(' ');
	const sample = result.entries.length <= 6
		? result.entries
		: [...result.entries.slice(0, 3), null, ...result.entries.slice(-3)];
	tbody.innerHTML = sample.map(e => e
		? `<tr><td>${fmtDateLong(e.date)}</td><td>${e.hrv !== undefined ? fmt(e.hrv) : '<span class="muted">—</span>'}</td><td>${e.rhr !== undefined ? fmt(e.rhr) : '<span class="muted">—</span>'}</td></tr>`
		: `<tr><td colspan="3" class="muted">…</td></tr>`).join('');
}

$('import-btn').addEventListener('click', () => {
	if (!table) return;
	const result = buildImport(table, cols, order);
	const { added, updated } = mergeImport(store, result.entries);
	saveStore(store);
	const done = $('import-done');
	done.textContent = `Imported: ${added} new days, ${updated} updated.`;
	done.hidden = false;
	table = null; fileEl.value = ''; pasteEl.value = ''; $('import-filename').textContent = '';
	previewEl.querySelector('.table-wrap')!.querySelector('tbody')!.innerHTML = '';
	$('import-summary').textContent = '';
	$<HTMLButtonElement>('import-btn').disabled = true;
	renderAll();
	$('summary-section').scrollIntoView({ behavior: 'smooth', block: 'start' });
});

// ── Data controls ──
$('export-btn').addEventListener('click', () => downloadCSV(store));
$('clear-btn').addEventListener('click', () => { $('clear-confirm').hidden = false; });
$('clear-no').addEventListener('click', () => { $('clear-confirm').hidden = true; });
$('clear-yes').addEventListener('click', () => {
	clearStore();
	store.entries = [];
	$('clear-confirm').hidden = true;
	renderAll();
});

// ── Render ──
function renderAll() {
	$('empty').hidden = store.entries.length > 0;
	renderSummary();
	renderCharts();
	renderEntries();
}
renderAll();
</script>

