---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const questions = [
	'My motivation is lower when I am fatigued.',
	'Exercise brings on my fatigue.',
	'I am easily fatigued.',
	'Fatigue interferes with my physical functioning.',
	'Fatigue causes frequent problems for me.',
	'My fatigue prevents sustained physical functioning.',
	'Fatigue interferes with carrying out certain duties and responsibilities.',
	'Fatigue is among my three most disabling symptoms.',
	'Fatigue interferes with my work, family, or social life.',
];

const ratings = [
	{ value: 1, label: 'Strongly disagree' },
	{ value: 2, label: '2' },
	{ value: 3, label: '3' },
	{ value: 4, label: 'Neither agree nor disagree' },
	{ value: 5, label: '5' },
	{ value: 6, label: '6' },
	{ value: 7, label: 'Strongly agree' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Fatigue Severity Scale (FSS): free online questionnaire with scoring"
			description="Complete the Fatigue Severity Scale online for free. A 9-item validated questionnaire measuring the impact of fatigue on daily life. Instant scoring with interpretation. No sign-up required."
		/>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.postviralrecovery.com/"},
        {"@type": "ListItem", "position": 2, "name": "Tools", "item": "https://www.postviralrecovery.com/tools/"},
        {"@type": "ListItem", "position": 3, "name": "Fatigue Severity Scale", "item": "https://www.postviralrecovery.com/tools/fss/"}
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is a normal FSS score?",
          "acceptedAnswer": {"@type": "Answer", "text": "In the original validation study, healthy controls had a mean FSS score of approximately 2.3. A score of 4 or above is the most widely used threshold for clinically meaningful fatigue."}
        },
        {
          "@type": "Question",
          "name": "What does an FSS score above 5 mean?",
          "acceptedAnswer": {"@type": "Answer", "text": "Scores above 5 are consistent with clinically meaningful fatigue as seen in ME/CFS, multiple sclerosis, and post-viral fatigue in published research. Discuss your results with your doctor."}
        }
      ]
    }
  ]
}
</script>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-header">
				<a href="/tools" class="section-label tools">Tools</a>
				<h1>Fatigue Severity Scale</h1>
				<p class="subtitle">FSS: Self-Report Fatigue Questionnaire</p>
				<p class="description">
  The Fatigue Severity Scale (FSS) is a 9-item questionnaire that measures the impact of fatigue on daily functioning. It was developed by Krupp and colleagues in 1989 and has become one of the most widely used fatigue instruments in clinical research and practice. Each item is a statement about fatigue, and you rate your agreement on a scale from 1 (strongly disagree) to 7 (strongly agree). Your score is the mean of all nine items.
</p>
<p class="description">
  The FSS does not measure how tired you feel in the moment. Instead, it captures how much fatigue interferes with your life over the preceding week: your motivation, exercise capacity, ability to carry out duties, and physical functioning. This makes it particularly useful for people with post-viral conditions, ME/CFS, and other chronic illnesses where fatigue is persistent and functionally limiting rather than simply a feeling of tiredness.
</p>
<p class="description">
  The FSS has been validated in multiple populations including multiple sclerosis, systemic lupus erythematosus, ME/CFS, and post-viral fatigue. It is referenced in major long COVID research studies and is one of the instruments used in the NIH RECOVER programme.
</p>
<p class="description">
  This is a free, interactive version. Complete it below and receive your score immediately. No sign-up or email is required.
</p>
<div class="disclaimer">
  <strong>This is not a diagnostic tool.</strong> Your score reflects self-reported fatigue impact and does not constitute a diagnosis of any condition. Discuss results with your doctor. Based on: Krupp LB, LaRocca NG, Muir-Nash J, Steinberg AD. The fatigue severity scale. Application to patients with multiple sclerosis and systemic lupus erythematosus. Arch Neurol. 1989;46(10):1121–1123.
</div>
			</div>

			<form id="fss-form" novalidate>
				<p class="form-instructions">Rate your agreement with each statement over the past week, where 1 = strongly disagree and 7 = strongly agree:</p>

				<div class="question-grid">
					{questions.map((q, i) => (
						<div class="question" data-index={i}>
							<p class="q-text"><span class="q-num">{i + 1}.</span> {q}</p>
							<div class="options">
								{ratings.map(r => (
									<label>
										<input type="radio" name={`q${i}`} value={r.value} required />
										<span>{r.label}</span>
									</label>
								))}
							</div>
						</div>
					))}
				</div>

				<div class="form-footer">
					<button type="submit">Calculate score</button>
					<button type="button" id="reset-btn">Clear all</button>
				</div>
			</form>

			<div id="results" class="results" hidden>
				<h2>Your FSS score</h2>
				<div class="total-score">
					<span id="total-score-value">—</span>
					<span class="total-score-label">out of 7</span>
				</div>
				<p id="score-interpretation" class="score-interp"></p>

				<h3>Item breakdown</h3>
				<table class="breakdown-table">
					<thead>
						<tr>
							<th>Statement</th>
							<th>Your rating</th>
						</tr>
					</thead>
					<tbody id="breakdown-rows"></tbody>
					<tfoot>
						<tr>
							<td><strong>Mean score</strong></td>
							<td><strong id="breakdown-total"></strong></td>
						</tr>
					</tfoot>
				</table>

				<div class="results-disclaimer">
  <h3>Understanding your score</h3>
  <p>The FSS produces a mean score between 1 and 7. Higher scores indicate that fatigue has a greater impact on your daily functioning.</p>
  <p>In the original validation study, healthy controls had a mean score of approximately 2.3, while patients with MS and lupus had mean scores of around 4.7 and 4.6 respectively. In long COVID research, mean FSS scores above 5 are commonly reported.</p>
  <p>A score of 4 or above is the most widely used threshold for clinically meaningful fatigue, though interpretation depends on context.</p>
  <p>The FSS is most useful when tracked over time. A change of 0.5 or more in the mean score is generally considered clinically meaningful. If you are testing an intervention or tracking your condition, completing the FSS at regular intervals (such as monthly) can give you a structured record of whether your functional fatigue is improving, stable, or worsening.</p>
  <p>This score reflects the impact of fatigue on your daily life as you have reported it. It is not a diagnosis of any condition. Discuss your results with your doctor.</p>
</div>

				<button type="button" id="back-btn" class="back-btn">Edit answers</button>
			</div>
		</main>
		<Footer />
	</body>
</html>

<script>
	const QUESTIONS = [
		'My motivation is lower when I am fatigued.',
		'Exercise brings on my fatigue.',
		'I am easily fatigued.',
		'Fatigue interferes with my physical functioning.',
		'Fatigue causes frequent problems for me.',
		'My fatigue prevents sustained physical functioning.',
		'Fatigue interferes with carrying out certain duties and responsibilities.',
		'Fatigue is among my three most disabling symptoms.',
		'Fatigue interferes with my work, family, or social life.',
	];

	const form = document.getElementById('fss-form') as HTMLFormElement;
	const results = document.getElementById('results') as HTMLElement;
	const totalEl = document.getElementById('total-score-value') as HTMLElement;
	const interpEl = document.getElementById('score-interpretation') as HTMLElement;
	const rowsEl = document.getElementById('breakdown-rows') as HTMLElement;
	const breakdownTotalEl = document.getElementById('breakdown-total') as HTMLElement;

	function getVal(i: number): number | null {
		const checked = document.querySelector<HTMLInputElement>(`input[name="q${i}"]:checked`);
		return checked ? parseInt(checked.value) : null;
	}

	function interpret(mean: number): string {
		if (mean < 4) {
			return `Your score of ${mean.toFixed(1)} is below 4. Scores in this range are typical of healthy individuals in the validation studies, suggesting fatigue is not having a major impact on daily functioning.`;
		} else if (mean < 5) {
			return `Your score of ${mean.toFixed(1)} is in the moderate range. Fatigue is interfering with some aspects of daily life. This may be worth discussing with your doctor.`;
		}
		return `Your score of ${mean.toFixed(1)} is above 5. Scores at this level are consistent with clinically meaningful fatigue as seen in ME/CFS, multiple sclerosis, and post-viral fatigue in the published literature. Discuss your results with your doctor.`;
	}

	form.addEventListener('submit', (e) => {
		e.preventDefault();

		let total = 0;
		const answers: number[] = [];

		for (let i = 0; i < 9; i++) {
			const v = getVal(i);
			if (v === null) {
				alert('Please answer all 9 questions before calculating your score.');
				const firstUnanswered = document.querySelector<HTMLElement>(`.question[data-index="${i}"]`);
				firstUnanswered?.scrollIntoView({ behavior: 'smooth', block: 'center' });
				return;
			}
			answers.push(v);
			total += v;
		}

		const mean = total / 9;
		totalEl.textContent = mean.toFixed(1);
		interpEl.textContent = interpret(mean);
		breakdownTotalEl.textContent = mean.toFixed(1);

		rowsEl.innerHTML = answers.map((val, i) => `
			<tr>
				<td>${QUESTIONS[i]}</td>
				<td>${val}</td>
			</tr>
		`).join('');

		form.hidden = true;
		results.hidden = false;
		results.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});

	document.getElementById('reset-btn')?.addEventListener('click', () => form.reset());

	document.getElementById('back-btn')?.addEventListener('click', () => {
		results.hidden = true;
		form.hidden = false;
		form.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});
</script>

<style>
	.tool-header {
		padding-bottom: 1.5em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2.5em;
	}
	.tool-header h1 { margin: 0.3em 0 0.1em; }
	.subtitle { color: rgb(var(--gray)); font-size: 1.05em; margin: 0 0 0.75em; }

	.form-instructions {
		color: rgb(var(--gray));
		font-style: italic;
		margin-bottom: 1.5em;
		font-size: 0.95em;
	}

	.question-grid { display: flex; flex-direction: column; gap: 0; }
	.question {
		padding: 1.1em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.q-text { margin: 0 0 0.6em; font-size: 0.95em; }
	.q-num { font-weight: 700; margin-right: 0.25em; }
	.options {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
	}
	.options label {
		display: flex;
		align-items: center;
		gap: 0.4em;
		cursor: pointer;
		font-size: 0.88em;
		padding: 0.35em 0.65em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 20px;
		transition: background 0.1s, border-color 0.1s;
		white-space: nowrap;
	}
	.options label:hover { border-color: var(--accent); color: var(--accent); }
	.options label:has(input:checked) {
		background: var(--accent-light);
		border-color: var(--accent);
		color: var(--accent-dark);
		font-weight: 700;
	}
	.options input[type="radio"] { display: none; }

	.form-footer {
		display: flex;
		gap: 1em;
		padding: 2em 0 1em;
	}
	button[type="submit"] {
		background: var(--accent);
		color: #fff;
		border: none;
		padding: 0.75em 2em;
		border-radius: 5px;
		font-size: 1em;
		font-weight: 700;
		cursor: pointer;
		font-family: inherit;
	}
	button[type="submit"]:hover { background: var(--accent-dark); }
	button[type="button"] {
		background: none;
		border: 1px solid rgb(var(--gray-light));
		padding: 0.75em 1.5em;
		border-radius: 5px;
		font-size: 0.95em;
		cursor: pointer;
		color: rgb(var(--gray));
		font-family: inherit;
	}

	/* Results */
	.results { padding-top: 1em; }
	.results h2, .results h3 { margin-bottom: 0.5em; }
	.total-score {
		display: flex;
		align-items: baseline;
		gap: 0.5em;
		margin: 1em 0;
	}
	#total-score-value {
		font-size: 3.5em;
		font-weight: 700;
		color: var(--accent);
		line-height: 1;
	}
	.total-score-label { color: rgb(var(--gray)); font-size: 1.1em; }
	.score-interp {
		font-size: 1em;
		line-height: 1.6;
		margin: 0 0 2em;
		padding: 1em 1.25em;
		background: var(--accent-light);
		border-left: 4px solid var(--accent);
		border-radius: 4px;
	}
	.breakdown-table { margin: 1em 0 2em; font-size: 0.9em; }
	.breakdown-table tfoot td { border-bottom: none; border-top: 2px solid rgb(var(--gray-light)); }
	.results-disclaimer {
		font-size: 0.88em;
		color: rgb(var(--gray-dark));
		border-top: 1px solid rgb(var(--gray-light));
		padding-top: 1.5em;
		line-height: 1.6;
	}
	.results-disclaimer h3 { font-size: 1em; color: rgb(var(--black)); margin-bottom: 0.5em; }
	.back-btn {
		background: none;
		border: 1px solid rgb(var(--gray-light));
		padding: 0.6em 1.25em;
		border-radius: 5px;
		font-size: 0.95em;
		cursor: pointer;
		color: rgb(var(--gray));
		font-family: inherit;
		margin-top: 1em;
	}
	.back-btn:hover { border-color: var(--accent); color: var(--accent); }

	@media (max-width: 600px) {
		.options { flex-direction: column; }
		.form-footer { flex-direction: column; }
	}
</style>
