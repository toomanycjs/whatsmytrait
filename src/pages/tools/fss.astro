---
import FreeToolNote from '../../components/FreeToolNote.astro';
import LastReviewed from '../../components/LastReviewed.astro';
import Page from '../../layouts/Page.astro';
import ScoreHistory from '../../components/ScoreHistory.astro';
import SharedResults from '../../components/SharedResults.astro';
import FssInterpretation from '../../components/interpretation/Fss.astro';
import { FAQ, FAQ_ORDER } from '../../tools/fss.content';

const questions = [
	'My motivation is lower when I am fatigued.',
	'Exercise brings on my fatigue.',
	'I am easily fatigued.',
	'Fatigue interferes with my physical functioning.',
	'Fatigue causes frequent problems for me.',
	'My fatigue prevents sustained physical functioning.',
	'Fatigue interferes with carrying out certain duties and responsibilities.',
	'Fatigue is among my three most disabling symptoms.',
	'Fatigue interferes with my work, family, or social life.',
];

const ratings = [
	{ value: 1, label: 'Strongly disagree' },
	{ value: 2, label: '2' },
	{ value: 3, label: '3' },
	{ value: 4, label: 'Neither agree nor disagree' },
	{ value: 5, label: '5' },
	{ value: 6, label: '6' },
	{ value: 7, label: 'Strongly agree' },
];

const faqs = FAQ_ORDER.map(k => FAQ[k]);

// Shown under the heading and used as the sitemap lastmod.
const lastReviewed = '2026-10-16';
---

<Page
	breadcrumb="Fatigue Severity Scale (FSS)"
	faqs={faqs}
	title="Fatigue Severity Scale (FSS): free online test with scoring"
	description="Free Fatigue Severity Scale (FSS) test with an instant score, no sign-up. Nine questions, your average score worked out, and the thresholds explained."
>
			<div class="tool-header">
				<a href="/tools/" class="section-label tools">Tools</a>
				<h1>Fatigue Severity Scale (FSS)</h1>
				<LastReviewed date={lastReviewed} />
				<FreeToolNote />
				<p class="subtitle">FSS: Self-Report Fatigue Questionnaire</p>
				<p class="description">
  The Fatigue Severity Scale (FSS) is a 9-item questionnaire that measures the impact of fatigue on daily functioning. It was developed by Krupp and colleagues in 1989 and has become one of the most widely used fatigue instruments in clinical research and practice. Each item is a statement about fatigue, and you rate your agreement on a scale from 1 (strongly disagree) to 7 (strongly agree). Your score is the mean of all nine items.
</p>
<p class="description">
  The FSS does not measure how tired you feel in the moment. Instead, it captures how much fatigue interferes with your life over the preceding week: your motivation, exercise capacity, ability to carry out duties, and physical functioning. This makes it particularly useful for people with post-viral conditions, ME/CFS, and other chronic illnesses where fatigue is persistent and functionally limiting rather than simply a feeling of tiredness.
</p>
<p class="description">
  <!-- REVIEW: unsourced claims removed --> The FSS was developed in multiple sclerosis and lupus, and a larger validation in 2008 added stroke and sleep disorders. If your fatigue worsens disproportionately after activity, the <a href="/tools/dsq-pem/">post-exertional malaise questionnaire</a> characterises that pattern specifically; for a broader quality-of-life profile, see the <a href="/tools/rand-36/">RAND-36</a>. Another fatigue measure often used in the UK is the <a href="/tools/chalder-fatigue-scale/">Chalder Fatigue Scale</a>, which scores the symptom itself rather than its impact; the two complement each other.
</p>
<p class="description">
  This is a free, interactive version. Complete it below and receive your score immediately. No sign-up or email is required.
</p>
			</div>

			<form id="fss-form" novalidate>
				<p class="form-instructions">Rate your agreement with each statement over the past week, where 1 = strongly disagree and 7 = strongly agree:</p>

				<div class="question-grid">
					{questions.map((q, i) => (
						<div class="question" data-index={i}>
							<p class="q-text"><span class="q-num">{i + 1}.</span> {q}</p>
							<div class="options">
								{ratings.map(r => (
									<label>
										<input type="radio" name={`q${i}`} value={r.value} required />
										<span>{r.label}</span>
									</label>
								))}
							</div>
						</div>
					))}
				</div>

				<div class="form-footer">
					<button type="submit">Calculate score</button>
					<button type="button" id="reset-btn">Clear all</button>
				</div>
			</form>

			<div id="results" class="results" hidden>
				<h2>Your FSS score</h2>
				<div class="total-score">
					<span id="total-score-value">—</span>
					<span class="total-score-label">out of 7</span>
				</div>
				<p id="score-interpretation" class="score-interp"></p>

				<h3>Item breakdown</h3>
				<table class="breakdown-table">
					<thead>
						<tr>
							<th>Statement</th>
							<th>Your rating</th>
						</tr>
					</thead>
					<tbody id="breakdown-rows"></tbody>
					<tfoot>
						<tr>
							<td><strong>Mean score</strong></td>
							<td><strong id="breakdown-total"></strong></td>
						</tr>
					</tfoot>
				</table>

				<ScoreHistory toolId="fss" toolName="FSS" />

				<button type="button" id="back-btn" class="back-btn">Edit answers</button>
			</div>

			<SharedResults toolId="fss" />

			<FssInterpretation>
				<div class="disclaimer" slot="disclaimer"><strong>This is not a diagnostic tool.</strong> Your score reflects self-reported fatigue impact and does not constitute a diagnosis of any condition. Discuss results with your doctor.</div>
				<p class="citation" slot="citation">Based on: Krupp LB, LaRocca NG, Muir-Nash J, Steinberg AD. The fatigue severity scale. Application to patients with multiple sclerosis and systemic lupus erythematosus. Arch Neurol. 1989;46(10):1121–1123.</p>
			</FssInterpretation>
</Page>

<script>
	import { fss } from '../../tools/fss';
	import { interpretResult } from '../../scripts/results/interpretation';
	import { mountScoreHistory, mountSharedResults } from '../../scripts/results/scoreHistory';

	const QUESTIONS = [
		'My motivation is lower when I am fatigued.',
		'Exercise brings on my fatigue.',
		'I am easily fatigued.',
		'Fatigue interferes with my physical functioning.',
		'Fatigue causes frequent problems for me.',
		'My fatigue prevents sustained physical functioning.',
		'Fatigue interferes with carrying out certain duties and responsibilities.',
		'Fatigue is among my three most disabling symptoms.',
		'Fatigue interferes with my work, family, or social life.',
	];

	const form = document.getElementById('fss-form') as HTMLFormElement;
	const results = document.getElementById('results') as HTMLElement;
	const totalEl = document.getElementById('total-score-value') as HTMLElement;
	const interpEl = document.getElementById('score-interpretation') as HTMLElement;
	const rowsEl = document.getElementById('breakdown-rows') as HTMLElement;
	const breakdownTotalEl = document.getElementById('breakdown-total') as HTMLElement;
	const history = mountScoreHistory(fss);
	mountSharedResults(fss);

	function getVal(i: number): number | null {
		const checked = document.querySelector<HTMLInputElement>(`input[name="q${i}"]:checked`);
		return checked ? parseInt(checked.value) : null;
	}

	// REVIEW: Layer 1 copy. The band is judged on the rounded mean that is shown,
	// so 3.95 displays as 4.0 and is described as at or above 4 (Valko et al. 2008).
	function interpret(rounded: number): string {
		const shown = rounded.toFixed(1);
		const opening = `Your FSS score is ${shown} out of 7, the average of your nine answers.`;
		const context = 'In that study, healthy adults averaged 3.0 and people with multiple sclerosis 4.7.';
		return [opening, interpretResult(fss, { total: rounded, subscores: {} }, history.latest()), context].filter(Boolean).join(' ');
	}

	form.addEventListener('submit', (e) => {
		e.preventDefault();

		let total = 0;
		const answers: number[] = [];

		for (let i = 0; i < 9; i++) {
			const v = getVal(i);
			if (v === null) {
				alert('Please answer all 9 questions before calculating your score.');
				const firstUnanswered = document.querySelector<HTMLElement>(`.question[data-index="${i}"]`);
				firstUnanswered?.scrollIntoView({ behavior: 'smooth', block: 'center' });
				return;
			}
			answers.push(v);
			total += v;
		}

		const mean = total / 9;
		const rounded = Math.round(mean * 10) / 10;
		totalEl.textContent = rounded.toFixed(1);
		interpEl.textContent = interpret(rounded);
		breakdownTotalEl.textContent = rounded.toFixed(1);

		rowsEl.innerHTML = answers.map((val, i) => `
			<tr>
				<td>${QUESTIONS[i]}</td>
				<td>${val}</td>
			</tr>
		`).join('');

		form.hidden = true;
		results.hidden = false;
		history.record({ total: rounded, subscores: {} });
		results.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});

	document.getElementById('reset-btn')?.addEventListener('click', () => form.reset());

	document.getElementById('back-btn')?.addEventListener('click', () => {
		results.hidden = true;
		form.hidden = false;
		form.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});
</script>

<style>
	.tool-header {
		padding-bottom: 1.5em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2.5em;
	}
	.tool-header h1 { margin: 0.3em 0 0.1em; }
	.subtitle { color: rgb(var(--gray)); font-size: 1.05em; margin: 0 0 0.75em; }

	.form-instructions {
		color: rgb(var(--gray));
		font-style: italic;
		margin-bottom: 1.5em;
		font-size: 0.95em;
	}

	.question-grid { display: flex; flex-direction: column; gap: 0; }
	.question {
		padding: 1.1em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.q-text { margin: 0 0 0.6em; font-size: 0.95em; }
	.q-num { font-weight: 700; margin-right: 0.25em; }
	.options {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
	}
	.options label {
		display: flex;
		align-items: center;
		gap: 0.4em;
		cursor: pointer;
		font-size: 0.88em;
		padding: 0.5em 0.8em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 3px;
		transition: background 0.1s, border-color 0.1s;
		white-space: nowrap;
	}
	.options label:hover { border-color: var(--accent); color: var(--accent); }
	.options label:has(input:checked) {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
		font-weight: 700;
	}
	/* Visually hidden but still keyboard-focusable (display:none would remove
	   the radios from tab order entirely). */
	.options input[type="radio"] { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }

	.form-footer {
		display: flex;
		gap: 1em;
		padding: 2em 0 1em;
	}
	button[type="submit"] {
		background: var(--accent);
		color: #fff;
		border: none;
		padding: 0.75em 2em;
		border-radius: 3px;
		font-size: 1em;
		font-weight: 700;
		cursor: pointer;
		font-family: inherit;
	}
	button[type="submit"]:hover { background: var(--accent-dark); }
	button[type="button"] {
		background: none;
		border: 1px solid rgb(var(--gray-light));
		padding: 0.75em 1.5em;
		border-radius: 3px;
		font-size: 0.95em;
		cursor: pointer;
		color: rgb(var(--gray));
		font-family: inherit;
	}

	/* Results */
	.results { padding-top: 1em; }
	.results h2, .results h3 { margin-bottom: 0.5em; }
	.total-score {
		display: flex;
		align-items: baseline;
		gap: 0.5em;
		margin: 1em 0;
	}
	#total-score-value {
		font-size: 3.5em;
		font-weight: 700;
		color: var(--accent);
		line-height: 1;
	}
	.total-score-label { color: rgb(var(--gray)); font-size: 1.1em; }
	.score-interp {
		font-size: 1em;
		line-height: 1.6;
		margin: 0 0 2em;
		padding: 0;
	}
	.breakdown-table { margin: 1em 0 2em; font-size: 0.9em; }
	.breakdown-table tfoot td { border-bottom: none; border-top: 2px solid rgb(var(--gray-light)); }
	.back-btn {
		background: none;
		border: 1px solid rgb(var(--gray-light));
		padding: 0.6em 1.25em;
		border-radius: 3px;
		font-size: 0.95em;
		cursor: pointer;
		color: rgb(var(--gray));
		font-family: inherit;
		margin-top: 1em;
	}
	.back-btn:hover { border-color: var(--accent); color: var(--accent); }

	@media (max-width: 600px) {
		.options { flex-direction: column; }
		.form-footer { flex-direction: column; }
	}
</style>
