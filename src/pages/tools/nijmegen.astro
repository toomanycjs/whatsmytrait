---
import Page from '../../layouts/Page.astro';

const questions = [
	'Chest pain',
	'Feeling tense',
	'Blurred vision',
	'Dizziness',
	'Feeling confused or disoriented',
	'Faster or deeper breathing than usual',
	'Short of breath',
	'Tight feelings in chest',
	'Bloated feeling in the stomach',
	'Tingling fingers',
	'Unable to breathe deeply',
	'Stiff fingers or arms',
	'Tight feelings around the mouth',
	'Cold hands or feet',
	'Palpitations (heart pounding or racing)',
	'Feelings of anxiety',
];

const frequencies = [
	{ value: 0, label: 'Never' },
	{ value: 1, label: 'Rarely' },
	{ value: 2, label: 'Sometimes' },
	{ value: 3, label: 'Often' },
	{ value: 4, label: 'Very often' },
];
---

<Page
	title="Nijmegen questionnaire: free online version, instant scoring"
	description="Complete the Nijmegen questionnaire online and get your score instantly. A free, interactive version of the breathing pattern questionnaire used to screen for hyperventilation syndrome, with your result explained. No sign-up, no PDF to print."
>
	<Fragment slot="head">
	<script type="application/ld+json">
	{
	  "@context": "https://schema.org",
	  "@graph": [
	    {
	      "@type": "BreadcrumbList",
	      "itemListElement": [
	        {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.postviralrecovery.com/"},
	        {"@type": "ListItem", "position": 2, "name": "Tools", "item": "https://www.postviralrecovery.com/tools/"},
	        {"@type": "ListItem", "position": 3, "name": "Nijmegen Questionnaire", "item": "https://www.postviralrecovery.com/tools/nijmegen/"}
	      ]
	    },
	    {
	      "@type": "FAQPage",
	      "mainEntity": [
	        {
	          "@type": "Question",
	          "name": "What is a normal Nijmegen questionnaire score?",
	          "acceptedAnswer": {"@type": "Answer", "text": "A score below 23 is below the clinical threshold for hyperventilation syndrome. A score of 23 or above is the standard positive screen threshold."}
	        },
	        {
	          "@type": "Question",
	          "name": "What does a Nijmegen score above 23 mean?",
	          "acceptedAnswer": {"@type": "Answer", "text": "A score of 23 or above is a positive screen for hyperventilation syndrome or breathing pattern disorder. It suggests that further clinical assessment of breathing pattern may be helpful. Discuss your score with your doctor."}
	        }
	      ]
	    }
	  ]
	}
	</script>
	</Fragment>
			<div class="tool-header">
				<a href="/tools" class="section-label tools">Tools</a>
				<h1>Nijmegen Questionnaire</h1>
				<p class="subtitle">Breathing Pattern Disorder Screening</p>
				<p class="description">
  The Nijmegen questionnaire is a 16-item self-report screening tool for hyperventilation syndrome and breathing pattern disorder. It was originally developed by van Dixhoorn and Duivenvoorden and has been widely used in respiratory and physiotherapy settings since the 1980s. Each item asks how often you experience a particular symptom on a scale from 0 (never) to 4 (very often), producing a total score between 0 and 64.
</p>
<p class="description">
  Breathing pattern disorder is common in post-viral conditions, POTS, and ME/CFS, and is often underdiagnosed. It can contribute to or worsen symptoms including breathlessness, dizziness, chest tightness, tingling in the hands and face, and brain fog. Because these symptoms overlap significantly with autonomic dysfunction and post-viral fatigue, breathing pattern disorder can be difficult to distinguish from other aspects of a post-viral condition without specific screening.
</p>
<p class="description">
  The Nijmegen questionnaire is not a definitive diagnostic test, but it is a useful first step. A score above 23 is the standard threshold for suspected hyperventilation syndrome, and it is commonly used by respiratory physiotherapists and in specialist post-viral clinics to decide whether further assessment of breathing pattern is warranted. Because it was written for hyperventilation, it can miss the restricted, effortful, upper-chest breathing patterns that are common after respiratory infections; the <a href="/tools/self-evaluation-of-breathing-questionnaire/">Self-Evaluation of Breathing Questionnaire (SEBQ)</a> asks only about breathing sensations and is the usual companion measure.
</p>
<p class="description">
  This is a free, interactive version. Complete it below and receive your score immediately. No sign-up or email is required.
</p>
<div class="disclaimer">
  <strong>This is not a diagnostic tool.</strong> A score above the threshold suggests that further clinical assessment of breathing pattern may be worthwhile; it does not establish a diagnosis. Breathing symptoms can have multiple causes. Discuss results with your doctor. Based on: van Dixhoorn J, Duivenvoorden HJ. <em>Efficacy of Nijmegen Questionnaire in recognition of the hyperventilation syndrome.</em> J Psychosom Res. 1985;29(2):199–206.
</div>
			</div>

			<form id="nijmegen-form" novalidate>
				<p class="form-instructions">For each symptom, indicate how often you experience it:</p>

				<div class="question-grid">
					{questions.map((q, i) => (
						<div class="question" data-index={i}>
							<p class="q-text"><span class="q-num">{i + 1}.</span> {q}</p>
							<div class="options">
								{frequencies.map(f => (
									<label>
										<input type="radio" name={`q${i}`} value={f.value} required />
										<span>{f.label}</span>
									</label>
								))}
							</div>
						</div>
					))}
				</div>

				<div class="form-footer">
					<button type="submit">Calculate score</button>
					<button type="button" id="reset-btn">Clear all</button>
				</div>
			</form>

			<div id="results" class="results" hidden>
				<h2>Your Nijmegen score</h2>
				<div class="total-score">
					<span id="total-score-value">—</span>
					<span class="total-score-label">out of 64</span>
				</div>
				<p id="score-interpretation" class="score-interp"></p>

				<h3>Item breakdown</h3>
				<table class="breakdown-table">
					<thead>
						<tr>
							<th>Symptom</th>
							<th>Your response</th>
							<th>Score</th>
						</tr>
					</thead>
					<tbody id="breakdown-rows"></tbody>
					<tfoot>
						<tr>
							<td><strong>Total</strong></td>
							<td></td>
							<td><strong id="breakdown-total"></strong></td>
						</tr>
					</tfoot>
				</table>

				<div class="results-disclaimer">
  <h3>Understanding your score</h3>
  <p>The Nijmegen questionnaire produces a total score between 0 and 64. Higher scores indicate a greater number and frequency of symptoms associated with hyperventilation and disordered breathing.</p>
  <p>The established clinical threshold is a score of <strong>23 or above</strong>, which is considered a positive screen for hyperventilation syndrome or breathing pattern disorder.</p>
  <p><strong>0–22:</strong> below the clinical threshold. Your pattern of symptoms is not strongly suggestive of hyperventilation syndrome based on this screening, though individual symptoms may still be worth discussing with a clinician.</p>
  <p><strong>23 and above:</strong> positive screen. This score suggests that further assessment of breathing pattern may be helpful. Discuss your score with your doctor.</p>
  <p>A positive score does not mean you definitely have breathing pattern disorder. Similarly, a score below 23 does not rule it out, particularly if you have symptoms that come and go or are triggered by specific situations.</p>
  <p>In post-viral conditions, breathing pattern disorder often coexists with autonomic dysfunction, deconditioning, and anxiety. The two presentations can reinforce each other.</p>
  <p><strong>This is a screening tool only.</strong> It cannot establish a diagnosis. Discuss your score and any breathing symptoms with your doctor.</p>
</div>

				<button type="button" id="back-btn" class="back-btn">Edit answers</button>
			</div>
</Page>

<script>
	const QUESTIONS = [
		'Chest pain', 'Feeling tense', 'Blurred vision', 'Dizziness',
		'Feeling confused or disoriented', 'Faster or deeper breathing than usual',
		'Short of breath', 'Tight feelings in chest', 'Bloated feeling in the stomach',
		'Tingling fingers', 'Unable to breathe deeply', 'Stiff fingers or arms',
		'Tight feelings around the mouth', 'Cold hands or feet',
		'Palpitations', 'Feelings of anxiety',
	];

	const FREQ_LABELS = ['Never', 'Rarely', 'Sometimes', 'Often', 'Very often'];

	const form = document.getElementById('nijmegen-form') as HTMLFormElement;
	const results = document.getElementById('results') as HTMLElement;
	const totalEl = document.getElementById('total-score-value') as HTMLElement;
	const interpEl = document.getElementById('score-interpretation') as HTMLElement;
	const rowsEl = document.getElementById('breakdown-rows') as HTMLElement;
	const breakdownTotalEl = document.getElementById('breakdown-total') as HTMLElement;

	function getVal(i: number): number | null {
		const checked = document.querySelector<HTMLInputElement>(`input[name="q${i}"]:checked`);
		return checked ? parseInt(checked.value) : null;
	}

	function interpret(score: number): string {
		if (score < 23) {
			return `Your score of ${score} is below the published threshold of 23. If you have ongoing breathlessness or other respiratory symptoms, discuss them with your doctor.`;
		}
		return `Your score of ${score} is at or above the published threshold of 23. The questionnaire was designed to identify people who may benefit from clinical assessment of their breathing pattern. Discuss this score with your doctor.`;
	}

	form.addEventListener('submit', (e) => {
		e.preventDefault();

		let total = 0;
		const answers: number[] = [];

		for (let i = 0; i < 16; i++) {
			const v = getVal(i);
			if (v === null) {
				alert('Please answer all 16 questions before calculating your score.');
				const firstUnanswered = document.querySelector<HTMLElement>(`.question[data-index="${i}"]`);
				firstUnanswered?.scrollIntoView({ behavior: 'smooth', block: 'center' });
				return;
			}
			answers.push(v);
			total += v;
		}

		totalEl.textContent = String(total);
		interpEl.textContent = interpret(total);
		breakdownTotalEl.textContent = String(total);

		rowsEl.innerHTML = answers.map((val, i) => `
			<tr>
				<td>${QUESTIONS[i]}</td>
				<td>${FREQ_LABELS[val]}</td>
				<td>${val}</td>
			</tr>
		`).join('');

		form.hidden = true;
		results.hidden = false;
		results.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});

	document.getElementById('reset-btn')?.addEventListener('click', () => form.reset());

	document.getElementById('back-btn')?.addEventListener('click', () => {
		results.hidden = true;
		form.hidden = false;
		form.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});
</script>

<style>
	.tool-header {
		padding-bottom: 1.5em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2.5em;
	}
	.tool-header h1 { margin: 0.3em 0 0.1em; }
	.subtitle { color: rgb(var(--gray)); font-size: 1.05em; margin: 0 0 0.75em; }

	.form-instructions {
		color: rgb(var(--gray));
		font-style: italic;
		margin-bottom: 1.5em;
		font-size: 0.95em;
	}

	.question-grid { display: flex; flex-direction: column; gap: 0; }
	.question {
		padding: 1.1em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.q-text { margin: 0 0 0.6em; font-size: 0.95em; }
	.q-num { font-weight: 700; margin-right: 0.25em; }
	.options {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
	}
	.options label {
		display: flex;
		align-items: center;
		gap: 0.4em;
		cursor: pointer;
		font-size: 0.88em;
		padding: 0.35em 0.65em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 20px;
		transition: background 0.1s, border-color 0.1s;
		white-space: nowrap;
	}
	.options label:hover { border-color: var(--accent); color: var(--accent); }
	.options label:has(input:checked) {
		background: var(--accent-light);
		border-color: var(--accent);
		color: var(--accent-dark);
		font-weight: 700;
	}
	.options input[type="radio"] { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }

	.form-footer {
		display: flex;
		gap: 1em;
		padding: 2em 0 1em;
	}
	button[type="submit"] {
		background: var(--accent);
		color: #fff;
		border: none;
		padding: 0.75em 2em;
		border-radius: 5px;
		font-size: 1em;
		font-weight: 700;
		cursor: pointer;
		font-family: inherit;
	}
	button[type="submit"]:hover { background: var(--accent-dark); }
	button[type="button"] {
		background: none;
		border: 1px solid rgb(var(--gray-light));
		padding: 0.75em 1.5em;
		border-radius: 5px;
		font-size: 0.95em;
		cursor: pointer;
		color: rgb(var(--gray));
		font-family: inherit;
	}

	/* Results */
	.results { padding-top: 1em; }
	.results h2, .results h3 { margin-bottom: 0.5em; }
	.total-score {
		display: flex;
		align-items: baseline;
		gap: 0.5em;
		margin: 1em 0;
	}
	#total-score-value {
		font-size: 3.5em;
		font-weight: 700;
		color: var(--accent);
		line-height: 1;
	}
	.total-score-label { color: rgb(var(--gray)); font-size: 1.1em; }
	.score-interp {
		font-size: 1em;
		line-height: 1.6;
		margin: 0 0 2em;
		padding: 1em 1.25em;
		background: var(--accent-light);
		border-left: 4px solid var(--accent);
		border-radius: 4px;
	}
	.breakdown-table { margin: 1em 0 2em; font-size: 0.9em; }
	.breakdown-table tfoot td { border-bottom: none; border-top: 2px solid rgb(var(--gray-light)); }
	.results-disclaimer {
		font-size: 0.88em;
		color: rgb(var(--gray-dark));
		border-top: 1px solid rgb(var(--gray-light));
		padding-top: 1.5em;
		line-height: 1.6;
	}
	.results-disclaimer h3 { font-size: 1em; color: rgb(var(--black)); margin-bottom: 0.5em; }
	.back-btn {
		background: none;
		border: 1px solid rgb(var(--gray-light));
		padding: 0.6em 1.25em;
		border-radius: 5px;
		font-size: 0.95em;
		cursor: pointer;
		color: rgb(var(--gray));
		font-family: inherit;
		margin-top: 1em;
	}
	.back-btn:hover { border-color: var(--accent); color: var(--accent); }

	@media (max-width: 600px) {
		.options { flex-direction: column; }
		.form-footer { flex-direction: column; }
	}
</style>
