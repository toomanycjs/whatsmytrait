---
import Page from '../../layouts/Page.astro';
import ScoreHistory from '../../components/ScoreHistory.astro';
import SharedResults from '../../components/SharedResults.astro';
import MalmoPotsInterpretation from '../../components/interpretation/MalmoPotsScore.astro';
import { FAQ, FAQ_ORDER } from '../../tools/malmo-pots-score.content';
import { toolJsonLd } from '../../tools/jsonld';

const jsonLd = toolJsonLd('Malmö POTS Symptom Score', '/tools/malmo-pots-score/', FAQ_ORDER.map(k => FAQ[k]));

const items = [
	{ id: 'dizziness', text: 'Dizziness or light-headedness', group: 'cardiac' },
	{ id: 'presyncope', text: 'Presyncope (feeling that you are about to faint)', group: 'cardiac' },
	{ id: 'palpitations', text: 'Palpitations (rapid or pounding heartbeat)', group: 'cardiac' },
	{ id: 'dyspnoea', text: 'Shortness of breath', group: 'cardiac' },
	{ id: 'chestpain', text: 'Chest pain or chest discomfort', group: 'cardiac' },
	{ id: 'headache', text: 'Headache', group: 'noncardiac' },
	{ id: 'concentration', text: 'Concentration difficulties ("brain fog")', group: 'noncardiac' },
	{ id: 'myalgia', text: 'Muscle pain', group: 'noncardiac' },
	{ id: 'nausea', text: 'Nausea', group: 'noncardiac' },
	{ id: 'gi', text: 'Gastrointestinal symptoms (stomach pain, diarrhoea, or constipation)', group: 'noncardiac' },
	{ id: 'fatigue', text: 'Fatigue', group: 'noncardiac' },
	{ id: 'insomnia', text: 'Insomnia (difficulty sleeping)', group: 'noncardiac' },
];
---

<Page
	title="Malmö POTS Symptom Score (MAPS): free online POTS symptom questionnaire"
	description="Rate 12 POTS symptoms from the past week and get your Malmö POTS Score (0–120) instantly, with the validated ≥42 threshold explained. Free, no sign-up, useful for tracking symptom burden over time."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</Fragment>
			<div class="tool-header">
				<a href="/tools" class="section-label tools">Tools</a>
				<h1>Malmö POTS Symptom Score</h1>
				<p class="subtitle">MAPS: a 12-symptom score for POTS symptom burden, past 7 days</p>
				<p class="description">
					The Malmö POTS Symptom Score (MAPS) was developed at Lund University and published in the <em>Journal of Internal Medicine</em> in 2023. It is the first self-rating score designed specifically for POTS. You rate 12 common symptoms (five cardiac, seven non-cardiac) from <strong>0 (no symptoms)</strong> to <strong>10 (very pronounced)</strong> for the <strong>past 7 days</strong>. The total runs from 0 to 120.
				</p>
				<p class="description">
					In the validation study, patients with tilt-test-confirmed POTS averaged <strong>78</strong>. Healthy controls averaged <strong>14</strong>. A threshold of <strong>42 or more</strong> separated the groups with 97% sensitivity and 98% specificity. Because it covers a single week, MAPS suits regular tracking: before and after starting a medication, an intervention, or a pacing change.
				</p>
				<p class="description">
					MAPS complements the other autonomic tools here: the <a href="/tools/compass-31/">COMPASS-31</a> covers autonomic symptoms more broadly across six domains, the <a href="/tools/orthostatic-grading-scale/">Orthostatic Grading Scale</a> grades your usual orthostatic pattern, the <a href="/tools/vanderbilt-orthostatic-symptom-score/">Vanderbilt Orthostatic Symptom Score</a> is the trial measure rated while standing, and the <a href="/tools/nasa-lean-test/">NASA lean test</a> gives you the objective heart-rate data that a POTS assessment actually requires. <!-- REVIEW: softened --> Together, a MAPS score and lean-test readings give an appointment something structured to work from.
				</p>
				<div class="disclaimer">
					<strong>This is not a diagnostic tool.</strong> POTS is diagnosed from a documented orthostatic heart rate response with symptoms, after excluding other causes. A symptom score alone cannot diagnose it. <!-- REVIEW: reworded --> The original study compared tilt-confirmed POTS with healthy controls only, so scores may also be high in other conditions with similar symptoms, such as ME/CFS or long COVID, and a high score does not itself indicate POTS. Discuss your results with your doctor. Based on: Spahic JM, Hamrefors V, Johansson M, et al. <em>Malmö POTS symptom score: Assessing symptom burden in postural orthostatic tachycardia syndrome.</em> J Intern Med. 2023;293(1):91–99 (open access, CC BY-NC).
				</div>
			</div>

			<form id="maps-form" novalidate>
				<p class="form-instructions">Rate each symptom for the <strong>past 7 days</strong>, where 0 = no symptoms and 10 = very pronounced symptoms.</p>

				<h2 class="group-title">Cardiac symptoms</h2>
				{items.filter(i => i.group === 'cardiac').map(item => (
					<div class="symptom" data-id={item.id}>
						<p class="symptom-text">{item.text}</p>
						<div class="segmented">
							{Array.from({ length: 11 }, (_, v) => (
								<label>
									<input type="radio" name={item.id} value={v} aria-label={v === 0 ? '0: no symptoms' : v === 10 ? '10: very pronounced symptoms' : String(v)} />
									<span aria-hidden="true">{v}</span>
								</label>
							))}
						</div>
					</div>
				))}

				<h2 class="group-title">Non-cardiac symptoms</h2>
				{items.filter(i => i.group === 'noncardiac').map(item => (
					<div class="symptom" data-id={item.id}>
						<p class="symptom-text">{item.text}</p>
						<div class="segmented">
							{Array.from({ length: 11 }, (_, v) => (
								<label>
									<input type="radio" name={item.id} value={v} aria-label={v === 0 ? '0: no symptoms' : v === 10 ? '10: very pronounced symptoms' : String(v)} />
									<span aria-hidden="true">{v}</span>
								</label>
							))}
						</div>
					</div>
				))}

				<div class="form-footer">
					<button type="submit">Calculate my score</button>
					<button type="button" id="reset-btn">Clear all</button>
				</div>
			</form>

			<div id="results" class="results" hidden>
				<h2>Your MAPS score</h2>
				<div class="total-score">
					<span id="total-score-value">—</span>
					<span class="total-score-label">out of 120</span>
				</div>
				<p id="score-interpretation" class="score-interp"></p>

				<h3>Symptom breakdown</h3>
				<div id="chart" class="chart"></div>

				<ScoreHistory toolId="malmo-pots-score" toolName="Malmö POTS score" />

				<button type="button" id="back-btn" class="back-btn">Edit answers</button>
			</div>

			<SharedResults toolId="malmo-pots-score" />

			<MalmoPotsInterpretation />
</Page>

<script>
import { malmoPotsScore } from '../../tools/malmo-pots-score';
import { interpretResult } from '../../scripts/results/interpretation';
import { mountScoreHistory, mountSharedResults } from '../../scripts/results/scoreHistory';

const ITEMS = [
	{ id: 'dizziness', text: 'Dizziness or light-headedness' },
	{ id: 'presyncope', text: 'Presyncope (near-fainting)' },
	{ id: 'palpitations', text: 'Palpitations' },
	{ id: 'dyspnoea', text: 'Shortness of breath' },
	{ id: 'chestpain', text: 'Chest pain or discomfort' },
	{ id: 'headache', text: 'Headache' },
	{ id: 'concentration', text: 'Concentration difficulties' },
	{ id: 'myalgia', text: 'Muscle pain' },
	{ id: 'nausea', text: 'Nausea' },
	{ id: 'gi', text: 'Gastrointestinal symptoms' },
	{ id: 'fatigue', text: 'Fatigue' },
	{ id: 'insomnia', text: 'Insomnia' },
];

const form = document.getElementById('maps-form') as HTMLFormElement;
const results = document.getElementById('results') as HTMLElement;

const history = mountScoreHistory(malmoPotsScore);
mountSharedResults(malmoPotsScore);

function getVal(id: string): number | null {
	const checked = form.querySelector<HTMLInputElement>(`input[name="${id}"]:checked`);
	return checked ? parseInt(checked.value, 10) : null;
}

form.addEventListener('submit', (e) => {
	e.preventDefault();

	for (const item of ITEMS) {
		if (getVal(item.id) === null) {
			const el = form.querySelector<HTMLElement>(`.symptom[data-id="${item.id}"]`);
			el?.classList.add('missing');
			el?.scrollIntoView({ behavior: 'smooth', block: 'center' });
			setTimeout(() => el?.classList.remove('missing'), 2500);
			return;
		}
	}

	const values = ITEMS.map(it => ({ item: it, val: getVal(it.id)! }));
	const total = values.reduce((s, v) => s + v.val, 0);

	(document.getElementById('total-score-value') as HTMLElement).textContent = String(total);

	// REVIEW: Layer 1 copy. interpretResult adds the band sentence (the 42
	// cut-off, Spahic et al. 2023); no MIC is published and topDomains is 0.
	const subscores = Object.fromEntries(values.map(v => [v.item.id, v.val]));
	const opening = `Your total MAPS score is ${total} out of 120 for the past 7 days.`;
	const context = 'In the original study, people with POTS averaged 78 and healthy controls 14; a symptom score cannot diagnose POTS on its own.';
	const interp = [opening, interpretResult(malmoPotsScore, { total, subscores }, history.latest()), context].filter(Boolean).join(' ');
	(document.getElementById('score-interpretation') as HTMLElement).textContent = interp;

	const chart = document.getElementById('chart') as HTMLElement;
	chart.innerHTML = values.map(v => {
		const pct = Math.round((v.val / 10) * 100);
		return `
			<div class="chart-row">
				<div class="chart-label">${v.item.text}</div>
				<div class="chart-track"><div class="chart-bar" style="width:${Math.max(2, pct)}%"></div></div>
				<div class="chart-val">${v.val}</div>
			</div>`;
	}).join('');

	form.hidden = true;
	results.hidden = false;
	history.record({ total, subscores });
	results.scrollIntoView({ behavior: 'smooth', block: 'start' });
});

document.getElementById('reset-btn')?.addEventListener('click', () => form.reset());
document.getElementById('back-btn')?.addEventListener('click', () => {
	results.hidden = true;
	form.hidden = false;
	form.scrollIntoView({ behavior: 'smooth', block: 'start' });
});
</script>

<style>
	.tool-header {
		padding-bottom: 1.5em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2em;
	}
	.tool-header h1 { margin: 0.3em 0 0.1em; }
	.subtitle { color: rgb(var(--gray)); font-size: 1.05em; margin: 0 0 0.75em; }
	.description { margin-bottom: 1em; }

	.form-instructions {
		font-size: 0.88em;
		color: rgb(var(--gray-dark));
		background: var(--accent-light);
		border-radius: 6px;
		padding: 0.7em 1.1em;
		margin-bottom: 1.25em;
	}
	.group-title { font-size: 1.15em; margin: 1.25em 0 0.6em; }

	.symptom {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		padding: 0.9em 1.2em;
		margin-bottom: 0.65em;
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.symptom.missing { border-color: #c0392b; box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.12); }
	.symptom-text { margin: 0 0 0.7em; font-weight: 700; font-size: 0.95em; line-height: 1.4; }

	.segmented { display: grid; grid-template-columns: repeat(11, 1fr); gap: 0.3em; max-width: 32em; }
	.segmented label {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.88em;
		padding: 0.45em 0;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 5px;
		cursor: pointer;
		transition: background 0.1s, border-color 0.1s;
	}
	.segmented label:hover { border-color: var(--accent); }
	.segmented input { position: absolute; opacity: 0; width: 0; height: 0; }
	.segmented label:has(input:checked) {
		background: var(--accent-light);
		border-color: var(--accent);
		color: var(--accent-dark);
		font-weight: 700;
		box-shadow: inset 0 0 0 1px var(--accent);
	}

	.form-footer { display: flex; gap: 1em; padding: 1.5em 0 1em; }
	button[type="submit"] {
		background: var(--accent); color: #fff; border: none;
		padding: 0.75em 2em; border-radius: 5px; font-size: 1em; font-weight: 700;
		cursor: pointer; font-family: inherit;
	}
	button[type="submit"]:hover { background: var(--accent-dark); }
	button[type="button"] {
		background: none; border: 1px solid rgb(var(--gray-light));
		padding: 0.75em 1.5em; border-radius: 5px; font-size: 0.95em;
		cursor: pointer; color: rgb(var(--gray)); font-family: inherit;
	}

	/* Results */
	.results { padding-top: 1em; }
	.results h2 { margin-bottom: 0.5em; }
	.results h3 { margin-top: 1.75em; margin-bottom: 0.4em; }
	.total-score { display: flex; align-items: baseline; gap: 0.5em; margin: 1em 0; }
	#total-score-value { font-size: 3.5em; font-weight: 700; color: var(--accent); line-height: 1; }
	.total-score-label { color: rgb(var(--gray)); font-size: 1.1em; }
	.score-interp {
		font-size: 1em; line-height: 1.6; margin: 0 0 1em;
		padding: 1em 1.25em; background: var(--accent-light);
		border-left: 4px solid var(--accent); border-radius: 4px;
	}

	.chart { display: flex; flex-direction: column; gap: 0.5em; margin: 1em 0; }
	/* Chart rows are injected by script, so they never get Astro's scope
	   attribute; anchor them to the static .chart container instead. */
	.chart :global(.chart-row) { display: grid; grid-template-columns: 12em 1fr 2em; align-items: center; gap: 0.75em; font-size: 0.88em; }
	.chart :global(.chart-label) { text-align: right; color: rgb(var(--gray-dark)); line-height: 1.25; }
	.chart :global(.chart-track) { background: rgb(var(--gray-light)); border-radius: 4px; height: 1.5em; overflow: hidden; }
	.chart :global(.chart-bar) { height: 100%; background: var(--accent); border-radius: 4px; min-width: 2px; transition: width 0.4s ease; }
	.chart :global(.chart-val) { font-weight: 700; color: var(--accent); text-align: right; }

	.back-btn {
		background: none; border: 1px solid rgb(var(--gray-light));
		padding: 0.6em 1.25em; border-radius: 5px; font-size: 0.95em;
		cursor: pointer; color: rgb(var(--gray)); font-family: inherit;
		margin-top: 1.5em;
	}
	.back-btn:hover { border-color: var(--accent); color: var(--accent); }

	@media (max-width: 600px) {
		.symptom { padding: 0.8em 0.9em; }
		.segmented { gap: 0.2em; max-width: none; }
		.segmented label { font-size: 0.75em; }
		.chart :global(.chart-row) { grid-template-columns: 8em 1fr 1.6em; gap: 0.5em; font-size: 0.8em; }
	}
</style>
