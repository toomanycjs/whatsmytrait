---
import FreeToolNote from '../../components/FreeToolNote.astro';
import LastReviewed from '../../components/LastReviewed.astro';
import Page from '../../layouts/Page.astro';
import ResultLinks from '../../components/ResultLinks.astro';
import ScoreHistory from '../../components/ScoreHistory.astro';
import SharedResults from '../../components/SharedResults.astro';
import PcfsInterpretation from '../../components/interpretation/Pcfs.astro';
import { FAQ, FAQ_ORDER } from '../../tools/pcfs.content';

const faqs = FAQ_ORDER.map(k => FAQ[k]);

// Shown under the heading and used as the sitemap lastmod.
const lastReviewed = '2026-10-16';
---

<Page
	breadcrumb="Post-COVID-19 Functional Status scale"
	faqs={faqs}
	title="Post-COVID-19 Functional Status (PCFS) scale: free online"
	description="Free PCFS scale with an instant score, no sign-up. Grade how long COVID limits you, from 0 (no limitations) to 4 (severe), with each step explained."
>
			<div class="tool-header">
				<a href="/tools/" class="section-label tools">Tools</a>
				<h1>Post-COVID-19 Functional Status scale</h1>
				<LastReviewed date={lastReviewed} />
				<FreeToolNote text="Free online scale with an instant grade. No sign-up needed." />
				<p class="subtitle">PCFS: a 0–4 grading of how much daily life is affected</p>
				<p class="description">
					The PCFS scale was proposed by Klok and colleagues in 2020 as a common yardstick for functional status after COVID-19. It gives you a single grade from <strong>0 (no functional limitations)</strong> to <strong>4 (severe limitations)</strong>. It is widely used in long COVID research and rehabilitation, with versions in more than 25 languages.
				</p>
				<p class="description">
					Its strength is simplicity. It measures <strong>consequences for daily life</strong> rather than symptoms, so it works as a quick, repeatable tracking measure. Answer the four questions below to find your grade. It takes well under a minute.
				</p>
				<p class="description">
					Want more detail? The <a href="/tools/funcap/">FUNCAP questionnaire</a> profiles what 27 specific activities cost you, and the <a href="/tools/bell-scale/">Bell scale</a> gives a 0–100 functional rating. If your symptoms flare after activity, see the <a href="/tools/dsq-pem/">post-exertional malaise questionnaire</a>.
				</p>
			</div>

			<div id="flow" class="flow">
				<div class="flow-step" data-q="0">
					<p class="flow-question">1. Can you live alone without any assistance from another person?</p>
					<p class="flow-hint">For example: independently washing, dressing, eating, and using the toilet.</p>
					<div class="flow-answers">
						<button type="button" data-answer="yes">Yes</button>
						<button type="button" data-answer="no">No</button>
					</div>
				</div>
				<div class="flow-step" data-q="1" hidden>
					<p class="flow-question">2. Are there duties or activities at home or at work that you are no longer able to perform yourself?</p>
					<p class="flow-hint">Things you did before the infection that you now cannot do at all.</p>
					<div class="flow-answers">
						<button type="button" data-answer="yes">Yes</button>
						<button type="button" data-answer="no">No</button>
					</div>
				</div>
				<div class="flow-step" data-q="2" hidden>
					<p class="flow-question">3. Do you suffer from persistent symptoms, pain, depression, or anxiety related to the infection?</p>
					<p class="flow-hint">For example: fatigue, breathlessness, brain fog, loss of taste or smell, palpitations.</p>
					<div class="flow-answers">
						<button type="button" data-answer="yes">Yes</button>
						<button type="button" data-answer="no">No</button>
					</div>
				</div>
				<div class="flow-step" data-q="3" hidden>
					<p class="flow-question">4. Do you need to avoid or reduce your usual duties or activities, or spread them over time?</p>
					<p class="flow-hint">You can still do everything, but you have to pace, cut back, or plan around symptoms.</p>
					<div class="flow-answers">
						<button type="button" data-answer="yes">Yes</button>
						<button type="button" data-answer="no">No</button>
					</div>
				</div>
			</div>

			<div id="results" class="results" hidden>
				<h2>Your PCFS grade</h2>
				<div class="total-score">
					<span id="grade-value">—</span>
					<span id="grade-name" class="total-score-label"></span>
				</div>
				<p id="grade-desc" class="score-interp"></p>
				<ResultLinks toolId="pcfs" />

				<ScoreHistory toolId="pcfs" toolName="PCFS scale" />
				<div class="results-buttons">
					<button type="button" id="restart-btn" class="back-btn">Start again</button>
				</div>
			</div>

			<SharedResults toolId="pcfs" />

			<PcfsInterpretation>
				<div class="disclaimer" slot="disclaimer"><strong>This is not a diagnostic tool.</strong> The PCFS grades the functional impact you report; it does not diagnose long COVID or measure symptom severity. Discuss your grade with your doctor.</div>
				<p class="citation" slot="citation">Based on: Klok FA, Boon GJAM, Barco S, et al. <em>The Post-COVID-19 Functional Status scale: a tool to measure functional status over time after COVID-19.</em> Eur Respir J. 2020;56:2001494 (CC BY-NC 4.0).</p>
			</PcfsInterpretation>
</Page>

<script>
import { pcfs } from '../../tools/pcfs';
import { interpretResult } from '../../scripts/results/interpretation';
import { mountScoreHistory, mountSharedResults } from '../../scripts/results/scoreHistory';

// Grade names from the PCFS manual (version 2, July 2020), Table 1.
const GRADE_NAMES = [
	'No functional limitations',
	'Negligible functional limitations',
	'Slight functional limitations',
	'Moderate functional limitations',
	'Severe functional limitations',
];

// REVIEW: Layer 1 copy. interpretResult gives the grade's meaning from the
// config bands; this adds what the validation study found at that grade
// (Machado et al. 2021). The old per-grade advice ("warrants clinical
// support" and so on) was unsourced and has been removed.
const GRADE_CONTEXT = (grade: number) => grade <= 1
	? 'In a study of 1,939 people about three months after COVID-19, people at grades 0 and 1 did not differ in symptoms or quality of life.'
	: 'In a study of 1,939 people about three months after COVID-19, symptoms and quality of life got steadily worse from grade 2 to grade 4.';

const flow = document.getElementById('flow') as HTMLElement;
const steps = Array.from(flow.querySelectorAll<HTMLElement>('.flow-step'));
const results = document.getElementById('results') as HTMLElement;
const history = mountScoreHistory(pcfs);
mountSharedResults(pcfs);

function showStep(n: number) {
	steps.forEach(s => { s.hidden = parseInt(s.dataset.q || '0', 10) !== n; });
}

function finish(grade: number) {
	const name = GRADE_NAMES[grade];
	(document.getElementById('grade-value') as HTMLElement).textContent = String(grade);
	(document.getElementById('grade-name') as HTMLElement).textContent = name;
	(document.getElementById('grade-desc') as HTMLElement).textContent =
		[interpretResult(pcfs, { total: grade, subscores: {} }, history.latest()), GRADE_CONTEXT(grade)].filter(Boolean).join(' ');
	flow.hidden = true;
	results.hidden = false;
	history.record({ total: grade, subscores: {}, summary: `PCFS grade ${grade} out of 4 (${name.toLowerCase()})` });
	results.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

flow.addEventListener('click', (e) => {
	const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-answer]');
	if (!btn) return;
	const step = btn.closest<HTMLElement>('.flow-step');
	const q = parseInt(step?.dataset.q || '0', 10);
	const yes = btn.dataset.answer === 'yes';

	// PCFS flowchart (Klok et al. 2020):
	// Q1 assistance needed -> 4; Q2 unable to perform activities -> 3;
	// Q3 no symptoms -> 0; Q4 needs to avoid/reduce -> 2, else 1.
	if (q === 0) { yes ? showStep(1) : finish(4); }
	else if (q === 1) { yes ? finish(3) : showStep(2); }
	else if (q === 2) { yes ? showStep(3) : finish(0); }
	else { finish(yes ? 2 : 1); }
});

document.getElementById('restart-btn')?.addEventListener('click', () => {
	results.hidden = true;
	flow.hidden = false;
	showStep(0);
	flow.scrollIntoView({ behavior: 'smooth', block: 'start' });
});
</script>

<style>
	.tool-header {
		padding-bottom: 1.5em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2em;
	}
	.tool-header h1 { margin: 0.3em 0 0.1em; }
	.subtitle { color: rgb(var(--gray)); font-size: 1.05em; margin: 0 0 0.75em; }
	.description { margin-bottom: 1em; }

	.flow { margin-bottom: 2.5em; }
	.flow-step {
		padding: 0.5em 0 1.5em;
	}
	.flow-question { font-size: 1.15em; font-weight: 700; margin: 0 0 0.3em; line-height: 1.4; }
	.flow-hint { color: rgb(var(--gray)); font-size: 0.9em; margin: 0 0 1.25em; }
	.flow-answers { display: flex; gap: 0.75em; }
	.flow-answers button {
		font-family: inherit;
		font-size: 1em;
		font-weight: 700;
		padding: 0.65em 2.5em;
		border-radius: 3px;
		border: 1px solid var(--accent);
		background: none;
		color: var(--accent);
		cursor: pointer;
		transition: background 0.1s, color 0.1s;
	}
	.flow-answers button:hover { background: var(--accent); color: #fff; }

	/* Results */
	.results { padding-top: 0.5em; margin-bottom: 2.5em; }
	.results h2 { margin-bottom: 0.5em; }
	.total-score { display: flex; align-items: baseline; gap: 0.6em; margin: 0.75em 0; }
	#grade-value { font-family: var(--font-serif); font-size: 3.2em; font-weight: 600; color: rgb(var(--black)); line-height: 1; font-variant-numeric: tabular-nums; }
	.total-score-label { color: rgb(var(--gray-dark)); font-size: 1.3em; font-weight: 700; }
	.score-interp {
		font-size: 1em; line-height: 1.6; margin: 0 0 1em;
		padding: 0;
	}
	.results-buttons { margin-top: 0.5em; }

	.back-btn {
		background: none; border: 1px solid rgb(var(--gray-light));
		padding: 0.6em 1.25em; border-radius: 3px; font-size: 0.95em;
		cursor: pointer; color: rgb(var(--gray)); font-family: inherit;
	}
	.back-btn:hover { border-color: var(--accent); color: var(--accent); }

	@media (max-width: 600px) {
		.flow-step { padding: 1.1em 0; }
		.flow-answers button { flex: 1; padding: 0.65em 0; }
	}
</style>
