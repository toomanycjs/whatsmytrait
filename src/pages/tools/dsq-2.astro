---
import Page from '../../layouts/Page.astro';
import ScoreHistory from '../../components/ScoreHistory.astro';
import SharedResults from '../../components/SharedResults.astro';
import Dsq2Interpretation from '../../components/interpretation/Dsq2.astro';
import { FAQ, FAQ_ORDER } from '../../tools/dsq-2.content';
import { toolJsonLd } from '../../tools/jsonld';
import {
	FREQ_OPTIONS, HOURS_QUESTIONS, HOURS_STEM, ILLNESS_QUESTIONS, Q63A, RAND_ITEMS, SEV_OPTIONS, SYMPTOM_SECTIONS, SYMPTOMS,
} from '../../tools/dsq-2.items';

// The full set of DSQ-2 symptom items (questions 13-91) in DePaul's order and
// wording, the non-symptom questions the case-definition rules use, and the
// RAND-36 items for the SF-36 subscales. Scoring lives in dsq-2.scoring.ts.

const jsonLd = toolJsonLd('DePaul Symptom Questionnaire (DSQ-2)', '/tools/dsq-2/', FAQ_ORDER.map(k => FAQ[k]));
const totalSteps = SYMPTOM_SECTIONS.length + 2;
const yesNoNot = (q: { options: [number, string][] }) => q.options;
---

<Page
	title="DePaul Symptom Questionnaire (DSQ-2): free online ME/CFS symptom assessment with scoring"
	description="Complete all 79 symptom questions of the DePaul Symptom Questionnaire-2 online for free, scored against four ME/CFS case definitions with DePaul's published rules. No sign-up required."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</Fragment>
			<div class="tool-header">
				<a href="/tools/" class="section-label tools">Tools</a>
				<h1>DePaul Symptom Questionnaire (DSQ-2)</h1>
				<p class="subtitle">All 79 symptom questions, scored against four ME/CFS case definitions</p>
				<p class="description">
					The DSQ-2 is a self-report questionnaire developed by Leonard Jason and colleagues at DePaul University to assess the symptoms of myalgic encephalomyelitis / chronic fatigue syndrome (ME/CFS). It is the revised version of the original DePaul Symptom Questionnaire, with extra symptoms covering the newer case definitions. It is one of the standard research instruments in ME/CFS, and it is free to use.
				</p>
				<p class="description">
					This version asks all 79 DSQ-2 symptom questions in DePaul's wording. Each symptom is rated for how often you have had it and how severe it has been over the <strong>past six months</strong>. It then asks the questions about your illness that the case-definition rules need, and ten short questions from the RAND 36-Item Health Survey that measure how much your health limits you.
				</p>
				<p class="description">
					When you finish, your answers are checked against the four major ME/CFS case definitions using DePaul's published scoring rules: <strong>the IOM/NAM criteria (2015), the Canadian Consensus Criteria (2003), the ME International Consensus Criteria (2011), and Fukuda (1994)</strong>. You also get a summary of eight symptom groups from the DSQ-2 validation study. It is designed for anyone with suspected ME/CFS, long COVID, post-viral fatigue, or overlapping conditions who wants a thorough, structured symptom record to take to an appointment.
				</p>
				<p class="description">
					It is long: about 100 answers in {totalSteps} short sections. Your answers are saved in your browser as you go, so you can pause and pick up where you left off. Nothing you enter leaves your device, and no sign-up or email is required. If you would like a quick screen first, the <a href="/tools/dsq-brief/">4-question DSQ-Brief</a> takes under two minutes, and the <a href="/tools/dsq-pem/">DSQ-PEM</a> focuses on the post-exertional malaise pattern specifically.
				</p>
				<div class="disclaimer">
					<strong>This is not a diagnostic tool.</strong> Your results reflect self-reported symptoms and do not constitute a diagnosis. Meeting a case definition here is not the same as receiving a clinical diagnosis, which requires a clinician and the exclusion of other conditions. Discuss your results with your doctor or specialist. Based on: Jason LA, Sunnquist M. <em>The development of the DePaul Symptom Questionnaire.</em> Front Pediatr. 2018;6:330; and Bedree H, Sunnquist M, Jason LA. <em>The DePaul Symptom Questionnaire-2: A Validation Study.</em> Fatigue. 2019;7(3):166–179.
				</div>
			</div>

			<div id="resume-banner" class="resume-banner" hidden>
				<span>We've restored your progress from earlier on this device. You can carry on where you left off, or start again.</span>
				<div class="resume-actions">
					<button type="button" id="fresh-btn">Start over</button>
				</div>
			</div>

			<form id="dsq-form" novalidate>
				<div class="progress-wrap">
					<div class="progress-text"><span id="progress-label">Section 1 of {totalSteps}</span></div>
					<div class="progress-bar"><div id="progress-fill" class="progress-fill"></div></div>
				</div>

				<!-- SYMPTOM STEPS (DSQ-2 questions 13-91, in order) -->
				{SYMPTOM_SECTIONS.map((section, si) => (
					<section class="step" data-step={si} hidden={si !== 0}>
						<div class="step-head">
							<span class="step-kicker">Symptoms, part {si + 1} of {SYMPTOM_SECTIONS.length}</span>
							<h2>{section.title}</h2>
						</div>
						<div class="scale-key">
							<p>Rate <strong>how often</strong> and <strong>how severe</strong> each symptom has been throughout the past six months. If you have not had a symptom, choose "None of the time" and severity will be set for you.</p>
						</div>
						{section.items.map(n => (
							<Fragment>
								<div class="symptom" data-n={n}>
									<p class="symptom-text" id={`s${n}-text`}>{SYMPTOMS[n]}</p>
									<div class="ratings">
										<div class="rating-group">
											<span class="rating-label">How often</span>
											<div class="segmented" role="radiogroup" aria-label={`How often: ${SYMPTOMS[n]}`}>
												{FREQ_OPTIONS.map((label, v) => (
													<label title={label}><input type="radio" name={`s${n}_f`} value={v} /><span>{label}</span></label>
												))}
											</div>
										</div>
										<div class="rating-group">
											<span class="rating-label">How severe</span>
											<div class="segmented" role="radiogroup" aria-label={`How severe: ${SYMPTOMS[n]}`}>
												{SEV_OPTIONS.map((label, v) => (
													<label title={label}><input type="radio" name={`s${n}_s`} value={v} /><span>{label}</span></label>
												))}
											</div>
										</div>
									</div>
								</div>
								{n === 63 && (
									<div class="symptom choice" data-q={Q63A.id}>
										<p class="symptom-text" id={`${Q63A.id}-text`}>{Q63A.text}</p>
										<div class="segmented vertical" role="radiogroup" aria-labelledby={`${Q63A.id}-text`}>
											{Q63A.options.map(([code, label]) => (
												<label><input type="radio" name={Q63A.id} value={code} /><span>{label}</span></label>
											))}
										</div>
									</div>
								)}
							</Fragment>
						))}
						<div class="step-footer">
							{si === 0 ? <span></span> : <button type="button" class="back-step-btn" data-prev>← Back</button>}
							<button type="button" class="next-btn" data-next>Next →</button>
						</div>
					</section>
				))}

				<!-- ILLNESS QUESTIONS -->
				<section class="step" data-step={SYMPTOM_SECTIONS.length} hidden>
					<div class="step-head">
						<span class="step-kicker">About your illness</span>
						<h2>How your illness started and what it stops you doing</h2>
						<p class="step-intro">The case definitions look at how long you have been ill, how it began, and how much it limits you.</p>
					</div>
					{ILLNESS_QUESTIONS.map(q => (
						<div class="symptom choice" data-q={q.id}>
							<p class="symptom-text" id={`${q.id}-text`}>{q.text}</p>
							<div class="segmented vertical" role="radiogroup" aria-labelledby={`${q.id}-text`}>
								{yesNoNot(q).map(([code, label]) => (
									<label><input type="radio" name={q.id} value={code} /><span>{label}</span></label>
								))}
							</div>
						</div>
					))}
					<div class="symptom hours" data-hours>
						<p class="symptom-text">{HOURS_STEM}</p>
						{HOURS_QUESTIONS.map(h => (
							<label class="hours-row">
								<span>{h.text}</span>
								<input type="number" name={h.id} inputmode="numeric" min="0" max="168" step="1" />
							</label>
						))}
					</div>
					<div class="step-footer">
						<button type="button" class="back-step-btn" data-prev>← Back</button>
						<button type="button" class="next-btn" data-next>Next →</button>
					</div>
				</section>

				<!-- RAND-36 ITEMS FOR THE SF-36 SUBSCALES -->
				<section class="step" data-step={SYMPTOM_SECTIONS.length + 1} hidden>
					<div class="step-head">
						<span class="step-kicker">Final section</span>
						<h2>How your health limits you</h2>
						<p class="step-intro">Ten questions from the RAND 36-Item Health Survey. The case definitions use them to judge whether your functioning is substantially reduced.</p>
					</div>
					{RAND_ITEMS.map(item => (
						<Fragment>
							{item.stem && <p class="rand-stem">{item.stem}</p>}
							<div class="symptom choice" data-q={`r${item.n}`}>
								<p class="symptom-text" id={`r${item.n}-text`}>{item.text}</p>
								<div class="segmented vertical" role="radiogroup" aria-labelledby={`r${item.n}-text`}>
									{item.options.map((label, i) => (
										<label><input type="radio" name={`r${item.n}`} value={i + 1} /><span>{label}</span></label>
									))}
								</div>
							</div>
						</Fragment>
					))}
					<div class="step-footer">
						<button type="button" class="back-step-btn" data-prev>← Back</button>
						<button type="submit" class="submit-btn">Calculate my results</button>
					</div>
				</section>
			</form>

			<!-- RESULTS -->
			<div id="results" class="results" hidden>
				<h2>Your DSQ-2 results</h2>
				<p id="overall-summary" class="score-interp"></p>

				<h3>Case-definition screening</h3>
				<p class="section-lead">Whether your reported symptoms meet each of the four major ME/CFS case definitions, using DePaul's published scoring rules. This is a screen of self-reported symptoms, <strong>not a diagnosis</strong>.</p>
				<div id="casedef-cards" class="casedef-cards"></div>

				<h3>Symptom profile</h3>
				<p class="section-lead">Average symptom score in each of the eight groups from the DSQ-2 validation study (0–100). This is this site's summary, not an official DSQ-2 score. The longer the bar, the more that system is affected.</p>
				<div id="chart" class="chart"></div>

				<h3>Domain breakdown</h3>
				<div id="domain-cards" class="domain-cards"></div>

				<ScoreHistory toolId="dsq-2" toolName="DSQ-2" />

				<div class="results-buttons">
					<button type="button" id="edit-btn" class="back-btn">Edit answers</button>
					<button type="button" id="restart-btn" class="back-btn">Start over</button>
				</div>
			</div>

			<SharedResults toolId="dsq-2" />

			<Dsq2Interpretation />
</Page>

<script>
import { dsq2, dsqOutcome } from '../../tools/dsq-2';
import { SYMPTOMS, RAND_ITEMS, ILLNESS_QUESTIONS, Q63A, HOURS_QUESTIONS } from '../../tools/dsq-2.items';
import { scoreCaseDefinitions, domainScores, type DsqAnswers } from '../../tools/dsq-2.scoring';
import { interpretResult } from '../../scripts/results/interpretation';
import { mountScoreHistory, mountSharedResults } from '../../scripts/results/scoreHistory';

const SYMPTOM_NS = Object.keys(SYMPTOMS).map(Number);
const CODE_IDS = [Q63A.id, ...ILLNESS_QUESTIONS.map(q => q.id)];
const STORAGE_KEY = 'dsq2-answers-v2';
const STEP_KEY = 'dsq2-step-v2';
// Progress saved by the previous version of this page used different question names.
const LEGACY_KEYS = ['dsq2-answers', 'dsq2-step'];

const form = document.getElementById('dsq-form') as HTMLFormElement;
const steps = Array.from(document.querySelectorAll<HTMLElement>('.step'));
const totalSteps = steps.length;
const progressLabel = document.getElementById('progress-label') as HTMLElement;
const progressFill = document.getElementById('progress-fill') as HTMLElement;
const resultsPanel = document.getElementById('results') as HTMLElement;
const resumeBanner = document.getElementById('resume-banner') as HTMLElement;

const history = mountScoreHistory(dsq2);
mountSharedResults(dsq2);

let currentStep = 0;

/* ---------- reading answers ---------- */
function getVal(name: string): number | null {
	const checked = form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
	return checked ? parseInt(checked.value, 10) : null;
}
function getHours(name: string): number | null {
	const el = form.querySelector<HTMLInputElement>(`input[name="${name}"]`);
	if (!el || el.value.trim() === '') return null;
	const v = Number(el.value);
	return Number.isFinite(v) && v >= 0 && v <= 168 ? v : null;
}
function collectAnswers(): DsqAnswers {
	return {
		freq: Object.fromEntries(SYMPTOM_NS.map(n => [n, getVal(`s${n}_f`) ?? 0])),
		sev: Object.fromEntries(SYMPTOM_NS.map(n => [n, getVal(`s${n}_s`) ?? 0])),
		codes: Object.fromEntries(CODE_IDS.map(id => [id, getVal(id) ?? -1])),
		hours: { q119a: getHours('q119a') ?? 0, q119d: getHours('q119d') ?? 0 },
		rand: Object.fromEntries(RAND_ITEMS.map(r => [r.n, getVal(`r${r.n}`) ?? 0])),
	};
}

/* ---------- persistence ---------- */
function saveAnswers() {
	const data: Record<string, string> = {};
	form.querySelectorAll<HTMLInputElement>('input[type="radio"]:checked').forEach(inp => { data[inp.name] = inp.value; });
	for (const h of HOURS_QUESTIONS) {
		const el = form.querySelector<HTMLInputElement>(`input[name="${h.id}"]`);
		if (el && el.value !== '') data[h.id] = el.value;
	}
	try {
		// Never persist an empty answer set; that would clobber saved progress
		// during the initial render, before answers are restored.
		if (Object.keys(data).length === 0) {
			localStorage.removeItem(STORAGE_KEY);
			localStorage.removeItem(STEP_KEY);
			return;
		}
		localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
		localStorage.setItem(STEP_KEY, String(currentStep));
	} catch { /* storage unavailable */ }
}
function loadAnswers(): boolean {
	try {
		const raw = localStorage.getItem(STORAGE_KEY);
		if (!raw) return false;
		const data = JSON.parse(raw) as Record<string, string>;
		let any = false;
		for (const [name, value] of Object.entries(data)) {
			const number = form.querySelector<HTMLInputElement>(`input[type="number"][name="${name}"]`);
			if (number) { number.value = String(value); any = true; continue; }
			const inp = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`);
			if (inp) { inp.checked = true; any = true; syncAutoZero(name); }
		}
		return any;
	} catch { return false; }
}
function clearStorage() {
	try { localStorage.removeItem(STORAGE_KEY); localStorage.removeItem(STEP_KEY); } catch { /* */ }
}

/* ---------- auto-severity ---------- */
// When frequency is 0, the symptom is absent: set severity to 0 and dim it.
function syncAutoZero(changedName: string) {
	const m = /^s(\d+)_f$/.exec(changedName);
	if (!m) return;
	const n = m[1];
	const freq = getVal(`s${n}_f`);
	const sevGroup = document.querySelector(`.symptom[data-n="${n}"] .rating-group:last-child .segmented`);
	if (!sevGroup) return;
	if (freq === 0) {
		const zero = form.querySelector<HTMLInputElement>(`input[name="s${n}_s"][value="0"]`);
		if (zero) zero.checked = true;
		sevGroup.classList.add('auto-zero');
	} else {
		sevGroup.classList.remove('auto-zero');
	}
}

form.addEventListener('change', (e) => {
	const target = e.target as HTMLInputElement;
	if (target && target.name) syncAutoZero(target.name);
	saveAnswers();
});
form.addEventListener('input', (e) => {
	if ((e.target as HTMLInputElement).type === 'number') saveAnswers();
});

/* ---------- navigation ---------- */
function showStep(n: number) {
	currentStep = Math.max(0, Math.min(n, totalSteps - 1));
	steps.forEach(s => { s.hidden = parseInt(s.dataset.step || '0', 10) !== currentStep; });
	progressLabel.textContent = `Section ${currentStep + 1} of ${totalSteps}`;
	progressFill.style.width = `${((currentStep + 1) / totalSteps) * 100}%`;
	window.scrollTo({ top: (form.getBoundingClientRect().top + window.scrollY) - 20, behavior: 'smooth' });
	saveAnswers();
}

function flag(el: HTMLElement) {
	el.classList.add('missing');
	el.scrollIntoView({ behavior: 'smooth', block: 'center' });
	setTimeout(() => el.classList.remove('missing'), 2500);
}

function validateStep(n: number): boolean {
	const step = steps[n];
	for (const sym of step.querySelectorAll<HTMLElement>('.symptom[data-n]')) {
		const id = sym.dataset.n!;
		if (getVal(`s${id}_f`) === null || getVal(`s${id}_s`) === null) { flag(sym); return false; }
	}
	for (const q of step.querySelectorAll<HTMLElement>('.symptom.choice[data-q]')) {
		if (getVal(q.dataset.q!) === null) { flag(q); return false; }
	}
	const hours = step.querySelector<HTMLElement>('[data-hours]');
	if (hours && HOURS_QUESTIONS.some(h => getHours(h.id) === null)) { flag(hours); return false; }
	return true;
}

form.querySelectorAll('[data-next]').forEach(btn => btn.addEventListener('click', () => {
	if (validateStep(currentStep)) showStep(currentStep + 1);
}));
form.querySelectorAll('[data-prev]').forEach(btn => btn.addEventListener('click', () => showStep(currentStep - 1)));

/* ---------- results ---------- */
function listJoin(arr: string[]): string {
	if (arr.length <= 1) return arr.join('');
	if (arr.length === 2) return `${arr[0]} and ${arr[1]}`;
	return `${arr.slice(0, -1).join(', ')}, and ${arr[arr.length - 1]}`;
}

function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, text?: string) {
	const node = document.createElement(tag);
	node.className = cls;
	if (text !== undefined) node.textContent = text;
	return node;
}

function renderResults() {
	const answers = collectAnswers();
	const defs = scoreCaseDefinitions(answers);
	const domains = domainScores(answers);

	// Case definitions, each with its criteria.
	const casedefCards = document.getElementById('casedef-cards') as HTMLElement;
	casedefCards.replaceChildren(...defs.map(d => {
		const card = el('div', `casedef-card ${d.met ? 'met' : 'notmet'}`);
		const head = el('div', 'casedef-head');
		head.append(el('span', 'casedef-name', d.name), el('span', 'casedef-badge', d.met ? '✓ Met' : 'Not met'));
		const list = el('ul', 'casedef-criteria');
		for (const c of d.criteria) {
			const li = el('li', c.met ? 'yes' : 'no');
			li.append(el('span', 'crit-mark', c.met ? '✓' : '✗'), el('span', 'sr-only', c.met ? 'Met: ' : 'Not met: '), c.label);
			list.append(li);
		}
		card.append(head, list);
		return card;
	}));

	// Domain chart and cards.
	const chart = document.getElementById('chart') as HTMLElement;
	chart.replaceChildren(...domains.map(d => {
		const row = el('div', 'chart-row');
		const track = el('div', 'chart-track');
		const bar = el('div', 'chart-bar');
		bar.style.width = `${Math.max(2, Math.round(d.avg))}%`;
		track.append(bar);
		row.append(el('div', 'chart-label', d.name), track, el('div', 'chart-val', String(Math.round(d.avg))));
		return row;
	}));
	const domainCards = document.getElementById('domain-cards') as HTMLElement;
	domainCards.replaceChildren(...domains.map(d => {
		const card = el('div', 'domain-card');
		const head = el('div', 'domain-card-head');
		const score = el('span', 'domain-card-score', String(Math.round(d.avg)));
		score.append(el('small', '', '/100'));
		head.append(el('span', 'domain-card-name', d.name), score);
		card.append(head, el('div', 'domain-card-met', `${d.met} of ${d.total} symptoms at least half the time and at least moderate`));
		return card;
	}));

	// REVIEW: Layer 1 copy.
	const subscores: Record<string, number> = Object.fromEntries(domains.map(d => [d.key, Math.round(d.avg)]));
	for (const d of defs) subscores[d.key] = d.met ? 1 : 0;
	const met = defs.filter(d => d.met).map(d => d.name);
	const opening = met.length
		? `Your answers meet the ${listJoin(met)} ${met.length === 1 ? 'case definition' : 'case definitions'}.`
		: 'Your answers do not meet any of the four case definitions.';
	const domainsLine = interpretResult(dsq2, { total: null, subscores }, history.latest());
	(document.getElementById('overall-summary') as HTMLElement).textContent =
		`${opening} ${domainsLine} This is a screen of what you reported, not a diagnosis.`.replace(/\s+/g, ' ');

	history.record({ total: null, subscores, band: dsqOutcome({ subscores }) });
}

/* ---------- submit ---------- */
form.addEventListener('submit', (e) => {
	e.preventDefault();
	if (!validateStep(currentStep)) return;
	renderResults();
	form.hidden = true;
	document.querySelector('.progress-wrap')?.setAttribute('hidden', '');
	resultsPanel.hidden = false;
	resultsPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
});

document.getElementById('edit-btn')?.addEventListener('click', () => {
	resultsPanel.hidden = true;
	form.hidden = false;
	document.querySelector('.progress-wrap')?.removeAttribute('hidden');
	showStep(currentStep);
});

function restart() {
	form.reset();
	clearStorage();
	document.querySelectorAll('.segmented.auto-zero').forEach(s => s.classList.remove('auto-zero'));
	resultsPanel.hidden = true;
	form.hidden = false;
	document.querySelector('.progress-wrap')?.removeAttribute('hidden');
	showStep(0);
}
document.getElementById('restart-btn')?.addEventListener('click', restart);
document.getElementById('fresh-btn')?.addEventListener('click', () => { resumeBanner.hidden = true; restart(); });

/* ---------- init / resume ---------- */
(function init() {
	try { LEGACY_KEYS.forEach(k => localStorage.removeItem(k)); } catch { /* */ }
	let hasSaved = false;
	try {
		const raw = localStorage.getItem(STORAGE_KEY);
		hasSaved = !!raw && Object.keys(JSON.parse(raw)).length > 0;
	} catch { /* */ }

	if (hasSaved && loadAnswers()) {
		let savedStep = 0;
		try { savedStep = parseInt(localStorage.getItem(STEP_KEY) || '0', 10); } catch { /* */ }
		resumeBanner.hidden = false;
		showStep(savedStep);
	} else {
		showStep(0);
	}
})();
</script>

<style>
	.tool-header {
		padding-bottom: 1.5em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2em;
	}
	.tool-header h1 { margin: 0.3em 0 0.1em; }
	.subtitle { color: rgb(var(--gray)); font-size: 1.05em; margin: 0 0 0.75em; }
	.description { margin-bottom: 1em; }

	/* Resume banner */
	.resume-banner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		background: var(--accent-light);
		border: 1px solid var(--accent);
		border-radius: 6px;
		padding: 0.9em 1.25em;
		margin-bottom: 1.5em;
		font-size: 0.92em;
	}
	.resume-actions { display: flex; gap: 0.5em; }
	.resume-banner button {
		border: 1px solid var(--accent);
		background: #fff;
		color: var(--accent);
