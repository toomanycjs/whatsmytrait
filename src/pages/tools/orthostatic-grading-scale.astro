---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const ogImage = new URL(`/og${Astro.url.pathname.replace(/\/$/, '')}.png`, Astro.site).href;

const items = [
	{
		id: 'frequency',
		title: 'Frequency of orthostatic symptoms',
		options: [
			'I never or rarely experience orthostatic symptoms when I stand up',
			'I sometimes experience orthostatic symptoms when I stand up',
			'I often experience orthostatic symptoms when I stand up',
			'I usually experience orthostatic symptoms when I stand up',
			'I always experience orthostatic symptoms when I stand up',
		],
	},
	{
		id: 'severity',
		title: 'Severity of orthostatic symptoms',
		options: [
			'I do not experience orthostatic symptoms when I stand up',
			'I experience mild orthostatic symptoms when I stand up',
			'I experience moderate orthostatic symptoms when I stand up and sometimes have to sit back down for relief',
			'I experience severe orthostatic symptoms when I stand up and frequently have to sit back down for relief',
			'I experience severe orthostatic symptoms when I stand up and regularly faint if I do not sit back down',
		],
	},
	{
		id: 'conditions',
		title: 'Conditions under which orthostatic symptoms occur',
		options: [
			'I never or rarely experience orthostatic symptoms under any circumstances',
			'I sometimes experience orthostatic symptoms under certain conditions, such as prolonged standing, a meal, exertion (e.g. walking), or when exposed to heat (e.g. a hot day, hot bath, or hot shower)',
			'I often experience orthostatic symptoms under certain conditions, such as prolonged standing, a meal, exertion (e.g. walking), or when exposed to heat (e.g. a hot day, hot bath, or hot shower)',
			'I usually experience orthostatic symptoms under certain conditions, such as prolonged standing, a meal, exertion (e.g. walking), or when exposed to heat (e.g. a hot day, hot bath, or hot shower)',
			'I always experience orthostatic symptoms when I stand up; the specific conditions do not matter',
		],
	},
	{
		id: 'adl',
		title: 'Activities of daily living',
		options: [
			'My orthostatic symptoms do not interfere with activities of daily living (e.g. work, chores, dressing, bathing)',
			'My orthostatic symptoms mildly interfere with activities of daily living',
			'My orthostatic symptoms moderately interfere with activities of daily living',
			'My orthostatic symptoms severely interfere with activities of daily living',
			'My orthostatic symptoms severely interfere with activities of daily living; I am bedridden or wheelchair-bound because of my symptoms',
		],
	},
	{
		id: 'standing',
		title: 'Standing time',
		options: [
			'On most occasions, I can stand as long as necessary without experiencing orthostatic symptoms',
			'On most occasions, I can stand more than 15 minutes before experiencing orthostatic symptoms',
			'On most occasions, I can stand 5–14 minutes before experiencing orthostatic symptoms',
			'On most occasions, I can stand 1–4 minutes before experiencing orthostatic symptoms',
			'On most occasions, I can stand less than 1 minute before experiencing orthostatic symptoms',
		],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Orthostatic Grading Scale (OGS): free online orthostatic intolerance questionnaire"
			description="Complete the five-item Orthostatic Grading Scale from the Mayo Clinic and get your score out of 20 instantly, with the mild, moderate, and severe bands and reference values from POTS, ME/CFS, and long COVID studies. Free, quick, no sign-up."
			ogImage={ogImage}
		/>
		<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.postviralrecovery.com/"},
        {"@type": "ListItem", "position": 2, "name": "Tools", "item": "https://www.postviralrecovery.com/tools/"},
        {"@type": "ListItem", "position": 3, "name": "Orthostatic Grading Scale", "item": "https://www.postviralrecovery.com/tools/orthostatic-grading-scale/"}
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the Orthostatic Grading Scale?",
          "acceptedAnswer": {"@type": "Answer", "text": "The Orthostatic Grading Scale (OGS) is a five-item self-report questionnaire developed at the Mayo Clinic and published in 2005. It grades the frequency and severity of orthostatic symptoms, the conditions that bring them on, their interference with daily activities, and how long you can stand before symptoms start. Each item scores 0 to 4, giving a total from 0 to 20."}
        },
        {
          "@type": "Question",
          "name": "What is a high Orthostatic Grading Scale score?",
          "acceptedAnswer": {"@type": "Answer", "text": "Published bands are mild (below 4), moderate (4 to 9), and severe (above 9). In the original Mayo study a score of 9 or more best matched laboratory evidence of adrenergic autonomic failure. Healthy controls typically score 0 to 3; UK POTS patients have averaged about 13, ME/CFS cohorts 8 to 13, and hypermobile EDS patients about 10."}
        },
        {
          "@type": "Question",
          "name": "Does the Orthostatic Grading Scale diagnose POTS?",
          "acceptedAnswer": {"@type": "Answer", "text": "No. It measures the burden of orthostatic symptoms, whatever their cause. POTS and orthostatic hypotension are diagnosed from heart rate and blood pressure responses to standing or tilt. A high OGS score is a reason to ask for that testing, and the scale is useful for tracking symptoms over time."}
        }
      ]
    }
  ]
}
		</script>
	</head>
	<body>
		<Header />
		<main id="main">
			<div class="tool-header">
				<a href="/tools" class="section-label tools">Tools</a>
				<h1>Orthostatic Grading Scale (OGS)</h1>
				<p class="subtitle">Five questions grading how much standing up costs you, scored 0–20</p>
				<p class="description">
					The Orthostatic Grading Scale was developed at the Mayo Clinic's autonomic laboratory by Schrezenmaier, Low, Sandroni and colleagues and published in 2005. It was designed to put a number on orthostatic intolerance in the way a clinician would take a history: how <strong>often</strong> symptoms happen on standing, how <strong>severe</strong> they are, what <strong>conditions</strong> bring them on, how much they interfere with <strong>daily activities</strong>, and how long you can <strong>stand</strong> before they start. Each of the five items scores 0–4, for a total of 0–20.
				</p>
				<p class="description">
					In the original study of 145 patients the scale was internally consistent (alpha 0.91) and tracked laboratory measures of adrenergic autonomic function. It has since been used in UK POTS research, ME/CFS studies, the CDC's multi-site ME/CFS study, and post-COVID cohorts. "Orthostatic symptoms" here means the symptoms you get on standing: lightheadedness, dizziness, blurred vision, weakness, fatigue, brain fog, palpitations, nausea, or feeling faint.
				</p>
				<p class="description">
					The OGS describes your usual pattern, which makes it a good baseline and monthly tracking measure. The <a href="/tools/vanderbilt-orthostatic-symptom-score/">Vanderbilt Orthostatic Symptom Score</a> is the complementary snapshot rated while standing, the <a href="/tools/malmo-pots-score/">Malmö POTS score</a> covers the past week, and the <a href="/tools/nasa-lean-test/">NASA lean test</a> records the heart-rate data that a POTS or orthostatic hypotension diagnosis actually needs.
				</p>
				<div class="disclaimer">
					<strong>This is not a diagnostic tool.</strong> The scale measures the burden of orthostatic symptoms regardless of cause. It cannot distinguish POTS from orthostatic hypotension, deconditioning, medication effects, or other conditions. Discuss your results with your doctor. Based on: Schrezenmaier C, Gehrking JA, Hines SM, Low PA, Benrud-Larson LM, Sandroni P. <em>Evaluation of orthostatic hypotension: relationship of a new self-report instrument to laboratory-based measures.</em> Mayo Clin Proc. 2005;80(3):330–334. The scale is the work of its authors at the Mayo Clinic; this page is an interactive scoring aid for personal, non-commercial use.
				</div>
			</div>

			<form id="ogs-form" novalidate>
				<p class="form-instructions">For each of the five areas, choose the <strong>one</strong> statement that best describes your usual experience.</p>
				{items.map((item, i) => (
					<div class="symptom" data-id={item.id}>
						<p class="symptom-text"><span class="num">{i + 1}.</span> {item.title}</p>
						<div class="radio-options">
							{item.options.map((opt, v) => (
								<label class="radio-label"><input type="radio" name={item.id} value={v} /><span><span class="pts">{v}</span> {opt}</span></label>
							))}
						</div>
					</div>
				))}
				<div class="form-footer">
					<button type="submit">Calculate my score</button>
					<button type="button" id="reset-btn">Clear all</button>
				</div>
			</form>

			<div id="results" class="results" hidden>
				<h2>Your Orthostatic Grading Scale score</h2>
				<div class="total-score">
					<span id="total-score-value">—</span>
					<span class="total-score-label">out of 20</span>
				</div>
				<p id="score-interpretation" class="score-interp"></p>

				<h3>Item breakdown</h3>
				<div id="chart" class="chart"></div>

				<h3>Reference values</h3>
				<div id="refchart" class="chart"></div>

				<div class="results-disclaimer">
					<h3>Understanding your score</h3>
					<p>The bands most often quoted are <strong>mild (below 4)</strong>, <strong>moderate (4–9)</strong>, and <strong>severe (above 9)</strong>, from Frith and Newton's work on orthostatic symptoms. In the original Mayo data a score of 9 or more was the best match for laboratory evidence of adrenergic failure, with modest accuracy (66% sensitivity, 69% specificity), which is a reminder that symptom burden and measured autonomic function only partly overlap.</p>
					<p>Published averages: healthy controls 0.6–3; UK POTS patients about 13 (SD 4); ME/CFS cohorts 8–13; hypermobile EDS about 10; post-COVID condition about 11. A 2023 UK study of people referred with suspected POTS found the five items behave as a single dimension and correlate with heart-rate responses on standing.</p>
					<p>Because the OGS asks about your usual pattern rather than a single week, it changes slowly. Repeating it monthly, or before and after a treatment change, is enough. Record it with your <a href="/tools/trackers/stand-test-logger/">stand test results</a> so the symptom score and the heart-rate response sit together.</p>
					<p><strong>This is not a diagnosis.</strong> Discuss your results with your doctor or specialist.</p>
				</div>

				<button type="button" id="back-btn" class="back-btn">Edit answers</button>
			</div>
		</main>
		<Footer />
	</body>
</html>

<script>
const ITEMS = [
	{ id: 'frequency', text: 'Frequency' },
	{ id: 'severity', text: 'Severity' },
	{ id: 'conditions', text: 'Conditions' },
	{ id: 'adl', text: 'Daily activities' },
	{ id: 'standing', text: 'Standing time' },
];

const form = document.getElementById('ogs-form') as HTMLFormElement;
const results = document.getElementById('results') as HTMLElement;

function getVal(id: string): number | null {
	const checked = form.querySelector<HTMLInputElement>(`input[name="${id}"]:checked`);
	return checked ? parseInt(checked.value, 10) : null;
}

form.addEventListener('submit', (e) => {
	e.preventDefault();
	for (const item of ITEMS) {
		if (getVal(item.id) === null) {
			const el = form.querySelector<HTMLElement>(`.symptom[data-id="${item.id}"]`);
			el?.classList.add('missing');
			el?.scrollIntoView({ behavior: 'smooth', block: 'center' });
			setTimeout(() => el?.classList.remove('missing'), 2500);
			return;
		}
	}
	const values = ITEMS.map(it => ({ item: it, val: getVal(it.id)! }));
	const total = values.reduce((s, v) => s + v.val, 0);
	(document.getElementById('total-score-value') as HTMLElement).textContent = String(total);

	let interp = `Your OGS score is ${total} out of 20. `;
	if (total > 9) {
		interp += 'This is in the severe band (above 9). It is at or above the level that best matched laboratory evidence of adrenergic autonomic failure in the original study, and in the range reported by UK POTS patients (about 13) and ME/CFS cohorts. If you have not had orthostatic testing, a standing test or NASA lean test is a sensible next step, and this score is worth showing to your GP.';
	} else if (total >= 4) {
		interp += 'This is in the moderate band (4–9). Orthostatic symptoms are a regular feature and interfere with life to some degree; healthy controls typically score 0–3. Tracking the score alongside stand-test heart-rate data will show whether it is changing.';
	} else {
		interp += 'This is in the mild band (below 4), the range typically reported by healthy controls. Orthostatic symptoms are infrequent or minor by this measure. If you still have standing-related symptoms that the five items did not capture, the Vanderbilt score rated while standing may show them.';
	}
	(document.getElementById('score-interpretation') as HTMLElement).textContent = interp;

	(document.getElementById('chart') as HTMLElement).innerHTML = values.map(v => `
		<div class="chart-row">
			<div class="chart-label">${v.item.text}</div>
			<div class="chart-track"><div class="chart-bar" style="width:${Math.max(2, v.val * 25)}%"></div></div>
			<div class="chart-val">${v.val}</div>
		</div>`).join('');

	const refs = [
		{ label: 'Healthy controls', val: 2 },
		{ label: 'ME/CFS (Issa 2025)', val: 8.3 },
		{ label: 'hEDS (Peebles 2022)', val: 10.4 },
		{ label: 'UK POTS (McDonald 2014)', val: 13 },
		{ label: 'Your score', val: total, you: true },
	].sort((a, b) => a.val - b.val);
	(document.getElementById('refchart') as HTMLElement).innerHTML = refs.map(r => `
		<div class="chart-row${r.you ? ' you' : ''}">
			<div class="chart-label">${r.label}</div>
			<div class="chart-track"><div class="chart-bar" style="width:${Math.max(2, Math.round((r.val / 20) * 100))}%"></div></div>
			<div class="chart-val">${r.val}</div>
		</div>`).join('');

	form.hidden = true;
	results.hidden = false;
	results.scrollIntoView({ behavior: 'smooth', block: 'start' });
});

document.getElementById('reset-btn')?.addEventListener('click', () => form.reset());
document.getElementById('back-btn')?.addEventListener('click', () => {
	results.hidden = true;
	form.hidden = false;
	form.scrollIntoView({ behavior: 'smooth', block: 'start' });
});
</script>

<style>
	.tool-header { padding-bottom: 1.5em; border-bottom: 1px solid rgb(var(--gray-light)); margin-bottom: 2em; }
	.tool-header h1 { margin: 0.3em 0 0.1em; }
	.subtitle { color: rgb(var(--gray)); font-size: 1.05em; margin: 0 0 0.75em; }
	.description { margin-bottom: 1em; }

	.form-instructions { font-size: 0.88em; color: rgb(var(--gray-dark)); background: var(--accent-light); border-radius: 6px; padding: 0.7em 1.1em; margin-bottom: 1.25em; }

	.symptom { border: 1px solid rgb(var(--gray-light)); border-radius: 8px; padding: 0.9em 1.2em; margin-bottom: 0.65em; transition: border-color 0.15s, box-shadow 0.15s; }
	.symptom.missing { border-color: #c0392b; box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.12); }
	.symptom-text { margin: 0 0 0.7em; font-weight: 700; font-size: 0.95em; line-height: 1.4; }
	.num { color: rgb(var(--gray)); margin-right: 0.3em; }

	.radio-options { display: flex; flex-direction: column; gap: 0.4em; }
	.radio-label { display: flex; align-items: flex-start; gap: 0.6em; padding: 0.55em 0.8em; border: 1px solid rgb(var(--gray-light)); border-radius: 6px; cursor: pointer; font-size: 0.9em; line-height: 1.4; }
	.radio-label:hover { border-color: var(--accent); }
	.radio-label:has(input:checked) { background: var(--accent-light); border-color: var(--accent); }
	.radio-label input { margin-top: 0.25em; flex-shrink: 0; }
	.pts { display: inline-block; min-width: 1.4em; font-weight: 700; color: var(--accent); }

	.form-footer { display: flex; gap: 1em; padding: 1.5em 0 1em; }
	button[type="submit"] { background: var(--accent); color: #fff; border: none; padding: 0.75em 2em; border-radius: 5px; font-size: 1em; font-weight: 700; cursor: pointer; font-family: inherit; }
	button[type="submit"]:hover { background: var(--accent-dark); }
	button[type="button"] { background: none; border: 1px solid rgb(var(--gray-light)); padding: 0.75em 1.5em; border-radius: 5px; font-size: 0.95em; cursor: pointer; color: rgb(var(--gray)); font-family: inherit; }

	.results { padding-top: 1em; }
	.results h2 { margin-bottom: 0.5em; }
	.results h3 { margin-top: 1.75em; margin-bottom: 0.4em; }
	.total-score { display: flex; align-items: baseline; gap: 0.5em; margin: 1em 0; }
	#total-score-value { font-size: 3.5em; font-weight: 700; color: var(--accent); line-height: 1; }
	.total-score-label { color: rgb(var(--gray)); font-size: 1.1em; }
	.score-interp { font-size: 1em; line-height: 1.6; margin: 0 0 1em; padding: 1em 1.25em; background: var(--accent-light); border-left: 4px solid var(--accent); border-radius: 4px; }

	.chart { display: flex; flex-direction: column; gap: 0.5em; margin: 1em 0; }
	.chart :global(.chart-row) { display: grid; grid-template-columns: 12em 1fr 2.5em; align-items: center; gap: 0.75em; font-size: 0.88em; }
	.chart :global(.chart-label) { text-align: right; color: rgb(var(--gray-dark)); line-height: 1.25; }
	.chart :global(.chart-track) { background: rgb(var(--gray-light)); border-radius: 4px; height: 1.5em; overflow: hidden; }
	.chart :global(.chart-bar) { height: 100%; background: var(--accent); border-radius: 4px; min-width: 2px; transition: width 0.4s ease; }
	.chart :global(.chart-val) { font-weight: 700; color: var(--accent); text-align: right; }
	#refchart :global(.chart-bar) { background: rgb(var(--gray)); }
	#refchart :global(.chart-val) { color: rgb(var(--gray-dark)); }
	#refchart :global(.chart-row.you .chart-bar) { background: var(--accent); }
	#refchart :global(.chart-row.you .chart-label) { font-weight: 700; color: var(--accent-dark); }
	#refchart :global(.chart-row.you .chart-val) { color: var(--accent); }

	.results-disclaimer { font-size: 0.88em; color: rgb(var(--gray-dark)); border-top: 1px solid rgb(var(--gray-light)); padding-top: 1.5em; margin-top: 2em; line-height: 1.6; }
	.results-disclaimer h3 { font-size: 1em; color: rgb(var(--black)); margin-top: 0; margin-bottom: 0.5em; }
	.results-disclaimer a { color: var(--accent); }
	.back-btn { background: none; border: 1px solid rgb(var(--gray-light)); padding: 0.6em 1.25em; border-radius: 5px; font-size: 0.95em; cursor: pointer; color: rgb(var(--gray)); font-family: inherit; margin-top: 1.5em; }
	.back-btn:hover { border-color: var(--accent); color: var(--accent); }

	@media (max-width: 600px) {
		.symptom { padding: 0.8em 0.9em; }
		.chart :global(.chart-row) { grid-template-columns: 8em 1fr 2em; gap: 0.5em; font-size: 0.8em; }
	}
</style>
