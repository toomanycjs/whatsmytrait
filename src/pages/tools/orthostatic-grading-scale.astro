---
import Page from '../../layouts/Page.astro';
import ScoreHistory from '../../components/ScoreHistory.astro';
import SharedResults from '../../components/SharedResults.astro';
import OgsInterpretation from '../../components/interpretation/OrthostaticGradingScale.astro';
import { FAQ, FAQ_ORDER } from '../../tools/orthostatic-grading-scale.content';
import { toolJsonLd } from '../../tools/jsonld';

const jsonLd = toolJsonLd('Orthostatic Grading Scale', '/tools/orthostatic-grading-scale/', FAQ_ORDER.map(k => FAQ[k]));

const items = [
	{
		id: 'frequency',
		title: 'Frequency of orthostatic symptoms',
		options: [
			'I never or rarely experience orthostatic symptoms when I stand up',
			'I sometimes experience orthostatic symptoms when I stand up',
			'I often experience orthostatic symptoms when I stand up',
			'I usually experience orthostatic symptoms when I stand up',
			'I always experience orthostatic symptoms when I stand up',
		],
	},
	{
		id: 'severity',
		title: 'Severity of orthostatic symptoms',
		options: [
			'I do not experience orthostatic symptoms when I stand up',
			'I experience mild orthostatic symptoms when I stand up',
			'I experience moderate orthostatic symptoms when I stand up and sometimes have to sit back down for relief',
			'I experience severe orthostatic symptoms when I stand up and frequently have to sit back down for relief',
			'I experience severe orthostatic symptoms when I stand up and regularly faint if I do not sit back down',
		],
	},
	{
		id: 'conditions',
		title: 'Conditions under which orthostatic symptoms occur',
		options: [
			'I never or rarely experience orthostatic symptoms under any circumstances',
			'I sometimes experience orthostatic symptoms under certain conditions, such as prolonged standing, a meal, exertion (e.g. walking), or when exposed to heat (e.g. a hot day, hot bath, or hot shower)',
			'I often experience orthostatic symptoms under certain conditions, such as prolonged standing, a meal, exertion (e.g. walking), or when exposed to heat (e.g. a hot day, hot bath, or hot shower)',
			'I usually experience orthostatic symptoms under certain conditions, such as prolonged standing, a meal, exertion (e.g. walking), or when exposed to heat (e.g. a hot day, hot bath, or hot shower)',
			'I always experience orthostatic symptoms when I stand up; the specific conditions do not matter',
		],
	},
	{
		id: 'adl',
		title: 'Activities of daily living',
		options: [
			'My orthostatic symptoms do not interfere with activities of daily living (e.g. work, chores, dressing, bathing)',
			'My orthostatic symptoms mildly interfere with activities of daily living',
			'My orthostatic symptoms moderately interfere with activities of daily living',
			'My orthostatic symptoms severely interfere with activities of daily living',
			'My orthostatic symptoms severely interfere with activities of daily living; I am bedridden or wheelchair-bound because of my symptoms',
		],
	},
	{
		id: 'standing',
		title: 'Standing time',
		options: [
			'On most occasions, I can stand as long as necessary without experiencing orthostatic symptoms',
			'On most occasions, I can stand more than 15 minutes before experiencing orthostatic symptoms',
			'On most occasions, I can stand 5–14 minutes before experiencing orthostatic symptoms',
			'On most occasions, I can stand 1–4 minutes before experiencing orthostatic symptoms',
			'On most occasions, I can stand less than 1 minute before experiencing orthostatic symptoms',
		],
	},
];
---

<Page
	title="Orthostatic Grading Scale (OGS): free online orthostatic intolerance questionnaire"
	description="Complete the five-item Orthostatic Grading Scale from the Mayo Clinic and get your score out of 20 instantly, with the published thresholds and reference values from POTS, ME/CFS, long COVID and hypermobility studies. Free, quick, no sign-up."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</Fragment>
			<div class="tool-header">
				<a href="/tools/" class="section-label tools">Tools</a>
				<h1>Orthostatic Grading Scale (OGS)</h1>
				<p class="subtitle">Five questions grading how much standing up costs you, scored 0–20</p>
				<p class="description">
					The Orthostatic Grading Scale was developed at the Mayo Clinic's autonomic laboratory by Schrezenmaier, Low, Sandroni and colleagues and published in 2005. It was designed to put a number on orthostatic intolerance in the way a clinician would take a history: how <strong>often</strong> symptoms happen on standing, how <strong>severe</strong> they are, what <strong>conditions</strong> bring them on, how much they interfere with <strong>daily activities</strong>, and how long you can <strong>stand</strong> before they start. Each of the five items scores 0–4, for a total of 0–20.
				</p>
				<p class="description">
					In the original study of 145 patients the scale was internally consistent (alpha 0.91) and tracked laboratory measures of adrenergic autonomic function. It has since been used in UK POTS research, ME/CFS studies, the CDC's multi-site ME/CFS study, and post-COVID cohorts. "Orthostatic symptoms" here means the symptoms you get on standing: lightheadedness, dizziness, blurred vision, weakness, fatigue, brain fog, palpitations, nausea, or feeling faint.
				</p>
				<p class="description">
					The OGS describes your usual pattern, which makes it a good baseline and monthly tracking measure. The <a href="/tools/vanderbilt-orthostatic-symptom-score/">Vanderbilt Orthostatic Symptom Score</a> is the complementary snapshot rated while standing, the <a href="/tools/malmo-pots-score/">Malmö POTS score</a> covers the past week, and the <a href="/tools/nasa-lean-test/">NASA lean test</a> records the heart-rate data that a POTS or orthostatic hypotension diagnosis actually needs. For how to use them together to check for POTS at home, see <a href="/testing/do-i-have-pots/">Do I have POTS?</a>
				</p>
			</div>

			<form id="ogs-form" novalidate>
				<p class="form-instructions">For each of the five areas, choose the <strong>one</strong> statement that best describes your usual experience.</p>
				{items.map((item, i) => (
					<div class="symptom" data-id={item.id}>
						<p class="symptom-text"><span class="num">{i + 1}.</span> {item.title}</p>
						<div class="radio-options">
							{item.options.map((opt, v) => (
								<label class="radio-label"><input type="radio" name={item.id} value={v} /><span><span class="pts">{v}</span> {opt}</span></label>
							))}
						</div>
					</div>
				))}
				<div class="form-footer">
					<button type="submit">Calculate my score</button>
					<button type="button" id="reset-btn">Clear all</button>
				</div>
			</form>

			<div id="results" class="results" hidden>
				<h2>Your Orthostatic Grading Scale score</h2>
				<div class="total-score">
					<span id="total-score-value">—</span>
					<span class="total-score-label">out of 20</span>
				</div>
				<p id="score-interpretation" class="score-interp"></p>

				<h3>Item breakdown</h3>
				<div id="chart" class="chart"></div>

				<h3>Reference values</h3>
				<p class="section-lead">Average totals in published studies; sources are listed under "Understanding your OGS score" below.</p>
				<div id="refchart" class="chart"></div>

				<ScoreHistory toolId="orthostatic-grading-scale" toolName="Orthostatic Grading Scale" />

				<button type="button" id="back-btn" class="back-btn">Edit answers</button>
			</div>

			<SharedResults toolId="orthostatic-grading-scale" />

			<OgsInterpretation>
				<div class="disclaimer" slot="disclaimer"><strong>This is not a diagnostic tool.</strong> The scale measures the burden of orthostatic symptoms regardless of cause. It cannot distinguish POTS from orthostatic hypotension, deconditioning, medication effects, or other conditions. Discuss your results with your doctor.</div>
				<p class="citation" slot="citation">Based on: Schrezenmaier C, Gehrking JA, Hines SM, Low PA, Benrud-Larson LM, Sandroni P. <em>Evaluation of orthostatic hypotension: relationship of a new self-report instrument to laboratory-based measures.</em> Mayo Clin Proc. 2005;80(3):330–334. The scale is the work of its authors at the Mayo Clinic; this page is an interactive scoring aid for personal, non-commercial use.</p>
			</OgsInterpretation>
</Page>

<script>
import { orthostaticGradingScale } from '../../tools/orthostatic-grading-scale';
import { REFERENCE } from '../../tools/orthostatic-grading-scale.content';
import { interpretResult } from '../../scripts/results/interpretation';
import { mountScoreHistory, mountSharedResults } from '../../scripts/results/scoreHistory';

const ITEMS = [
	{ id: 'frequency', text: 'Frequency' },
	{ id: 'severity', text: 'Severity' },
	{ id: 'conditions', text: 'Conditions' },
	{ id: 'adl', text: 'Daily activities' },
	{ id: 'standing', text: 'Standing time' },
];

const form = document.getElementById('ogs-form') as HTMLFormElement;
const results = document.getElementById('results') as HTMLElement;

const history = mountScoreHistory(orthostaticGradingScale);
mountSharedResults(orthostaticGradingScale);

function getVal(id: string): number | null {
	const checked = form.querySelector<HTMLInputElement>(`input[name="${id}"]:checked`);
	return checked ? parseInt(checked.value, 10) : null;
}

form.addEventListener('submit', (e) => {
	e.preventDefault();
	for (const item of ITEMS) {
		if (getVal(item.id) === null) {
			const el = form.querySelector<HTMLElement>(`.symptom[data-id="${item.id}"]`);
			el?.classList.add('missing');
			el?.scrollIntoView({ behavior: 'smooth', block: 'center' });
			setTimeout(() => el?.classList.remove('missing'), 2500);
			return;
		}
	}
	const values = ITEMS.map(it => ({ item: it, val: getVal(it.id)! }));
	const total = values.reduce((s, v) => s + v.val, 0);
	(document.getElementById('total-score-value') as HTMLElement).textContent = String(total);

	// REVIEW: Layer 1 copy. interpretResult adds the band sentence (thresholds
	// 4 and 9, Słomko et al. 2020 citing Schrezenmaier et al. 2005); no MIC is
	// published and topDomains is 0.
	const subscores = Object.fromEntries(values.map(v => [v.item.id, v.val]));
	const opening = `Your OGS score is ${total} out of 20.`;
	const context = 'For comparison, published averages are 0.6 in healthy controls, 8.3 in ME/CFS and 13 in POTS; the score measures symptoms, not their cause.';
	const interp = [opening, interpretResult(orthostaticGradingScale, { total, subscores }, history.latest()), context].filter(Boolean).join(' ');
	(document.getElementById('score-interpretation') as HTMLElement).textContent = interp;

	(document.getElementById('chart') as HTMLElement).innerHTML = values.map(v => `
		<div class="chart-row">
			<div class="chart-label">${v.item.text}</div>
			<div class="chart-track"><div class="chart-bar" style="width:${Math.max(2, v.val * 25)}%"></div></div>
			<div class="chart-val">${v.val}</div>
		</div>`).join('');

	// Published averages (see orthostatic-grading-scale.content.ts for sources).
	const refs: { label: string; val: number; you?: boolean }[] = [
		...REFERENCE.map(r => ({ label: r.group, val: Number(r.mean) })),
		{ label: 'Your score', val: total, you: true },
	].sort((a, b) => a.val - b.val);
	(document.getElementById('refchart') as HTMLElement).innerHTML = refs.map(r => `
		<div class="chart-row${r.you ? ' you' : ''}">
			<div class="chart-label">${r.label}</div>
			<div class="chart-track"><div class="chart-bar" style="width:${Math.max(2, Math.round((r.val / 20) * 100))}%"></div></div>
			<div class="chart-val">${r.val}</div>
		</div>`).join('');

	form.hidden = true;
	results.hidden = false;
	history.record({ total, subscores });
	results.scrollIntoView({ behavior: 'smooth', block: 'start' });
});

document.getElementById('reset-btn')?.addEventListener('click', () => form.reset());
document.getElementById('back-btn')?.addEventListener('click', () => {
	results.hidden = true;
	form.hidden = false;
	form.scrollIntoView({ behavior: 'smooth', block: 'start' });
});
</script>

<style>
	.tool-header { padding-bottom: 1.5em; border-bottom: 1px solid rgb(var(--gray-light)); margin-bottom: 2em; }
	.tool-header h1 { margin: 0.3em 0 0.1em; }
	.subtitle { color: rgb(var(--gray)); font-size: 1.05em; margin: 0 0 0.75em; }
	.description { margin-bottom: 1em; }

	.form-instructions { font-size: 0.88em; color: rgb(var(--gray-dark)); border-radius: 3px; padding: 0.7em 1.1em; margin-bottom: 1.25em;
		border: 1px solid rgb(var(--gray-light));
	}

	.symptom { border-top: 1px solid rgb(var(--gray-light)); padding: 0.9em 0; margin-bottom: 0.65em; transition: border-color 0.15s, box-shadow 0.15s; }
	.symptom.missing { border-color: #c0392b; box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.12); }
	.symptom-text { margin: 0 0 0.7em; font-weight: 700; font-size: 0.95em; line-height: 1.4; }
	.num { color: rgb(var(--gray)); margin-right: 0.3em; }

	.radio-options { display: flex; flex-direction: column; gap: 0.4em; }
	.radio-label { display: flex; align-items: flex-start; gap: 0.6em; padding: 0.6em 0.8em; border: 1px solid rgb(var(--gray-light)); border-radius: 3px; cursor: pointer; font-size: 0.9em; line-height: 1.4; position: relative; }
	.radio-label:hover { border-color: var(--accent); }
	.radio-label:has(input:checked) { background: var(--accent); border-color: var(--accent); color: #fff; }
	.radio-label:has(input:checked) :is(strong, .pts, .muted, small) { color: #fff; }
	.radio-label input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
	.pts { display: inline-block; min-width: 1.4em; font-weight: 700; color: var(--accent); }

	.form-footer { display: flex; gap: 1em; padding: 1.5em 0 1em; }
	button[type="submit"] { background: var(--accent); color: #fff; border: none; padding: 0.75em 2em; border-radius: 3px; font-size: 1em; font-weight: 700; cursor: pointer; font-family: inherit; }
	button[type="submit"]:hover { background: var(--accent-dark); }
	button[type="button"] { background: none; border: 1px solid rgb(var(--gray-light)); padding: 0.75em 1.5em; border-radius: 3px; font-size: 0.95em; cursor: pointer; color: rgb(var(--gray)); font-family: inherit; }

	.results { padding-top: 1em; }
	.results h2 { margin-bottom: 0.5em; }
	.results h3 { margin-top: 1.75em; margin-bottom: 0.4em; }
	.total-score { display: flex; align-items: baseline; gap: 0.5em; margin: 1em 0; }
	#total-score-value { font-family: var(--font-serif); font-size: 3.2em; font-weight: 600; color: rgb(var(--black)); line-height: 1; font-variant-numeric: tabular-nums; }
	.total-score-label { color: rgb(var(--gray)); font-size: 1.1em; }
	.score-interp { font-size: 1em; line-height: 1.6; margin: 0 0 1em; padding: 0; }

	.chart { display: flex; flex-direction: column; gap: 0.5em; margin: 1em 0; }
	.chart :global(.chart-row) { display: grid; grid-template-columns: 12em 1fr 2.5em; align-items: center; gap: 0.75em; font-size: 0.88em; }
	.chart :global(.chart-label) { text-align: right; color: rgb(var(--gray-dark)); line-height: 1.25; }
	.chart :global(.chart-track) { background: rgb(var(--gray-light)); border-radius: 3px; height: 1.5em; overflow: hidden; }
	.chart :global(.chart-bar) { height: 100%; background: var(--accent); border-radius: 3px; min-width: 2px; transition: width 0.4s ease; }
	.chart :global(.chart-val) { font-weight: 700; color: var(--accent); text-align: right; }
	#refchart :global(.chart-bar) { background: rgb(var(--gray)); }
	#refchart :global(.chart-val) { color: rgb(var(--gray-dark)); }
	#refchart :global(.chart-row.you .chart-bar) { background: var(--accent); }
	#refchart :global(.chart-row.you .chart-label) { font-weight: 700; color: var(--accent-dark); }
	#refchart :global(.chart-row.you .chart-val) { color: var(--accent); }

	.section-lead { font-size: 0.9em; color: rgb(var(--gray)); margin: 0 0 1em; }
	.back-btn { background: none; border: 1px solid rgb(var(--gray-light)); padding: 0.6em 1.25em; border-radius: 3px; font-size: 0.95em; cursor: pointer; color: rgb(var(--gray)); font-family: inherit; margin-top: 1.5em; }
	.back-btn:hover { border-color: var(--accent); color: var(--accent); }

	@media (max-width: 600px) {
		.symptom { padding: 0.8em 0; }
		.chart :global(.chart-row) { grid-template-columns: 8em 1fr 2em; gap: 0.5em; font-size: 0.8em; }
	}
</style>
