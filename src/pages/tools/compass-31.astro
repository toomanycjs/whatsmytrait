<script>
// Domain configuration
// Weights produce a max total of 100
const DOMAINS: {
	key: string;
	name: string;
	questions: string[];
	weight: number; // max contribution to total score
}[] = [
	{
		key: 'orthostatic',
		name: 'Orthostatic intolerance',
		questions: ['q1', 'q2', 'q3', 'q4'],
		weight: 40,
	},
	{
		key: 'vasomotor',
		name: 'Vasomotor',
		questions: ['q5', 'q6', 'q7'],
		weight: 5,
	},
	{
		key: 'secretomotor',
		name: 'Secretomotor',
		questions: ['q8', 'q9', 'q10', 'q11'],
		weight: 15,
	},
	{
		key: 'gi',
		name: 'Gastrointestinal',
		questions: ['q12', 'q13', 'q14', 'q15', 'q16', 'q17', 'q18', 'q19', 'q20', 'q21', 'q22', 'q23'],
		weight: 25,
	},
	{
		key: 'bladder',
		name: 'Bladder',
		questions: ['q24', 'q25', 'q26'],
		weight: 5,
	},
	{
		key: 'pupillomotor',
		name: 'Pupillomotor',
		questions: ['q27', 'q28', 'q29', 'q30', 'q31'],
		weight: 10,
	},
];

function getMaxForQuestion(name: string): number {
	const inputs = document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`);
	let max = 0;
	inputs.forEach(inp => {
		const val = parseFloat(inp.value);
		if (!isNaN(val) && val > max) max = val;
	});
	return max;
}

function getAnsweredValue(name: string): number | null {
	const checked = document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
	return checked ? parseFloat(checked.value) : null;
}

function computeScore(): { domainScores: { name: string; score: number; max: number; raw: number; rawMax: number }[]; total: number } | null {
	const domainScores = [];
	let total = 0;

	for (const domain of DOMAINS) {
		let rawScore = 0;
		let rawMax = 0;

		for (const q of domain.questions) {
			const val = getAnsweredValue(q);
			if (val === null) return null; // unanswered
			rawScore += val;
			rawMax += getMaxForQuestion(q);
		}

		const domainScore = rawMax > 0 ? (rawScore / rawMax) * domain.weight : 0;
		domainScores.push({
			name: domain.name,
			score: domainScore,
			max: domain.weight,
			raw: rawScore,
			rawMax,
		});
		total += domainScore;
	}

	return { domainScores, total };
}

function interpret(score: number): string {
	if (score < 5) return `Your score of ${score} is in the range typically seen in people without significant autonomic symptoms in the validation study.`;
	if (score < 16) return `Your score of ${score} is mildly elevated above the range seen in healthy controls in the validation study. Discuss any symptoms with your doctor.`;
	if (score < 30) return `Your score of ${score} is above the threshold of 16 that is commonly cited in the published literature. Discuss your score and symptoms with your doctor.`;
	if (score < 50) return `Your score of ${score} indicates autonomic symptoms across multiple domains. Discuss your score and symptoms with your doctor.`;
	return `Your score of ${score} indicates autonomic symptoms across multiple domains. Discuss your score and symptoms with your doctor.`;
}

const form = document.getElementById('compass-form') as HTMLFormElement;
const resultsPanel = document.getElementById('results') as HTMLElement;
const totalScoreEl = document.getElementById('total-score-value') as HTMLElement;
const interpEl = document.getElementById('score-interpretation') as HTMLElement;
const domainRowsEl = document.getElementById('domain-rows') as HTMLElement;

form.addEventListener('submit', (e) => {
	e.preventDefault();
	const result = computeScore();

	if (!result) {
		alert('Please answer all questions before calculating your score.');
		// Highlight first unanswered
		for (const domain of DOMAINS) {
			for (const q of domain.questions) {
				if (getAnsweredValue(q) === null) {
					const firstInput = document.querySelector<HTMLInputElement>(`input[name="${q}"]`);
					firstInput?.closest('.question')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
					return;
				}
			}
		}
		return;
	}

	const { domainScores, total } = result;
	const rounded = Math.round(total * 10) / 10;

	totalScoreEl.textContent = String(rounded);
	interpEl.textContent = interpret(rounded);

	domainRowsEl.innerHTML = domainScores.map(d => `
		<tr>
			<td>${d.name}</td>
			<td>${Math.round(d.score * 10) / 10}</td>
			<td>${d.max}</td>
		</tr>
	`).join('');

	form.hidden = true;
	resultsPanel.hidden = false;
	resultsPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
});

document.getElementById('reset-btn')?.addEventListener('click', () => {
	form.reset();
});

document.getElementById('back-btn')?.addEventListener('click', () => {
	resultsPanel.hidden = true;
	form.hidden = false;
	form.scrollIntoView({ behavior: 'smooth', block: 'start' });
});
</script>

