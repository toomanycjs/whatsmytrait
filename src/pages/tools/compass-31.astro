---
import Page from '../../layouts/Page.astro';
import ScoreHistory from '../../components/ScoreHistory.astro';
import SharedResults from '../../components/SharedResults.astro';
import Compass31Interpretation from '../../components/interpretation/Compass31.astro';
import { FAQ, FAQ_ORDER } from '../../tools/compass-31.content';

// COMPASS-31 items, answer options and scoring key, following the published
// instrument and scoring algorithm (Sletten et al., Mayo Clin Proc 2012, as
// reproduced with its scoring table in Okdahl et al., BMJ Open 2021,
// supplementary material 3). Question wording here is a plain-English
// rendering; the structure, recall periods, answer options, skip rules and
// points are the published ones.
//
// Each domain's raw score is the sum of its item points, then multiplied by
// max / rawMax (OI ×4.0, VM ×0.8333, SM ×2.1429, GI ×0.8929, BL ×1.1111,
// PM ×0.3333), giving 40 + 5 + 15 + 25 + 10 + 5 = 100.
//
// `skips`: when the answer is one of `on` (option indexes), the listed items
// are not asked and score 0, as in the paper instrument's "skip to" notes.

type Option = { label: string; points: number };
type Item = {
	n: number;
	text: string;
	type?: 'check';
	options: Option[];
	skips?: { on: number[]; items: number[] };
};
type Domain = { key: string; name: string; intro: string; max: number; rawMax: number; items: Item[] };

const yesNo: Option[] = [
	{ label: 'Yes', points: 1 },
	{ label: 'No', points: 0 },
];
const severity: Option[] = [
	{ label: 'Mild', points: 1 },
	{ label: 'Moderate', points: 2 },
	{ label: 'Severe', points: 3 },
];
const frequency: Option[] = [
	{ label: 'Rarely', points: 0 },
	{ label: 'Occasionally', points: 1 },
	{ label: 'Frequently', points: 2 },
	{ label: 'Constantly', points: 3 },
];
const neverToConstantly: Option[] = [
	{ label: 'Never', points: 0 },
	{ label: 'Occasionally', points: 1 },
	{ label: 'Frequently', points: 2 },
	{ label: 'Constantly', points: 3 },
];
const neverToALot: Option[] = [
	{ label: 'Never', points: 0 },
	{ label: 'Sometimes', points: 1 },
	{ label: 'A lot of the time', points: 2 },
];
const trend: Option[] = [
	{ label: 'Much worse', points: 3 },
	{ label: 'Somewhat worse', points: 2 },
	{ label: 'About the same', points: 1 },
	{ label: 'Somewhat better', points: 0 },
	{ label: 'Much better', points: 0 },
	{ label: 'Gone completely', points: 0 },
];
const trendOrNone: Option[] = [{ label: "I haven't had any of these symptoms", points: 0 }, ...trend];

const domains: Domain[] = [
	{
		key: 'orthostatic',
		name: 'Orthostatic intolerance',
		intro: 'Symptoms that come on after standing up from sitting or lying down.',
		max: 40,
		rawMax: 10,
		items: [
			{ n: 1, text: 'In the past year, have you felt faint, dizzy or muddled, or found it hard to think, soon after standing up from sitting or lying down?', options: yesNo, skips: { on: [1], items: [2, 3, 4] } },
			{ n: 2, text: 'When you stand up, how often do you get these feelings or symptoms?', options: [{ label: 'Rarely', points: 0 }, { label: 'Occasionally', points: 1 }, { label: 'Frequently', points: 2 }, { label: 'Almost always', points: 3 }] },
			{ n: 3, text: 'How severe are these feelings or symptoms?', options: severity },
			{ n: 4, text: 'Over the past year, have these feelings or symptoms got:', options: trend },
		],
	},
	{
		key: 'vasomotor',
		name: 'Vasomotor',
		intro: 'Changes in skin colour linked to blood flow.',
		max: 5,
		rawMax: 6,
		items: [
			{ n: 5, text: 'In the past year, have you noticed colour changes in your skin, such as red, white or purple?', options: yesNo, skips: { on: [1], items: [6, 7] } },
			{ n: 6, text: 'Which parts of your body are affected by these colour changes? Tick all that apply.', type: 'check', options: [{ label: 'Hands', points: 1 }, { label: 'Feet', points: 1 }] },
			{ n: 7, text: 'Are these skin colour changes getting:', options: trend },
		],
	},
	{
		key: 'secretomotor',
		name: 'Secretomotor',
		intro: 'Sweating, and dryness of the eyes and mouth.',
		max: 15,
		rawMax: 7,
		items: [
			{ n: 8, text: 'In the past five years, what change, if any, has there been in how much you sweat overall?', options: [{ label: 'I sweat much more than I used to', points: 1 }, { label: 'I sweat somewhat more than I used to', points: 0 }, { label: "I haven't noticed any change", points: 0 }, { label: 'I sweat somewhat less than I used to', points: 1 }, { label: 'I sweat much less than I used to', points: 2 }] },
			{ n: 9, text: 'Do your eyes feel excessively dry?', options: yesNo },
			{ n: 10, text: 'Does your mouth feel excessively dry?', options: yesNo },
			{ n: 11, text: "Thinking of whichever you've had longest, dry eyes or dry mouth, is it getting:", options: trendOrNone },
		],
	},
	{
		key: 'gi',
		name: 'Gastrointestinal',
		intro: 'Digestion and bowel function. The autonomic nervous system controls how the gut moves.',
		max: 25,
		rawMax: 28,
		items: [
			{ n: 12, text: 'In the past year, has there been any change in how quickly you feel full when eating a meal?', options: [{ label: 'I get full a lot more quickly than I used to', points: 2 }, { label: 'I get full more quickly than I used to', points: 1 }, { label: "I haven't noticed any change", points: 0 }, { label: 'I get full less quickly than I used to', points: 0 }, { label: 'I get full a lot less quickly than I used to', points: 0 }] },
			{ n: 13, text: 'In the past year, have you felt excessively or persistently full (bloated) after a meal?', options: neverToALot },
			{ n: 14, text: 'In the past year, have you vomited after a meal?', options: neverToALot },
			{ n: 15, text: 'In the past year, have you had cramping or colicky pain in your abdomen?', options: neverToALot },
			{ n: 16, text: 'In the past year, have you had any bouts of diarrhoea?', options: yesNo, skips: { on: [1], items: [17, 18, 19] } },
			{ n: 17, text: 'How often do the bouts of diarrhoea happen?', options: frequency },
			{ n: 18, text: 'How severe are the bouts of diarrhoea?', options: severity },
			{ n: 19, text: 'Are the bouts of diarrhoea getting:', options: trend },
			{ n: 20, text: 'In the past year, have you been constipated?', options: yesNo, skips: { on: [1], items: [21, 22, 23] } },
			{ n: 21, text: 'How often are you constipated?', options: frequency },
			{ n: 22, text: 'How severe are the episodes of constipation?', options: severity },
			{ n: 23, text: 'Is the constipation getting:', options: trend },
		],
	},
	{
		key: 'bladder',
		name: 'Bladder',
		intro: 'Bladder control and emptying.',
		max: 10,
		rawMax: 9,
		items: [
			{ n: 24, text: 'In the past year, have you lost control of your bladder?', options: neverToConstantly },
			{ n: 25, text: 'In the past year, have you had difficulty passing urine?', options: neverToConstantly },
			{ n: 26, text: 'In the past year, have you had trouble emptying your bladder completely?', options: neverToConstantly },
		],
	},
	{
		key: 'pupillomotor',
		name: 'Pupillomotor',
		intro: 'Light sensitivity and focusing, which depend on how the pupils respond.',
		max: 5,
		rawMax: 15,
		items: [
			{ n: 27, text: 'In the past year, without sunglasses or tinted glasses, has bright light bothered your eyes?', options: neverToConstantly, skips: { on: [0], items: [28] } },
			{ n: 28, text: 'How severe is this sensitivity to bright light?', options: severity },
			{ n: 29, text: 'In the past year, have you had trouble focusing your eyes?', options: neverToConstantly, skips: { on: [0], items: [30] } },
			{ n: 30, text: 'How severe is this focusing problem?', options: severity },
			{ n: 31, text: 'Is your most troublesome eye symptom (sensitivity to bright light or trouble focusing) getting:', options: trendOrNone },
		],
	},
];

// Serialised for the client-side scoring script.
const clientConfig = { domains };

// Breadcrumb plus FAQPage. FAQ answers are rendered word for word in the
// "Understanding your COMPASS-31 score" section, so schema and page match.
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.postviralrecovery.com/' },
				{ '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.postviralrecovery.com/tools/' },
				{ '@type': 'ListItem', position: 3, name: 'COMPASS-31', item: 'https://www.postviralrecovery.com/tools/compass-31/' },
			],
		},
		{
			'@type': 'FAQPage',
			mainEntity: FAQ_ORDER.map(k => ({ '@type': 'Question', name: FAQ[k].q, acceptedAnswer: { '@type': 'Answer', text: FAQ[k].a } })),
		},
	],
};
---

<Page
	title="COMPASS-31: free online questionnaire with automatic scoring"
	description="Complete the COMPASS-31 autonomic symptom questionnaire online and get your weighted score instantly, across all six domains. Free and interactive, with the scoring done for you and your result explained. No PDF, no sign-up."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</Fragment>
			<div class="tool-header">
				<a href="/tools/" class="section-label tools">Tools</a>
				<h1>COMPASS-31</h1>
				<p class="subtitle">Composite Autonomic Symptom Score</p>
				<p class="description">
  The COMPASS-31 (Composite Autonomic Symptom Score) is a 31-item self-report questionnaire that measures the severity of autonomic symptoms across six domains: orthostatic intolerance, vasomotor function, secretomotor function, gastrointestinal symptoms, bladder function, and pupillomotor function. It was developed at the Mayo Clinic and published by Sletten and colleagues in 2012 as a shorter, more practical version of the original 169-item Autonomic Symptom Profile.
</p>
<p class="description">
  It is widely used in both clinical practice and research to screen for dysautonomia and to track autonomic symptom burden over time. It has been validated in multiple languages and is referenced in studies on POTS, diabetic neuropathy, and post-viral autonomic dysfunction including long COVID.
</p>
<p class="description">
  The questionnaire generates a weighted total score from 0 to 100, with higher scores indicating greater symptom severity. Each domain is scored separately and then weighted according to the original validation, so the total reflects the relative clinical importance of different symptom areas rather than simply adding up raw answers.
</p>
<p class="description">
  If you have a post-viral condition, POTS, ME/CFS, or suspected dysautonomia, the COMPASS-31 can help you quantify your symptom burden in a structured way. It is particularly useful for tracking changes over time and for bringing a concrete, standardised summary to clinical appointments. If your main concern is POTS specifically, the <a href="/tools/malmo-pots-score/">Malmö POTS Symptom Score</a> is a newer 12-item score built for POTS with a 7-day recall window, the <a href="/tools/orthostatic-grading-scale/">Orthostatic Grading Scale</a> grades orthostatic intolerance in five questions, the <a href="/tools/vanderbilt-orthostatic-symptom-score/">Vanderbilt Orthostatic Symptom Score</a> is rated while standing, and the <a href="/tools/nasa-lean-test/">NASA lean test</a> records the heart-rate data a POTS assessment requires. <a href="/testing/do-i-have-pots/">Do I have POTS?</a> explains when to use each one, including what to do if you have the symptoms but do not meet the POTS heart rate criteria.
</p>
<p class="description">
  This is a free, interactive version. Complete it below and receive your weighted score immediately, broken down by domain. No sign-up or email is required.
</p>
			</div>

			<form id="compass-form" novalidate>
				<p class="form-instructions">Most questions ask about the past year. Some follow-up questions only appear if they apply to you, depending on your earlier answers.</p>
				{domains.map((domain, di) => (
					<fieldset class="domain" data-domain={domain.key}>
						<legend>
							<span class="domain-number">Domain {di + 1}</span>
							<span class="domain-name">{domain.name}</span>
						</legend>
						<p class="domain-intro">{domain.intro}</p>
						{domain.items.map(item => (
							<div class="question" data-q={item.n}>
								<p class="q-text" id={`q${item.n}-text`}>{item.n}. {item.text}</p>
								<div class="options" role={item.type === 'check' ? 'group' : 'radiogroup'} aria-labelledby={`q${item.n}-text`}>
									{item.options.map((opt, oi) => (
										<label>
											<input type={item.type === 'check' ? 'checkbox' : 'radio'} name={`q${item.n}`} value={oi} />
											<span>{opt.label}</span>
										</label>
									))}
								</div>
							</div>
						))}
					</fieldset>
				))}

				<div class="form-footer">
					<button type="submit" id="submit-btn">Calculate score</button>
					<button type="button" id="reset-btn">Clear all</button>
				</div>
			</form>

			<!-- Results panel -->
			<div id="results" class="results" hidden>
				<h2>Your COMPASS-31 score</h2>
				<div class="total-score">
					<span id="total-score-value">—</span>
					<span class="total-score-label">out of 100</span>
				</div>
				<p id="score-interpretation" class="score-interp"></p>

				<h3>Domain breakdown</h3>
				<table class="domain-table">
					<thead>
						<tr>
							<th>Domain</th>
							<th>Your score</th>
							<th>Max</th>
						</tr>
					</thead>
					<tbody id="domain-rows"></tbody>
				</table>

				<ScoreHistory toolId="compass-31" toolName="COMPASS-31" />

				<button type="button" id="back-btn" class="back-btn">Edit answers</button>
			</div>

			<SharedResults toolId="compass-31" />

			<Compass31Interpretation>
				<div class="disclaimer" slot="disclaimer"><strong>This is not a diagnostic tool.</strong> Your score reflects self-reported symptom severity and does not constitute a diagnosis of any condition. Scores should be discussed with your doctor or specialist.</div>
				<p class="citation" slot="citation">Based on: Sletten DM, Suarez GA, Low PA, Mandrekar J, Singer W. <em>COMPASS 31: a refined and abbreviated composite autonomic symptom score.</em> Mayo Clin Proc. 2012;87(12):1196–1201.</p>
			</Compass31Interpretation>

			<script type="application/json" id="compass-config" set:html={JSON.stringify(clientConfig)}></script>
</Page>

<script>
import { compass31 } from '../../tools/compass-31';
import { interpretResult } from '../../scripts/results/interpretation';
import { mountScoreHistory, mountSharedResults } from '../../scripts/results/scoreHistory';

type Option = { label: string; points: number };
type Item = { n: number; text: string; type?: 'check'; options: Option[]; skips?: { on: number[]; items: number[] } };
type Domain = { key: string; name: string; max: number; rawMax: number; items: Item[] };

const cfgEl = document.getElementById('compass-config');
const DOMAINS: Domain[] = JSON.parse(cfgEl?.textContent || '{"domains":[]}').domains;
const ITEMS: Item[] = DOMAINS.flatMap(d => d.items);

const form = document.getElementById('compass-form') as HTMLFormElement;
const resultsPanel = document.getElementById('results') as HTMLElement;
const totalScoreEl = document.getElementById('total-score-value') as HTMLElement;
const interpEl = document.getElementById('score-interpretation') as HTMLElement;
const domainRowsEl = document.getElementById('domain-rows') as HTMLElement;

function inputs(n: number) {
	return form.querySelectorAll<HTMLInputElement>(`input[name="q${n}"]`);
}

function selectedIndex(n: number): number | null {
	const checked = form.querySelector<HTMLInputElement>(`input[name="q${n}"]:checked`);
	return checked ? parseInt(checked.value, 10) : null;
}

// Items not asked because of an earlier answer, per the instrument's skip notes.
function skippedItems(): Set<number> {
	const skipped = new Set<number>();
	for (const item of ITEMS) {
		if (!item.skips || skipped.has(item.n)) continue;
		const sel = selectedIndex(item.n);
		if (sel !== null && item.skips.on.includes(sel)) item.skips.items.forEach(n => skipped.add(n));
	}
	return skipped;
}

function applySkips() {
	const skipped = skippedItems();
	for (const item of ITEMS) {
		const el = form.querySelector<HTMLElement>(`.question[data-q="${item.n}"]`);
		if (!el) continue;
		const skip = skipped.has(item.n);
		el.hidden = skip;
		inputs(item.n).forEach(inp => {
			inp.disabled = skip;
			if (skip) inp.checked = false;
		});
	}
}

function itemPoints(item: Item): number | null {
	if (item.type === 'check') {
		let sum = 0;
		inputs(item.n).forEach(inp => { if (inp.checked) sum += item.options[parseInt(inp.value, 10)].points; });
		return sum;
	}
	const sel = selectedIndex(item.n);
	return sel === null ? null : item.options[sel].points;
}

type DomainScore = { key: string; name: string; score: number; max: number; raw: number; rawMax: number };

// Returns the first unanswered item number if the form is incomplete.
function computeScore(): { domainScores: DomainScore[]; total: number } | { missing: number } {
	const skipped = skippedItems();
	const domainScores: DomainScore[] = [];
	let total = 0;
	for (const domain of DOMAINS) {
		let raw = 0;
		for (const item of domain.items) {
			if (skipped.has(item.n)) continue;
			const pts = itemPoints(item);
			if (pts === null) return { missing: item.n };
			raw += pts;
		}
		const score = raw * (domain.max / domain.rawMax);
		domainScores.push({ key: domain.key, name: domain.name, score, max: domain.max, raw, rawMax: domain.rawMax });
		total += score;
	}
	return { domainScores, total };
}

const round1 = (x: number) => Math.round(x * 10) / 10;

const history = mountScoreHistory(compass31);
mountSharedResults(compass31);

// REVIEW: Layer 1 copy. No published cut-offs exist, so the first sentence
// describes the score without banding it; interpretResult adds the domains
// that contributed most (and a MIC comparison, if one is ever published).
function interpret(total: number, subscores: Record<string, number>): string {
	const opening = `Your total is ${round1(total)} out of 100. There is no agreed cut-off, so the reference points below show how scores compare in published studies.`;
	return [opening, interpretResult(compass31, { total, subscores }, history.latest())].filter(Boolean).join(' ');
}

form.addEventListener('change', applySkips);

form.addEventListener('submit', (e) => {
	e.preventDefault();
	const result = computeScore();

	if ('missing' in result) {
		alert('Please answer all questions before calculating your score.');
		const el = form.querySelector<HTMLElement>(`.question[data-q="${result.missing}"]`);
		el?.scrollIntoView({ behavior: 'smooth', block: 'center' });
		return;
	}

	const { domainScores, total } = result;
	const subscores = Object.fromEntries(domainScores.map(d => [d.key, round1(d.score)]));
	totalScoreEl.textContent = String(round1(total));
	interpEl.textContent = interpret(round1(total), subscores);

	domainRowsEl.innerHTML = domainScores.map(d => `
		<tr>
			<td>${d.name}</td>
			<td>${round1(d.score)}</td>
			<td>${d.max}</td>
		</tr>
	`).join('');

	form.hidden = true;
	resultsPanel.hidden = false;
	history.record({ total: round1(total), subscores });
	resultsPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
});

document.getElementById('reset-btn')?.addEventListener('click', () => {
	form.reset();
	applySkips();
});

document.getElementById('back-btn')?.addEventListener('click', () => {
	resultsPanel.hidden = true;
	form.hidden = false;
	form.scrollIntoView({ behavior: 'smooth', block: 'start' });
});

applySkips();
</script>

<style>
	.tool-header {
		padding-bottom: 1.5em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2.5em;
	}
	.tool-header h1 { margin: 0.3em 0 0.1em; }
	.subtitle { color: rgb(var(--gray)); font-size: 1.05em; margin: 0 0 0.75em; }
	.description { margin-bottom: 1em; }

	/* Domain fieldsets */
	.domain {
		border: none;
		border-top: 1px solid rgb(var(--gray-dark));
		padding: 1.25em 0 0.5em;
		margin: 0 0 1.5em;
		min-width: 0;
	}
	legend {
		padding: 0;
		float: left;
		width: 100%;
		margin: 0 0 0.5em;
		font-size: 1em;
	}
	.domain > :not(legend) { clear: both; }
	.domain-number {
		font-size: 0.75em;
		font-weight: 700;
		color: rgb(var(--gray));
		margin-right: 0.5em;
	}
	.domain-name {
		font-family: var(--font-serif);
		font-weight: 600;
		font-size: 1.2em;
		color: rgb(var(--black));
	}
	.domain-intro {
		color: rgb(var(--gray));
		font-size: 0.9em;
		margin: 0.5em 0 1.25em;
		font-style: italic;
	}

	/* Questions */
	.question {
		margin-bottom: 1.5em;
		padding-bottom: 1.5em;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.question:last-of-type { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
	.q-text { margin: 0 0 0.75em; font-weight: 700; font-size: 0.95em; line-height: 1.45; }
	.options { display: flex; flex-direction: column; gap: 0.4em; }
	.options label { display: flex; align-items: flex-start; gap: 0.6em; padding: 0.6em 0.8em; border: 1px solid rgb(var(--gray-light)); border-radius: 3px; cursor: pointer; font-size: 0.9em; line-height: 1.4; position: relative; }
	.options label:hover { border-color: var(--accent); }
	.options input[type="radio"], .options input[type="checkbox"] { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
	.question[hidden] { display: none; }
	.form-instructions { color: rgb(var(--gray)); font-size: 0.95em; margin: 0 0 1.5em; }
	.options label:has(input:checked) { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 700; }

	/* Form footer */
	.form-footer {
		display: flex;
		gap: 1em;
		padding: 2em 0 1em;
	}
	button[type="submit"] {
		background: var(--accent);
		color: #fff;
		border: none;
		padding: 0.75em 2em;
		border-radius: 3px;
		font-size: 1em;
		font-weight: 700;
		cursor: pointer;
		font-family: inherit;
	}
	button[type="submit"]:hover { background: var(--accent-dark); }
	button[type="button"] {
		background: none;
		border: 1px solid rgb(var(--gray-light));
		padding: 0.75em 1.5em;
		border-radius: 3px;
		font-size: 0.95em;
		cursor: pointer;
		color: rgb(var(--gray));
		font-family: inherit;
	}
	button[type="button"]:hover { border-color: rgb(var(--gray)); color: rgb(var(--black)); }

	/* Results */
	.results { padding-top: 1em; }
	.results h2 { margin-bottom: 0.5em; }
	.total-score {
		display: flex;
		align-items: baseline;
		gap: 0.5em;
		margin: 1em 0;
	}
	#total-score-value {
		font-size: 3.5em;
		font-weight: 700;
		color: var(--accent);
		line-height: 1;
	}
	.total-score-label { color: rgb(var(--gray)); font-size: 1.1em; }
	.score-interp {
		font-size: 1.05em;
		line-height: 1.6;
		margin: 0 0 2em;
		padding: 0;
	}
	.domain-table { margin: 1em 0 2em; }
	.back-btn {
		background: none;
		border: 1px solid rgb(var(--gray-light));
		padding: 0.6em 1.25em;
		border-radius: 3px;
		font-size: 0.95em;
		cursor: pointer;
		color: rgb(var(--gray));
		font-family: inherit;
		margin-top: 1em;
	}
	.back-btn:hover { border-color: var(--accent); color: var(--accent); }

