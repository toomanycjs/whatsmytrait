---
// Every questionnaire result saved in this browser, grouped by tool. Built
// entirely client side from localStorage; the static HTML holds only the
// shell. Not indexed (nothing here is the same for two visitors) and left out
// of the sitemap in astro.config.mjs.
import Page from '../../layouts/Page.astro';
import '../../styles/score-history.css';
---

<Page structuredData={false}
	title="Your saved results"
	description="Every questionnaire result saved in this browser, grouped by tool, with copy, CSV download and delete. Nothing is sent anywhere."
>
	<Fragment slot="head">
		<meta name="robots" content="noindex, follow" />
	</Fragment>

	<div class="my-results score-history">
		<h1>Your saved results</h1>
		<p class="mr-intro">
			Results from the <a href="/tools/">questionnaires</a> on this site, saved in this browser each time you complete one. Open a tool to retake it, or to share a link to its results.
		</p>
		<p class="mr-status" role="status" tabindex="-1">Loading your saved results…</p>

		<div class="mr-actions" hidden>
			<div class="sh-actions">
				<button type="button" class="sh-btn" data-export="text">Copy all as text</button>
				<button type="button" class="sh-btn" data-export="csv">Download all as CSV</button>
			</div>
			<p class="sh-export-status mr-export-status" role="status"></p>
		</div>

		<div class="mr-tools"></div>

		<div class="mr-delete-all"></div>

		<!-- REVIEW: privacy wording from the brief, for Craig to approve. -->
		<p class="sh-privacy">Your results are stored only in this browser, on this device. Nothing is sent to us or to anyone else. They will be lost if you clear this site's data, use a private window, or switch browser or device. You can delete them at any time.</p>
	</div>
</Page>

<script>
	import { mountMyResults } from '../../scripts/results/myResults';
	import { TOOL_CONFIGS } from '../../tools/registry';
	mountMyResults(TOOL_CONFIGS);
</script>

<style>
	.my-results { margin-top: 0; padding-top: 0; border-top: none; }
	.mr-intro { color: rgb(var(--gray)); }
	.mr-status { font-weight: 700; }
	.mr-status:focus { outline: none; }
	.mr-actions { margin: 1.25em 0 2em; }
	.my-results :global(.mr-tool) {
		margin: 0 0 2.5em;
		padding-top: 1.5em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.my-results :global(.mr-tool h2) { font-size: 1.3em; }
	.my-results :global(.mr-tool-foot) { display: flex; flex-wrap: wrap; gap: 0.5em 1.5em; align-items: center; }
	.mr-delete-all { margin: 2em 0 1.5em; }
</style>
