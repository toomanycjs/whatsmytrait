	.next-btn:hover, .submit-btn:hover { background: var(--accent-dark); }
	.back-step-btn, .back-btn, .btn-secondary { background: none; border: 1px solid rgb(var(--gray-light)); padding: 0.75em 1.25em; border-radius: 3px; font-size: 0.95em; cursor: pointer; color: rgb(var(--gray)); font-family: inherit; }
	.back-step-btn:hover, .back-btn:hover, .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }

	.results { padding-top: 1em; }
	.results h2 { margin-bottom: 0.5em; }
	.results h3 { margin-top: 1.75em; margin-bottom: 0.4em; }
	.score-interp { font-size: 1em; line-height: 1.6; margin: 0 0 1.25em; padding: 0; }

