---
import Page from '../../layouts/Page.astro';
import ScoreHistory from '../../components/ScoreHistory.astro';
import SharedResults from '../../components/SharedResults.astro';
import HedsInterpretation from '../../components/interpretation/HedsCriteria.astro';
import { FAQ, FAQ_ORDER } from '../../tools/heds-criteria.content';
import { toolJsonLd } from '../../tools/jsonld';

const featureA = [
	{ id: 'a1', text: 'Unusually soft or velvety skin', clinical: false },
	{ id: 'a2', text: 'Mild skin hyperextensibility (skin that stretches further than usual, then returns)', clinical: false },
	{ id: 'a3', text: 'Unexplained stretch marks (striae distensae or rubrae) on the back, groins, thighs, breasts and/or abdomen in adolescents, men, or pre-pubertal women, without a history of significant gain or loss of body fat or weight', clinical: false },
	{ id: 'a4', text: 'Bilateral piezogenic papules of the heel (small soft lumps on both heels that appear when standing)', clinical: false },
	{ id: 'a5', text: 'Recurrent or multiple abdominal hernias', clinical: false },
	{ id: 'a6', text: 'Atrophic scarring at two or more sites, without the papery or dark-stained scars seen in classical EDS', clinical: true },
	{ id: 'a7', text: 'Pelvic floor, rectal, and/or uterine prolapse in children, men, or women who have not given birth, without a history of morbid obesity or another known predisposing condition', clinical: false },
	{ id: 'a8', text: 'Dental crowding and a high or narrow palate', clinical: false },
	{ id: 'a9', text: 'Arachnodactyly: a positive wrist sign (Walker sign) on both sides, or a positive thumb sign (Steinberg sign) on both sides', clinical: false },
	{ id: 'a10', text: 'Arm span-to-height ratio of 1.05 or more', clinical: false },
	{ id: 'a11', text: 'Mitral valve prolapse, mild or greater, on strict echocardiographic criteria', clinical: true },
	{ id: 'a12', text: 'Aortic root dilatation with a Z-score above +2', clinical: true },
];

const fivePQ = [
	{ id: 'q1', text: 'Can you now (or could you ever) place your hands flat on the floor without bending your knees?' },
	{ id: 'q2', text: 'Can you now (or could you ever) bend your thumb to touch your forearm?' },
	{ id: 'q3', text: 'As a child, did you amuse your friends by contorting your body into strange shapes, or could you do the splits?' },
	{ id: 'q4', text: 'As a child or teenager, did your shoulder or kneecap dislocate on more than one occasion?' },
	{ id: 'q5', text: 'Do you consider yourself “double-jointed”?' },
];

const featureC = [
	{ id: 'c1', text: 'Musculoskeletal pain in two or more limbs, recurring daily for at least 3 months' },
	{ id: 'c2', text: 'Chronic, widespread pain for 3 months or more' },
	{ id: 'c3', text: 'Recurrent joint dislocations or frank joint instability, in the absence of trauma: either three or more atraumatic dislocations in the same joint (or two or more in two different joints at different times), or medical confirmation of joint instability at two or more sites not related to trauma' },
];

const prerequisites = [
	{ id: 'p1', text: 'Absence of unusual skin fragility (which should prompt consideration of other types of EDS)' },
	{ id: 'p2', text: 'Exclusion of other heritable and acquired connective tissue disorders, including autoimmune rheumatological conditions' },
	{ id: 'p3', text: 'Exclusion of alternative diagnoses that may also involve joint hypermobility through low muscle tone or connective tissue laxity, such as neuromuscular disorders (e.g. Bethlem myopathy), other hereditary connective tissue disorders (other EDS types, Loeys-Dietz syndrome, Marfan syndrome), and skeletal dysplasias (e.g. osteogenesis imperfecta)' },
];

const jsonLd = toolJsonLd('hEDS diagnostic criteria', '/tools/heds-criteria/', FAQ_ORDER.map(k => FAQ[k]));
---

<Page
	title="hEDS diagnostic criteria (2017): free interactive checklist"
	description="Walk through the 2017 international diagnostic criteria for hypermobile Ehlers-Danlos syndrome step by step: Beighton score and the five-part questionnaire, the 12 Feature A signs, family history, musculoskeletal features, and the three exclusion prerequisites. Free, private, and clearly not a diagnosis."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</Fragment>
			<div class="tool-header">
				<a href="/tools/" class="section-label tools">Tools</a>
				<h1>hEDS diagnostic criteria checker</h1>
				<p class="subtitle">The 2017 international criteria for hypermobile Ehlers-Danlos syndrome, one criterion at a time</p>
				<p class="description">
					Hypermobile Ehlers-Danlos syndrome (hEDS) is diagnosed clinically against the criteria published by the International Consortium on the Ehlers-Danlos Syndromes in 2017. There is no genetic test. The criteria are usually distributed as a one-page PDF checklist written for clinicians. This page walks through the same three criteria interactively, in plain language, showing you at each step which items you meet, which you do not, and which can only be settled by a doctor. Notably, POTS, fatigue, and gut symptoms are common alongside hEDS but are not part of the criteria.
				</p>
				<p class="description">
					hEDS needs <strong>all three</strong> criteria at once. <strong>Criterion 1</strong> is generalised joint hypermobility on the <a href="/tools/beighton-score/">Beighton score</a>, with the <a href="/tools/five-part-questionnaire/">five-part questionnaire</a> filling in when your score is one point short of the age cut-off. <strong>Criterion 2</strong> asks for two of three features: systemic signs of a connective tissue disorder, family history, and musculoskeletal complications. <strong>Criterion 3</strong> is a set of exclusions that only a clinician can confirm.
				</p>
				<p class="description">
					Joint hypermobility is common in people with POTS and other forms of dysautonomia, and a hypermobility assessment is a reasonable part of a post-viral work-up when joints, skin, or pain fit the picture. If you only want the hypermobility score, use the <a href="/tools/beighton-score/">Beighton tool</a>; if you completed it recently on this device, this page will offer to reuse your score.
				</p>
				<div class="disclaimer">
					<strong>This is not a diagnostic tool.</strong> It reproduces published diagnostic criteria so you can see how your own history maps onto them. Several items need physical examination, an echocardiogram, or genetic testing, and Criterion 3 requires a clinician to exclude other conditions. Meeting the pattern here does not mean you have hEDS; not meeting it does not rule out a hypermobility-related condition. The 2017 criteria are the current published international criteria. The Ehlers-Danlos Society has announced that revised criteria for all EDS types and HSD are due for publication in December 2026, with care pathways to follow in 2027; this page will be revised when they appear. Wording here is paraphrased from: Malfait F, Francomano C, Byers P, et al. <em>The 2017 international classification of the Ehlers-Danlos syndromes.</em> Am J Med Genet C Semin Med Genet. 2017;175(1):8–26, and the <a href="https://www.ehlers-danlos.com/heds-diagnostic-checklist/" rel="noopener">Ehlers-Danlos Society diagnostic checklist</a>.
				</div>
			</div>

			<form id="heds-form" novalidate>
				<div class="progress-wrap">
					<div class="progress-text"><span id="progress-label">Step 1 of 4</span></div>
					<div class="progress-bar"><div id="progress-fill" class="progress-fill"></div></div>
				</div>

				<!-- STEP 0: Criterion 1 -->
				<section class="step" data-step="0">
					<div class="step-head">
						<span class="step-kicker">Criterion 1</span>
						<h2>Generalised joint hypermobility</h2>
						<p class="step-intro">Criterion 1 uses the Beighton score with an age-dependent cut-off. If your score is exactly one point below the cut-off, the five-part questionnaire can make up the difference.</p>
					</div>

					<div class="q" data-q="ageband">
						<p class="q-text">Which group applies to you?</p>
						<div class="radio-options">
							<label class="radio-label"><input type="radio" name="ageband" value="child" /><span><strong>Pre-pubertal child or adolescent</strong> &mdash; cut-off 6 or more</span></label>
							<label class="radio-label"><input type="radio" name="ageband" value="adult" /><span><strong>Pubertal, up to age 50</strong> &mdash; cut-off 5 or more</span></label>
							<label class="radio-label"><input type="radio" name="ageband" value="over50" /><span><strong>Over 50</strong> &mdash; cut-off 4 or more</span></label>
						</div>
					</div>

					<div class="q" data-q="beighton">
						<p class="q-text">Your Beighton score (0–9)</p>
						<p id="beighton-saved" class="q-note" hidden></p>
						<p class="q-note">Don't know it? <a href="/tools/beighton-score/">Work through the nine manoeuvres</a> with illustrations, then come back. Your score will be offered here automatically.</p>
						<div class="segmented ten">
							{Array.from({ length: 10 }, (_, v) => (
								<label>
									<input type="radio" name="beighton" value={v} aria-label={`Beighton score ${v}`} />
									<span aria-hidden="true">{v}</span>
								</label>
							))}
						</div>
					</div>

					<div id="fivepq-block" class="subblock" hidden>
						<h3>Five-part questionnaire</h3>
						<p class="q-note">Your score is one point below the cut-off, so the criteria allow the five-part questionnaire (5PQ) to count. Two or more "yes" answers meet Criterion 1. The questions deliberately include what you <em>could</em> do in the past, because joints stiffen with age.</p>
						{fivePQ.map(item => (
							<div class="q yesno" data-q={item.id}>
								<p class="q-text">{item.text}</p>
								<div class="segmented two">
									<label><input type="radio" name={item.id} value="1" /><span>Yes</span></label>
									<label><input type="radio" name={item.id} value="0" /><span>No</span></label>
								</div>
							</div>
						))}
					</div>

					<div class="step-footer">
						<span></span>
						<button type="button" class="next-btn" data-next>Next: Feature A</button>
					</div>
				</section>

				<!-- STEP 1: Criterion 2, Feature A -->
				<section class="step" data-step="1" hidden>
					<div class="step-head">
						<span class="step-kicker">Criterion 2 · Feature A</span>
						<h2>Systemic signs of a connective tissue disorder</h2>
						<p class="step-intro">Feature A is met when <strong>five or more</strong> of these 12 signs are present. Some can only be judged by a clinician or by imaging; answer "don't know" for those and they will be listed as items to raise at an appointment.</p>
					</div>
					<div class="scale-key">Yes = present · No = absent · Don't know = needs examination, imaging, or a measurement you haven't had</div>
					{featureA.map(item => (
						<div class="q" data-q={item.id}>
							<p class="q-text">{item.text} {item.clinical && <span class="tag">clinician / imaging</span>}</p>
							<div class="segmented three">
								<label><input type="radio" name={item.id} value="1" /><span>Yes</span></label>
								<label><input type="radio" name={item.id} value="0" /><span>No</span></label>
								<label><input type="radio" name={item.id} value="u" /><span>Don't know</span></label>
							</div>
						</div>
					))}
					<div class="step-footer">
						<button type="button" class="back-step-btn" data-prev>← Back</button>
						<button type="button" class="next-btn" data-next>Next: Features B and C</button>
					</div>
				</section>

				<!-- STEP 2: Criterion 2, Features B and C -->
				<section class="step" data-step="2" hidden>
					<div class="step-head">
						<span class="step-kicker">Criterion 2 · Features B and C</span>
						<h2>Family history and musculoskeletal complications</h2>
						<p class="step-intro">Criterion 2 needs <strong>two or more</strong> of Features A, B, and C.</p>
					</div>

					<h3>Feature B: family history</h3>
					<div class="q" data-q="famhx">
						<p class="q-text">Do you have one or more first-degree relatives (parent, sibling, or child) who <em>independently</em> meets the current criteria for hEDS?</p>
						<p class="q-note">A relative who is "bendy" or has an older hypermobility diagnosis does not count unless they meet the 2017 criteria in their own right.</p>
						<div class="segmented three">
							<label><input type="radio" name="famhx" value="1" /><span>Yes</span></label>
							<label><input type="radio" name="famhx" value="0" /><span>No</span></label>
							<label><input type="radio" name="famhx" value="u" /><span>Don't know</span></label>
						</div>
					</div>

					<h3>Feature C: musculoskeletal complications</h3>
					<p class="q-note">Feature C is met by <strong>at least one</strong> of the following.</p>
					{featureC.map(item => (
						<div class="q yesno" data-q={item.id}>
							<p class="q-text">{item.text}</p>
							<div class="segmented two">
								<label><input type="radio" name={item.id} value="1" /><span>Yes</span></label>
								<label><input type="radio" name={item.id} value="0" /><span>No</span></label>
							</div>
						</div>
					))}

					<div class="step-footer">
						<button type="button" class="back-step-btn" data-prev>← Back</button>
						<button type="button" class="next-btn" data-next>Next: exclusions</button>
					</div>
				</section>

				<!-- STEP 3: Criterion 3 -->
				<section class="step" data-step="3" hidden>
					<div class="step-head">
						<span class="step-kicker">Criterion 3</span>
						<h2>Prerequisites that must all be met</h2>
						<p class="step-intro">These are exclusions. Only a clinician can confirm them, so the honest answer for most people who have not been assessed is "not assessed". They are included so the result shows exactly what still stands between you and a diagnosis.</p>
					</div>
					{prerequisites.map(item => (
						<div class="q" data-q={item.id}>
							<p class="q-text">{item.text}</p>
							<div class="segmented three">
								<label><input type="radio" name={item.id} value="1" /><span>Confirmed by a clinician</span></label>
								<label><input type="radio" name={item.id} value="0" /><span>Not met</span></label>
								<label><input type="radio" name={item.id} value="u" /><span>Not assessed</span></label>
							</div>
						</div>
					))}

					<div class="q" data-q="actd">
						<p class="q-text">Have you been diagnosed with an acquired connective tissue disorder, such as lupus or rheumatoid arthritis?</p>
						<p class="q-note">If so, the criteria change: Feature C (pain and instability) cannot be counted, and both Feature A and Feature B are required.</p>
						<div class="segmented two">
							<label><input type="radio" name="actd" value="1" /><span>Yes</span></label>
							<label><input type="radio" name="actd" value="0" /><span>No</span></label>
						</div>
					</div>

					<div class="step-footer">
						<button type="button" class="back-step-btn" data-prev>← Back</button>
						<button type="submit" class="submit-btn">See how my answers map to the criteria</button>
					</div>
				</section>
			</form>

			<!-- RESULTS -->
			<div id="results" class="results" hidden>
				<h2>How your answers map to the 2017 hEDS criteria</h2>
				<p id="overall-summary" class="score-interp"></p>
				<div id="criteria-cards" class="criteria-cards"></div>
				<div id="detail" class="detail"></div>

				<div class="results-disclaimer">
					<h3>Reading this result</h3>
					<!-- REVIEW: HSD and POTS paragraphs moved to the "Understanding your hEDS criteria checklist result" section below -->
					<p>hEDS requires Criteria 1, 2, and 3 simultaneously. Criteria 1 and 2 can be substantially self-assessed, which is what this page does; Criterion 3 cannot. A clinician also verifies the Feature A signs during examination, and the published method measures each Beighton joint with a goniometer. Treat the result as a structured summary to bring to an appointment, not a conclusion.</p>
					<p><strong>This is not a diagnosis.</strong> Discuss your results with your GP, a rheumatologist, or a clinical geneticist.</p>
				</div>

				<ScoreHistory toolId="heds-criteria" toolName="hEDS criteria checklist" />

				<div class="export-buttons">
					<button type="button" id="copy-btn" class="btn-secondary">Copy results as text</button>
					<button type="button" id="print-btn" class="btn-secondary">Print / save as PDF</button>
					<button type="button" id="back-btn" class="back-btn">Edit answers</button>
				</div>
				<p id="copy-confirm" class="copy-confirm" hidden>Results copied to clipboard.</p>
			</div>

			<SharedResults toolId="heds-criteria" />

			<HedsInterpretation />
</Page>

<script>
import { trackStep } from '../../scripts/pageview';
import { hedsCriteria, hedsOutcome } from '../../tools/heds-criteria';
import { mountScoreHistory, mountSharedResults } from '../../scripts/results/scoreHistory';

const history = mountScoreHistory(hedsCriteria);
mountSharedResults(hedsCriteria);

const FEATURE_A = [
	{ id: 'a1', short: 'Soft or velvety skin' },
	{ id: 'a2', short: 'Mild skin hyperextensibility' },
	{ id: 'a3', short: 'Unexplained stretch marks' },
	{ id: 'a4', short: 'Bilateral piezogenic heel papules' },
	{ id: 'a5', short: 'Recurrent or multiple abdominal hernias' },
	{ id: 'a6', short: 'Atrophic scarring at two or more sites' },
	{ id: 'a7', short: 'Pelvic floor, rectal, or uterine prolapse' },
	{ id: 'a8', short: 'Dental crowding and high or narrow palate' },
	{ id: 'a9', short: 'Arachnodactyly (wrist or thumb sign, both sides)' },
	{ id: 'a10', short: 'Arm span-to-height ratio ≥ 1.05' },
	{ id: 'a11', short: 'Mitral valve prolapse on echo' },
	{ id: 'a12', short: 'Aortic root dilatation, Z-score > +2' },
];
const FIVE_PQ = ['q1', 'q2', 'q3', 'q4', 'q5'];
const FEATURE_C = [
	{ id: 'c1', short: 'Daily limb pain ≥ 3 months' },
	{ id: 'c2', short: 'Chronic widespread pain ≥ 3 months' },
	{ id: 'c3', short: 'Recurrent atraumatic dislocations or instability' },
];
const PREREQS = [
	{ id: 'p1', short: 'No unusual skin fragility' },
	{ id: 'p2', short: 'Other connective tissue disorders excluded' },
	{ id: 'p3', short: 'Alternative causes of hypermobility excluded' },
];
const CUTOFF: Record<string, number> = { child: 6, adult: 5, over50: 4 };
const BAND_LABEL: Record<string, string> = { child: 'pre-pubertal children and adolescents', adult: 'pubertal adults up to 50', over50: 'adults over 50' };
const STEP_LABELS = ['Criterion 1', 'Feature A', 'Features B and C', 'Criterion 3'];

const form = document.getElementById('heds-form') as HTMLFormElement;
const steps = Array.from(document.querySelectorAll<HTMLElement>('.step'));
const totalSteps = steps.length;
const progressLabel = document.getElementById('progress-label') as HTMLElement;
const progressFill = document.getElementById('progress-fill') as HTMLElement;
const results = document.getElementById('results') as HTMLElement;
const fivepqBlock = document.getElementById('fivepq-block') as HTMLElement;
let currentStep = 0;

function getVal(name: string): string | null {
	const checked = form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
	return checked ? checked.value : null;
}
function flag(name: string) {
	const el = form.querySelector<HTMLElement>(`.q[data-q="${name}"]`);
	el?.classList.add('missing');
	el?.scrollIntoView({ behavior: 'smooth', block: 'center' });
	setTimeout(() => el?.classList.remove('missing'), 2500);
}

/* ---------- Beighton pickup ---------- */
try {
	const raw = localStorage.getItem('pvr-beighton-result');
	if (raw) {
		const saved = JSON.parse(raw) as { date: string; total: number; ageBand: string | null };
		const when = new Date(saved.date);
		const days = Math.floor((Date.now() - when.getTime()) / 86400000);
		const note = document.getElementById('beighton-saved') as HTMLElement;
		note.innerHTML = `You scored <strong>${saved.total} / 9</strong> on the Beighton tool ${days === 0 ? 'today' : days === 1 ? 'yesterday' : `${days} days ago`} on this device. It has been filled in below; change it if needed.`;
		note.hidden = false;
		const inp = form.querySelector<HTMLInputElement>(`input[name="beighton"][value="${saved.total}"]`);
		if (inp) inp.checked = true;
		const bandMap: Record<string, string> = { under18: 'child', adult: 'adult', over50: 'over50' };
		if (saved.ageBand && bandMap[saved.ageBand]) {
			const b = form.querySelector<HTMLInputElement>(`input[name="ageband"][value="${bandMap[saved.ageBand]}"]`);
			if (b) b.checked = true;
		}
	}
} catch { /* storage unavailable */ }
try {
	const raw = localStorage.getItem('pvr-5pq-result');
	if (raw) {
		const saved = JSON.parse(raw) as { answers: Record<string, number | null> };
		for (const [q, v] of Object.entries(saved.answers || {})) {
			if (v === null || v === undefined) continue;
			const inp = form.querySelector<HTMLInputElement>(`input[name="${q}"][value="${v}"]`);
			if (inp) inp.checked = true;
		}
	}
} catch { /* storage unavailable */ }

/* ---------- 5PQ visibility ---------- */
function needsFivePQ(): boolean {
	const band = getVal('ageband');
	const b = getVal('beighton');
	if (!band || b === null) return false;
	return parseInt(b, 10) === CUTOFF[band] - 1;
}
function syncFivePQ() {
	fivepqBlock.hidden = !needsFivePQ();
}
form.addEventListener('change', syncFivePQ);
syncFivePQ();

/* ---------- navigation ---------- */
function showStep(n: number) {
	currentStep = Math.max(0, Math.min(n, totalSteps - 1));
	steps.forEach(s => { s.hidden = parseInt(s.dataset.step || '0', 10) !== currentStep; });
	progressLabel.textContent = `Step ${currentStep + 1} of ${totalSteps}`;
	progressFill.style.width = `${((currentStep + 1) / (totalSteps + 1)) * 100}%`;
	window.scrollTo({ top: (form.getBoundingClientRect().top + window.scrollY) - 20, behavior: 'smooth' });
	if (currentStep > 0) trackStep(currentStep + 1, STEP_LABELS[currentStep]);
}

function validateStep(n: number): boolean {
	if (n === 0) {
		if (!getVal('ageband')) { flag('ageband'); return false; }
		if (getVal('beighton') === null) { flag('beighton'); return false; }
		if (needsFivePQ()) {
			for (const q of FIVE_PQ) if (getVal(q) === null) { flag(q); return false; }
		}
		return true;
	}
	if (n === 1) {
		for (const a of FEATURE_A) if (getVal(a.id) === null) { flag(a.id); return false; }
		return true;
	}
	if (n === 2) {
		if (getVal('famhx') === null) { flag('famhx'); return false; }
		for (const c of FEATURE_C) if (getVal(c.id) === null) { flag(c.id); return false; }
		return true;
	}
	if (n === 3) {
		for (const p of PREREQS) if (getVal(p.id) === null) { flag(p.id); return false; }
		if (getVal('actd') === null) { flag('actd'); return false; }
		return true;
	}
	return true;
}

form.querySelectorAll('[data-next]').forEach(btn => btn.addEventListener('click', () => {
	if (!validateStep(currentStep)) return;
	showStep(currentStep + 1);
}));
form.querySelectorAll('[data-prev]').forEach(btn => btn.addEventListener('click', () => showStep(currentStep - 1)));

/* ---------- scoring ---------- */
interface Outcome {
	band: string; beighton: number; cutoff: number; fivepqUsed: boolean; fivepqYes: number; c1: boolean;
	aYes: string[]; aNo: string[]; aUnknown: string[]; aMet: boolean; aPossible: boolean;
	famhx: string; bMet: boolean;
	cItems: string[]; cMet: boolean; actd: boolean;
	c2Met: boolean; c2Possible: boolean;
	pConfirmed: string[]; pNotMet: string[]; pUnassessed: string[]; c3Met: boolean; c3Blocked: boolean;
}

function evaluate(): Outcome {
	const band = getVal('ageband')!;
	const beighton = parseInt(getVal('beighton')!, 10);
	const cutoff = CUTOFF[band];
	const fivepqUsed = beighton === cutoff - 1;
	const fivepqYes = fivepqUsed ? FIVE_PQ.filter(q => getVal(q) === '1').length : 0;
	const c1 = beighton >= cutoff || (fivepqUsed && fivepqYes >= 2);

	const aYes = FEATURE_A.filter(a => getVal(a.id) === '1').map(a => a.short);
	const aNo = FEATURE_A.filter(a => getVal(a.id) === '0').map(a => a.short);
	const aUnknown = FEATURE_A.filter(a => getVal(a.id) === 'u').map(a => a.short);
	const aMet = aYes.length >= 5;
	const aPossible = !aMet && aYes.length + aUnknown.length >= 5;

	const famhx = getVal('famhx')!;
	const bMet = famhx === '1';

	const cItems = FEATURE_C.filter(c => getVal(c.id) === '1').map(c => c.short);
	const actd = getVal('actd') === '1';
	const cMet = !actd && cItems.length >= 1;

	let c2Met: boolean;
	let c2Possible: boolean;
	if (actd) {
		c2Met = aMet && bMet;
		c2Possible = !c2Met && (aMet || aPossible) && (bMet || famhx === 'u');
	} else {
		const met = [aMet, bMet, cMet].filter(Boolean).length;
		const possible = [aMet || aPossible, bMet || famhx === 'u', cMet].filter(Boolean).length;
		c2Met = met >= 2;
		c2Possible = !c2Met && possible >= 2;
	}

	const pConfirmed = PREREQS.filter(p => getVal(p.id) === '1').map(p => p.short);
	const pNotMet = PREREQS.filter(p => getVal(p.id) === '0').map(p => p.short);
	const pUnassessed = PREREQS.filter(p => getVal(p.id) === 'u').map(p => p.short);
	const c3Met = pConfirmed.length === 3;
	const c3Blocked = pNotMet.length > 0;

	return { band, beighton, cutoff, fivepqUsed, fivepqYes, c1, aYes, aNo, aUnknown, aMet, aPossible, famhx, bMet, cItems, cMet, actd, c2Met, c2Possible, pConfirmed, pNotMet, pUnassessed, c3Met, c3Blocked };
}

type Status = 'met' | 'notmet' | 'open';
function card(title: string, status: Status, line: string) {
	const label = status === 'met' ? 'Met' : status === 'notmet' ? 'Not met' : 'Needs a clinician';
	return `<div class="ccard ccard-${status}"><div class="ccard-status">${label}</div><h3>${title}</h3><p>${line}</p></div>`;
}
function list(items: string[]) { return items.length ? `<ul>${items.map(i => `<li>${i}</li>`).join('')}</ul>` : '<p class="none">None</p>'; }

let lastText = '';

form.addEventListener('submit', (e) => {
	e.preventDefault();
	if (!validateStep(currentStep)) return;
	const o = evaluate();

	let c1Line: string;
	if (o.beighton >= o.cutoff) c1Line = `Beighton ${o.beighton}/9 meets the cut-off of ${o.cutoff} or more for ${BAND_LABEL[o.band]}.`;
	else if (o.fivepqUsed && o.c1) c1Line = `Beighton ${o.beighton}/9 is one point below the cut-off of ${o.cutoff}, but ${o.fivepqYes} of 5 "yes" answers on the five-part questionnaire (2 or more needed) make up the difference.`;
	else if (o.fivepqUsed) c1Line = `Beighton ${o.beighton}/9 is one point below the cut-off of ${o.cutoff}, and ${o.fivepqYes} "yes" ${o.fivepqYes === 1 ? 'answer' : 'answers'} on the five-part questionnaire ${o.fivepqYes === 1 ? 'is' : 'are'} fewer than the 2 needed.`;
	else c1Line = `Beighton ${o.beighton}/9 is below the cut-off of ${o.cutoff} or more for ${BAND_LABEL[o.band]} by more than one point, so the five-part questionnaire cannot be applied.`;

	const aLine = o.aMet ? `Feature A met (${o.aYes.length} of 12 signs; 5 needed)` : o.aPossible ? `Feature A undecided (${o.aYes.length} present, ${o.aUnknown.length} unknown; 5 needed)` : `Feature A not met (${o.aYes.length} of 12 signs; 5 needed)`;
	const bLine = o.bMet ? 'Feature B met (first-degree relative meets the criteria)' : o.famhx === 'u' ? 'Feature B unknown' : 'Feature B not met';
	const cLine = o.actd ? 'Feature C cannot be counted because of an acquired connective tissue disorder' : o.cMet ? `Feature C met (${o.cItems.length} of 3)` : 'Feature C not met';
	const c2Line = `${aLine}. ${bLine}. ${cLine}. ${o.actd ? 'With an acquired connective tissue disorder, both A and B are required.' : 'Two of the three features are required.'}`;

	const c3Line = o.c3Met ? 'All three prerequisites confirmed by a clinician.' : o.c3Blocked ? `Not met: ${o.pNotMet.join('; ')}.` : `${o.pUnassessed.length} of 3 prerequisites not yet assessed. These exclusions can only be made by a clinician.`;

	const c2Status: Status = o.c2Met ? 'met' : o.c2Possible ? 'open' : 'notmet';
	const c3Status: Status = o.c3Met ? 'met' : o.c3Blocked ? 'notmet' : 'open';

	(document.getElementById('criteria-cards') as HTMLElement).innerHTML =
		card('Criterion 1: generalised joint hypermobility', o.c1 ? 'met' : 'notmet', c1Line) +
		card('Criterion 2: two or more of Features A, B, C', c2Status, c2Line) +
		card('Criterion 3: exclusions', c3Status, c3Line);

	let overall: string;
	if (o.c1 && o.c2Met && o.c3Met) {
		overall = 'As you have entered them, your answers satisfy all three of the 2017 criteria. That is the pattern hEDS requires, but the criteria are applied by a clinician who examines you, verifies the Feature A signs, and documents the exclusions. Take this summary to your GP, a rheumatologist, or a clinical geneticist.';
	} else if (o.c1 && o.c2Met) {
		overall = o.c3Blocked
			? 'Your answers meet Criteria 1 and 2, but you have recorded that one of the Criterion 3 prerequisites is not met. Under the 2017 framework that points away from hEDS and towards whichever condition explains the finding; a clinician needs to work through it.'
			: 'Your answers meet Criteria 1 and 2. What stands between this and a diagnosis is Criterion 3: a clinician excluding skin fragility, other connective tissue disorders, and alternative causes of hypermobility. This is a strong case for asking for an assessment.';
	} else if (o.c1 && o.c2Possible) {
		overall = `Your answers meet Criterion 1, and Criterion 2 depends on items you don't yet know: ${[...o.aUnknown, ...(o.famhx === 'u' ? ['family history'] : [])].join(', ')}. Those are the things to ask about at an appointment. If they turn out negative, symptomatic hypermobility that misses the hEDS criteria is described as a hypermobility spectrum disorder (HSD).`;
	} else if (o.c1) {
		overall = 'Your answers meet Criterion 1 (generalised joint hypermobility) but not Criterion 2, so they do not fit the 2017 hEDS criteria. If your hypermobility causes symptoms, the framework describes this as a hypermobility spectrum disorder (HSD), which is managed the same way. If you have historical hypermobility or pain that the questions above did not capture, mention it to your doctor.';
	} else {
		overall = 'Your answers do not meet Criterion 1, so under the 2017 criteria hEDS is not met regardless of the other features. Generalised joint hypermobility on the Beighton score is the entry point to the criteria. Localised or historical hypermobility, or hypermobility a clinician measures differently, can change this, so a low score here is not the final word.';
	}
	(document.getElementById('overall-summary') as HTMLElement).textContent = overall;

	(document.getElementById('detail') as HTMLElement).innerHTML = `
		<h3>Feature A signs you reported</h3>
		<div class="detail-grid">
			<div><h4>Present (${o.aYes.length})</h4>${list(o.aYes)}</div>
			<div><h4>Unknown (${o.aUnknown.length})</h4>${list(o.aUnknown)}</div>
		</div>
		<h3>Feature C items you reported</h3>${list(o.cItems)}
		${o.fivepqUsed ? `<h3>Five-part questionnaire</h3><p>${o.fivepqYes} of 5 answered "yes" (2 or more counts).</p>` : ''}
	`;

	lastText = [
		'hEDS 2017 criteria self-check (postviralrecovery.com/tools/heds-criteria/)',
		`Date: ${new Date().toLocaleDateString('en-GB')}`,
		'',
		`Criterion 1: ${o.c1 ? 'MET' : 'NOT MET'}. ${c1Line}`,
		`Criterion 2: ${c2Status === 'met' ? 'MET' : c2Status === 'open' ? 'UNDECIDED' : 'NOT MET'}. ${c2Line}`,
		`Criterion 3: ${c3Status === 'met' ? 'MET' : c3Status === 'open' ? 'NOT ASSESSED' : 'NOT MET'}. ${c3Line}`,
		'',
		`Feature A present: ${o.aYes.join('; ') || 'none'}`,
		`Feature A unknown: ${o.aUnknown.join('; ') || 'none'}`,
		`Feature C: ${o.cItems.join('; ') || 'none'}`,
		'',
		overall,
		'',
		'Self-reported. Not a diagnosis.',
	].join('\n');

	const subscores = {
		beighton: o.beighton,
		featurea: o.aYes.length,
		c1: o.c1 ? 1 : 0,
		c2: o.c2Met ? 1 : 0,
		c3: o.c3Met ? 1 : 0,
		c2open: c2Status === 'open' ? 1 : 0,
		c3open: c3Status === 'open' ? 1 : 0,
	};
	history.record({ total: null, subscores, band: hedsOutcome({ subscores }) });

	form.hidden = true;
	results.hidden = false;
	results.scrollIntoView({ behavior: 'smooth', block: 'start' });
	trackStep('results', 'Results');
});

document.getElementById('back-btn')?.addEventListener('click', () => {
	results.hidden = true;
	form.hidden = false;
	showStep(0);
});
document.getElementById('copy-btn')?.addEventListener('click', async () => {
	try {
		await navigator.clipboard.writeText(lastText);
		const c = document.getElementById('copy-confirm') as HTMLElement;
		c.hidden = false;
		setTimeout(() => { c.hidden = true; }, 2500);
	} catch { /* clipboard unavailable */ }
});
document.getElementById('print-btn')?.addEventListener('click', () => window.print());

showStep(0);
</script>

