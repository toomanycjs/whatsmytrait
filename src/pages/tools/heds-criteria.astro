	.criteria-cards :global(.ccard-notmet) { border-color: #b84a1e; background: #fdf0ea; }
	.criteria-cards :global(.ccard-notmet .ccard-status) { color: #b84a1e; }
	.criteria-cards :global(.ccard-open) { border-color: #7a3a8c; background: #f5eef8; }
	.criteria-cards :global(.ccard-open .ccard-status) { color: #7a3a8c; }

	.detail { font-size: 0.92em; }
	.detail :global(.detail-grid) { display: grid; grid-template-columns: 1fr 1fr; gap: 1em; }
	.detail :global(h4) { margin: 0.5em 0 0.3em; font-size: 0.95em; }
	.detail :global(ul) { margin: 0; padding-left: 1.2em; }
	.detail :global(li) { margin-bottom: 0.2em; }
	.detail :global(.none) { color: rgb(var(--gray)); margin: 0; }

	.results-disclaimer { font-size: 0.88em; color: rgb(var(--gray-dark)); border-top: 1px solid rgb(var(--gray-light)); padding-top: 1.5em; margin-top: 2em; line-height: 1.6; }
	.results-disclaimer h3 { font-size: 1em; color: rgb(var(--black)); margin-top: 0; margin-bottom: 0.5em; }
	.results-disclaimer a { color: var(--accent); }
	.export-buttons { display: flex; flex-wrap: wrap; gap: 0.6em; margin-top: 1.5em; }
	.copy-confirm { font-size: 0.85em; color: var(--accent); margin-top: 0.5em; }

	@media (max-width: 640px) {
		.criteria-cards { grid-template-columns: 1fr; }
		.detail :global(.detail-grid) { grid-template-columns: 1fr; }
		.segmented.ten { gap: 0.2em; max-width: none; }
		.segmented label { font-size: 0.8em; }
		.step-footer { gap: 0.5em; }
	}
	@media print {
		.export-buttons, .back-btn { display: none; }
	}
