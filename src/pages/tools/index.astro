---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const questionnaires = [
	{
		title: 'ME/CFS screening (DSQ-Brief)',
		description: 'A 4-question self-check for ME/CFS based on the DePaul Symptom Questionnaire Brief. Assesses fatigue and post-exertional malaise in under two minutes, with an immediate result.',
		href: '/tools/dsq-brief/',
		badge: 'Questionnaire',
	},
	{
		title: 'DePaul Symptom Questionnaire (DSQ-2)',
		description: 'The full ME/CFS symptom questionnaire across eight domains, with automatic scoring, a symptom profile, and screening against four case definitions (Fukuda, CCC, ME-ICC, IOM). Takes 10–15 minutes.',
		href: '/tools/dsq-2/',
		badge: 'Questionnaire',
	},
	{
		title: 'Post-exertional malaise (DSQ-PEM)',
		description: 'The DePaul PEM short form: 10 questions characterising whether your post-activity symptom pattern looks like post-exertional malaise, with recovery time and triggers assessed.',
		href: '/tools/dsq-pem/',
		badge: 'Questionnaire',
	},
	{
		title: 'FUNCAP functional capacity questionnaire',
		description: 'The patient-informed ME/CFS functional capacity instrument (FUNCAP27): 27 activities across 8 domains, scored by what each activity costs you. Includes a domain profile.',
		href: '/tools/funcap/',
		badge: 'Questionnaire',
	},
	{
		title: 'COMPASS-31',
		description: 'Composite Autonomic Symptom Score: 31-item autonomic symptom questionnaire covering six domains. The standard screening tool for dysautonomia symptoms.',
		href: '/tools/compass-31/',
		badge: 'Questionnaire',
	},
	{
		title: 'Malmö POTS Symptom Score (MAPS)',
		description: 'The first symptom score designed specifically for POTS: 12 symptoms from the past week rated 0–10, with the validated ≥42 threshold explained. Well suited to weekly tracking.',
		href: '/tools/malmo-pots-score/',
		badge: 'Questionnaire',
	},
	{
		title: 'Cognitive Failures Questionnaire (CFQ)',
		description: 'Broadbent\'s 25-item measure of everyday memory, attention, and action slips: the standard brain fog questionnaire. Scored out of 100 with three subscales and reference values from long COVID and ME/CFS cohorts.',
		href: '/tools/cognitive-failures-questionnaire/',
		badge: 'Questionnaire',
	},
	{
		title: 'Vanderbilt Orthostatic Symptom Score (VOSS)',
		description: 'Nine symptoms rated 0–10 while upright, as used in POTS drug and compression trials. A snapshot of orthostatic symptom burden that pairs with the NASA lean test.',
		href: '/tools/vanderbilt-orthostatic-symptom-score/',
		badge: 'Questionnaire',
	},
	{
		title: 'Orthostatic Grading Scale (OGS)',
		description: 'The Mayo Clinic five-item grading of orthostatic intolerance: frequency, severity, triggers, daily activities, and standing time, scored 0–20 with mild, moderate, and severe bands.',
		href: '/tools/orthostatic-grading-scale/',
		badge: 'Questionnaire',
	},
	{
		title: 'Nijmegen Questionnaire',
		description: '16-item breathing pattern disorder screening tool. Used to identify hyperventilation syndrome and disordered breathing patterns.',
		href: '/tools/nijmegen/',
		badge: 'Questionnaire',
	},
	{
		title: 'Chalder Fatigue Scale (CFQ-11)',
		description: 'The 11-item fatigue questionnaire used across UK ME/CFS and long COVID services. Get your Likert score (0–33) with physical and mental subscales, plus the bimodal score (0–11) and its ≥4 threshold.',
		href: '/tools/chalder-fatigue-scale/',
		badge: 'Questionnaire',
	},
	{
		title: 'Fatigue Severity Scale (FSS)',
		description: '9-item fatigue questionnaire widely used in post-viral and chronic illness research. Simple and quick to complete.',
		href: '/tools/fss/',
		badge: 'Questionnaire',
	},
	{
		title: 'Self-Evaluation of Breathing Questionnaire (SEBQ)',
		description: '25 statements about how your breathing feels, scored out of 75. The breathing-specific companion to the Nijmegen questionnaire, better suited to restricted or effortful breathing patterns.',
		href: '/tools/self-evaluation-of-breathing-questionnaire/',
		badge: 'Questionnaire',
	},
	{
		title: 'Epworth Sleepiness Scale',
		description: '8-item daytime sleepiness questionnaire. Simple, widely used, and commonly searched by people with fatigue-related conditions.',
		href: '/tools/epworth/',
		badge: 'Questionnaire',
	},
	{
		title: 'Bell CFIDS Disability Scale',
		description: 'Functional capacity scale from 0–100, widely referenced in ME/CFS and post-viral communities. Quick self-check for functional status.',
		href: '/tools/bell-scale/',
		badge: 'Questionnaire',
	},
	{
		title: 'Post-COVID-19 Functional Status scale (PCFS)',
		description: 'The standard long COVID functional grading: four quick questions give you a grade from 0 (no limitations) to 4 (severe limitations). Takes under a minute; designed for repeat tracking.',
		href: '/tools/pcfs/',
		badge: 'Questionnaire',
	},
	{
		title: 'RAND-36 health survey (SF-36 items)',
		description: 'The classic 36-item health-related quality of life survey, scored across eight scales. Compare your profile against published ME/CFS and long COVID cohorts.',
		href: '/tools/rand-36/',
		badge: 'Questionnaire',
	},
	{
		title: 'WHO-5 Well-Being Index',
		description: 'Five positively-worded questions about the past two weeks, scored 0–100. A light-touch well-being measure that pairs well with symptom and function tracking.',
		href: '/tools/who-5/',
		badge: 'Questionnaire',
	},
	{
		title: '2016 ACR Fibromyalgia Survey',
		description: 'Self-report fibromyalgia screening questionnaire with Widespread Pain Index, Symptom Severity Scale, and FS severity score. Based on the 2016 revised ACR criteria.',
		href: '/tools/fibromyalgia-survey/',
		badge: 'Questionnaire',
	},
	{
		title: 'Beighton Score',
		description: '9-point self-assessment for generalised joint hypermobility, with an illustration for each manoeuvre and the age-adjusted threshold explained. One component of the 2017 hypermobile EDS criteria.',
		href: '/tools/beighton-score/',
		badge: 'Questionnaire',
	},
	{
		title: 'Five-part questionnaire for hypermobility (5PQ)',
		description: 'Five yes/no questions that screen for generalised joint hypermobility, including hypermobility you used to have. Two or more "yes" answers is positive; used in the 2017 hEDS criteria when the Beighton score is one point short.',
		href: '/tools/five-part-questionnaire/',
		badge: 'Questionnaire',
	},
	{
		title: 'hEDS diagnostic criteria checker (2017)',
		description: 'Walk through the three criteria for hypermobile Ehlers-Danlos syndrome step by step: Beighton and 5PQ, the 12 Feature A signs, family history, musculoskeletal features, and the exclusions only a clinician can confirm.',
		href: '/tools/heds-criteria/',
		badge: 'Criteria checker',
	},
];

const guides = [
	{
		title: 'Exercise readiness screen',
		description: 'Three quick checks before starting any movement plan: red flags, post-exertional malaise, and relevant comorbidities. Routes you to the page that fits your situation.',
		href: '/tools/exercise-readiness/',
		badge: 'Interactive guide',
	},
	{
		title: 'Pacing and heart rate ceiling',
		description: 'The energy envelope in plain language, a resting-heart-rate-based ceiling with the arithmetic shown, counter-pressure manoeuvres, and a private session log.',
		href: '/tools/pacing-and-heart-rate/',
		badge: 'Interactive guide',
	},
	{
		title: 'Exercise progression for orthostatic intolerance',
		description: 'A hold-by-default record keeper informed by the CHOP modified Dallas programme and Levine\'s protocol. You pick the tier; it keeps the record and asks how you were 48 hours later.',
		href: '/tools/exercise-progression/',
		badge: 'Interactive guide',
	},
	{
		title: 'NASA Lean Test Guide',
		description: 'Interactive guide and timer for performing a poor man\'s tilt table test at home, with fields to log your HR readings at each stage.',
		href: '/tools/nasa-lean-test/',
		badge: 'Interactive guide',
	},
	{
		title: 'Which questionnaire should I take?',
		description: 'Not sure where to start? A plain-language guide to choosing the right post-viral self-assessment tool for your situation.',
		href: '/tools/which-questionnaire/',
		badge: 'Guide',
	},
];

const sheets = [
	{
		title: 'HRV & Resting Heart Rate Tracker',
		description: 'Daily logging with automatic weekly/monthly medians and trend charts. Compatible with Garmin, Apple Watch, Polar, and manual entry.',
		href: '/tools/trackers/hrv-tracker/',
		badge: 'Google Sheet',
	},
	{
		title: 'Symptom Diary',
		description: 'Daily scores for fatigue, breathlessness, head pain, and cognitive function with rolling averages. Useful for identifying patterns and tracking trends.',
		href: '/tools/trackers/symptom-diary/',
		badge: 'Google Sheet',
	},
	{
		title: 'Stand Test Logger',
		description: 'Record and track orthostatic heart rate responses over time. Log HR at baseline, 2 min, 5 min, and 10 min standing.',
		href: '/tools/trackers/stand-test-logger/',
		badge: 'Google Sheet',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Free post-viral symptom tools: questionnaires, trackers, and self-assessments"
			description="22 free interactive questionnaires with instant scoring: DSQ-2 and DSQ-PEM for ME/CFS, the Chalder Fatigue Scale, COMPASS-31, Malmö POTS score, VOSS and Orthostatic Grading Scale for dysautonomia, Beighton, 5PQ and the hEDS criteria for hypermobility, the Cognitive Failures Questionnaire for brain fog, SEBQ and Nijmegen for breathing, and more. Plus guides for pacing, heart rate ceilings, exercise readiness, and the NASA lean test."
		/>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.postviralrecovery.com/"},
    {"@type": "ListItem", "position": 2, "name": "Tools", "item": "https://www.postviralrecovery.com/tools/"}
  ]
}
</script>
	</head>
	<body>
		<Header />
		<main id="main">
			<div class="section-header">
				<span class="section-label tools">Tools</span>
				<h1>Tools</h1>
				<p class="section-intro">
					Free Google Sheets trackers and interactive versions of validated clinical questionnaires. The questionnaires let you complete them online and get a score with an explanation, something that's surprisingly hard to find for many of these instruments.
				</p>
				<div class="disclaimer">
					<strong>Note:</strong> These questionnaires are provided for informational and self-monitoring purposes. They are not diagnostic tools. Scores should be discussed with your doctor or specialist.
				</div>
			</div>

			<section>
				<h2>Interactive questionnaires</h2>
				<ul class="tool-list">
					{questionnaires.map(tool => (
						<li>
							<a href={tool.href} class="tool-card">
								<div class="tool-meta">
									<span class="tool-badge">{tool.badge}</span>
								</div>
								<h3>{tool.title}</h3>
								<p>{tool.description}</p>
							</a>
						</li>
					))}
				</ul>
			</section>

			<section>
				<h2>Interactive guides</h2>
				<p class="section-note">Guided tools rather than questionnaires: screens, timers, and record keepers that run entirely in your browser.</p>
				<ul class="tool-list">
					{guides.map(tool => (
						<li>
							<a href={tool.href} class="tool-card">
								<div class="tool-meta">
									<span class="tool-badge">{tool.badge}</span>
								</div>
								<h3>{tool.title}</h3>
								<p>{tool.description}</p>
							</a>
						</li>
					))}
				</ul>
			</section>

			<section>
				<h2>Google Sheets trackers</h2>
				<p class="section-note">Each tracker links to a page with more information and a link to the Google Sheet. Use File → Make a copy to get your own editable version.</p>
				<ul class="tool-list">
					{sheets.map(tool => (
						<li>
							<a href={tool.href} class="tool-card">
								<div class="tool-meta">
									<span class="tool-badge sheet">{tool.badge}</span>
								</div>
								<h3>{tool.title}</h3>
								<p>{tool.description}</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.section-header {
		padding-bottom: 1.5em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2em;
	}
	.section-header h1 { margin: 0.3em 0 0.3em; }
	.section-intro { color: rgb(var(--gray)); margin: 0 0 1em; }

	section { margin-bottom: 3em; }
	h2 { margin-bottom: 0.25em; }
	.section-note { color: rgb(var(--gray)); font-size: 0.9em; margin-bottom: 1.25em; }

	.tool-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75em;
	}
	.tool-card {
		display: block;
		padding: 1.1em 1.25em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 6px;
		text-decoration: none;
		height: 100%;
		box-sizing: border-box;
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.tool-card:hover {
		border-color: var(--accent);
		box-shadow: 0 0 0 3px var(--accent-light);
	}
	.tool-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.4em;
	}
	.tool-badge {
		font-size: 0.72em;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--tools);
		background: var(--tools-bg);
		padding: 0.15em 0.5em;
		border-radius: 3px;
	}
	.tool-badge.sheet {
		color: var(--testing);
		background: var(--testing-bg);
	}
	.external-icon {
		font-size: 0.9em;
		color: rgb(var(--gray));
	}
	.tool-card h3 {
		margin: 0 0 0.3em;
		font-size: 0.98em;
		color: rgb(var(--black));
		line-height: 1.3;
	}
	.tool-card p {
		margin: 0;
		font-size: 0.85em;
		color: rgb(var(--gray));
		line-height: 1.5;
	}

	@media (max-width: 580px) {
		.tool-list { grid-template-columns: 1fr; }
	}
</style>
