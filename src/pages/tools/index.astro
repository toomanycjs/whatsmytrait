---
import Page from '../../layouts/Page.astro';
import { GUIDE, KIND_LABEL, QUESTIONNAIRE_GROUPS, TRACKERS } from '../../tools/catalogue';

const toolCount = QUESTIONNAIRE_GROUPS.reduce((n, g) => n + g.tools.length, 0);
---

<Page
	title="Free post-viral symptom tools: questionnaires and trackers"
	description="Free questionnaires with an instant score, no sign-up, for ME/CFS, POTS, fatigue, breathing, brain fog and hypermobility, plus pacing guides and trackers."
>
	<div class="section-header">
		<span class="section-label tools">Tools</span>
		<h1>Questionnaires and tools</h1>
		<p class="section-intro">
			Interactive versions of validated clinical questionnaires, scored in your browser with the result explained, plus trackers for the numbers worth keeping. Nothing you enter is sent anywhere. {toolCount} questionnaires and guides, grouped by what they measure.
		</p>
		<p class="start">
			Not sure where to begin? <a href={GUIDE.href}>{GUIDE.title}</a>
			<span class="saved-results" hidden>· <a href="/tools/my-results/">Your saved results <span class="saved-count"></span></a></span>
		</p>
	</div>

	<nav class="contents" aria-label="On this page">
		<ol>
			{QUESTIONNAIRE_GROUPS.map((group, i) => (
				<li><a href={`#group-${i}`}>{group.name}</a></li>
			))}
			<li><a href="#trackers">Trackers</a></li>
		</ol>
	</nav>

	{QUESTIONNAIRE_GROUPS.map((group, i) => (
		<section class="group" aria-labelledby={`group-${i}`}>
			<h2 id={`group-${i}`}>{group.name}</h2>
			<ul class="tool-list">
				{group.tools.map(tool => (
					<li class="tool">
						<h3><a href={tool.href}>{tool.title}</a></h3>
						{tool.kind !== 'questionnaire' && <span class="kind">{KIND_LABEL[tool.kind]}</span>}
						<p>{tool.description}</p>
					</li>
				))}
			</ul>
		</section>
	))}

	<section class="group" aria-labelledby="trackers">
		<h2 id="trackers">Trackers</h2>
		<p class="section-note">The HRV tracker runs in your browser and keeps its data on your device. The others are Google Sheets templates: use File → Make a copy to get your own editable version.</p>
		<ul class="tool-list">
			{TRACKERS.map(tool => (
				<li class="tool">
					<h3><a href={tool.href}>{tool.title}</a></h3>
					<span class="kind">{KIND_LABEL[tool.kind]}</span>
					<p>{tool.description}</p>
				</li>
			))}
		</ul>
	</section>

	<aside class="tool-foot" aria-label="About these tools">
		<div class="disclaimer">
			<strong>Note:</strong> These questionnaires are provided for informational and self-monitoring purposes. They are not diagnostic tools. Scores should be discussed with your doctor or specialist.
		</div>
	</aside>
</Page>

<script>
	// Link to /tools/my-results/ with a count, shown only when this browser has saved results.
	import { readAll } from '../../scripts/results/resultsStore';
	const n = readAll().length;
	const link = document.querySelector<HTMLElement>('.saved-results');
	if (link && n > 0) {
		link.querySelector('.saved-count')!.textContent = `(${n})`;
		link.hidden = false;
	}
</script>

<style>
	.section-header {
		padding-bottom: 1.5em;
		border-bottom: 1px solid rgb(var(--gray-dark));
		margin-bottom: 1.5em;
	}
	.section-header h1 { margin: 0.2em 0 0.4em; }
	.section-intro { color: rgb(var(--gray-dark)); margin: 0 0 0.75em; text-wrap: pretty; }
	.start { margin: 0; font-size: 0.95em; }
	.saved-results { font-weight: 700; margin-left: 0.35em; }
	.saved-count { font-weight: 400; color: rgb(var(--gray)); }

	/* Contents: a compact numbered list of the groups */
	.contents { margin-bottom: 2.5em; font-size: 0.9em; }
	.contents ol {
		margin: 0;
		padding-left: 1.5em;
		columns: 2;
		column-gap: 2em;
	}
	.contents li { margin-bottom: 0.2em; break-inside: avoid; }
	.contents a { color: rgb(var(--gray-dark)); }
	.contents a:hover { color: var(--accent); }

	.group { margin-bottom: 2.75em; }
	.group h2 {
		font-size: 1.35em;
		margin: 0 0 0.25em;
		padding-bottom: 0.4em;
		border-bottom: 1px solid rgb(var(--gray-dark));
	}
	.section-note { color: rgb(var(--gray)); font-size: 0.9em; margin: 0.5em 0 0.25em; }

	.tool-list { list-style: none; margin: 0; padding: 0; }
	.tool {
		padding: 0.9em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin: 0;
	}
	.tool h3 {
		display: inline;
		font-size: 1.1em;
		margin: 0;
	}
	.tool h3 a { color: rgb(var(--black)); text-decoration: none; }
	.tool h3 a:hover { color: var(--accent); text-decoration: underline; }
	.kind {
		font-size: 0.8em;
		color: rgb(var(--gray));
		margin-left: 0.5em;
		white-space: nowrap;
	}
	.tool p {
		margin: 0.25em 0 0;
		font-size: 0.9em;
		color: rgb(var(--gray));
		line-height: 1.5;
	}

	@media (max-width: 600px) {
		.contents ol { columns: 1; }
	}
</style>
