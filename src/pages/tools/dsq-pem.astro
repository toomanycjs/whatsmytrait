---
import LastReviewed from '../../components/LastReviewed.astro';
import Page from '../../layouts/Page.astro';
import ScoreHistory from '../../components/ScoreHistory.astro';
import SharedResults from '../../components/SharedResults.astro';
import DsqPemInterpretation from '../../components/interpretation/DsqPem.astro';
import { FAQ, FAQ_ORDER } from '../../tools/dsq-pem.content';

const freqOptions = [
	{ value: 0, label: 'None of the time' },
	{ value: 1, label: 'A little of the time' },
	{ value: 2, label: 'Half of the time' },
	{ value: 3, label: 'Most of the time' },
	{ value: 4, label: 'All of the time' },
];
const sevOptions = [
	{ value: 0, label: 'Symptom not present' },
	{ value: 1, label: 'Mild' },
	{ value: 2, label: 'Moderate' },
	{ value: 3, label: 'Severe' },
	{ value: 4, label: 'Very severe' },
];

const items = [
	{ id: 'dead', text: 'A dead, heavy feeling after starting to exercise' },
	{ id: 'nextday', text: 'Next-day soreness or fatigue after non-strenuous, everyday activities' },
	{ id: 'mentaltired', text: 'Mentally tired after the slightest effort' },
	{ id: 'minexercise', text: 'A minimum of exercise makes you physically tired' },
	{ id: 'drained', text: 'Physically drained or sick after mild activity' },
];

const durationOptions = [
	'I do not feel worse after activities',
	'Less than 1 hour',
	'2–3 hours',
	'4–10 hours',
	'11–13 hours',
	'14–23 hours',
	'24 hours or more',
];

const faqs = FAQ_ORDER.map(k => FAQ[k]);

// Shown under the heading and used as the sitemap lastmod.
const lastReviewed = '2026-10-16';
---

<Page
	breadcrumb="Post-exertional malaise (DSQ-PEM)"
	faqs={faqs}
	title="Post-exertional malaise test: free DSQ-PEM questionnaire"
	description="Free post-exertional malaise (PEM) test with an instant score, no sign-up. The 10-question DePaul DSQ-PEM short form, with the ME/CFS thresholds explained."
>
			<div class="tool-header">
				<a href="/tools/" class="section-label tools">Tools</a>
				<h1>Post-exertional malaise questionnaire</h1>
				<LastReviewed date={lastReviewed} />
				<p class="subtitle">DSQ-PEM: the DePaul post-exertional malaise short form</p>
				<p class="description">
					<!-- REVIEW: rewritten to match the NICE NG206 description of PEM; the unsourced long COVID clause was removed. -->
					Post-exertional malaise (PEM) is a worsening of symptoms after physical or mental effort that is out of proportion to the effort. It is often delayed by hours or days, and recovery can take hours, days, weeks or longer. It is a core symptom of ME/CFS: the NICE guideline requires it before ME/CFS is diagnosed.
				</p>
				<p class="description">
					It also matters practically. If PEM is present, pushing through or steadily increasing activity can make things worse. Spotting it early changes how you approach recovery.
				</p>
				<p class="description">
					The <strong>DSQ-PEM</strong> is a 10-question short form of the DePaul Symptom Questionnaire, published by Cotler and colleagues in 2018. Five symptoms are rated for how often and how severely they occurred over the <strong>past six months</strong>. Five more questions ask about triggers and recovery time. <!-- REVIEW: 97% corrected: it came from an earlier study, not the 2018 one. -->In an earlier DePaul study of 704 people with ME/CFS, 97% reported at least one of the five symptoms at least half the time and at moderate severity or worse; in the 2018 study it was 99%. It takes about 3 minutes.
				</p>
				<p class="description">
					This tool sits between the <a href="/tools/dsq-brief/">4-question DSQ-Brief</a> (a general ME/CFS screen) and the full <a href="/tools/dsq-2/">DSQ-2</a> (a complete symptom assessment). If you want to check whether your post-activity pattern looks like PEM, this is the one to take.
				</p>
			</div>

			<form id="pem-form" novalidate>
				<h2 class="form-section-title">Part 1: Symptoms over the past six months</h2>
				<p class="form-instructions">Rate <strong>how often</strong> you have had each symptom and <strong>how severe</strong> it has been, over the past six months. If a symptom is absent, choose "None of the time" and severity will be set for you.</p>

				{items.map(item => (
					<div class="symptom" data-id={item.id}>
						<p class="symptom-text">{item.text}</p>
						<div class="ratings">
							<div class="rating-group">
								<span class="rating-label">How often</span>
								<div class="segmented">
									{freqOptions.map(opt => (
										<label title={opt.label}>
											<input type="radio" name={`${item.id}_f`} value={opt.value} />
											<span>{opt.label}</span>
										</label>
									))}
								</div>
							</div>
							<div class="rating-group">
								<span class="rating-label">How severe</span>
								<div class="segmented">
									{sevOptions.map(opt => (
										<label title={opt.label}>
											<input type="radio" name={`${item.id}_s`} value={opt.value} />
											<span>{opt.label}</span>
										</label>
									))}
								</div>
							</div>
						</div>
					</div>
				))}

				<h2 class="form-section-title">Part 2: Recovery and triggers</h2>

				<div class="symptom" data-id="quickrecovery">
					<p class="symptom-text">If you were to become exhausted after actively participating in extracurricular activities, sports, or outings with friends, would you recover within an hour or two after the activity ended?</p>
					<div class="segmented yesno">
						<label><input type="radio" name="quickrecovery" value="yes" /><span>Yes</span></label>
						<label><input type="radio" name="quickrecovery" value="no" /><span>No</span></label>
					</div>
				</div>

				<div class="symptom" data-id="physworse">
					<p class="symptom-text">Do you experience a worsening of your fatigue / energy-related illness after engaging in minimal physical effort?</p>
					<div class="segmented yesno">
						<label><input type="radio" name="physworse" value="yes" /><span>Yes</span></label>
						<label><input type="radio" name="physworse" value="no" /><span>No</span></label>
					</div>
				</div>

				<div class="symptom" data-id="mentworse">
					<p class="symptom-text">Do you experience a worsening of your fatigue / energy-related illness after engaging in mental effort?</p>
					<div class="segmented yesno">
						<label><input type="radio" name="mentworse" value="yes" /><span>Yes</span></label>
						<label><input type="radio" name="mentworse" value="no" /><span>No</span></label>
					</div>
				</div>

				<div class="symptom" data-id="duration">
					<p class="symptom-text">If you feel worse after activities, how long does this last?</p>
					<div class="segmented vertical">
						{durationOptions.map((opt, i) => (
							<label><input type="radio" name="duration" value={i} /><span>{opt}</span></label>
						))}
					</div>
				</div>

				<div class="symptom" data-id="noexercise">
					<p class="symptom-text">If you do not exercise, is it because exercise makes your symptoms worse?</p>
					<div class="segmented yesno wide">
						<label><input type="radio" name="noexercise" value="yes" /><span>Yes</span></label>
						<label><input type="radio" name="noexercise" value="no" /><span>No</span></label>
						<label><input type="radio" name="noexercise" value="na" /><span>Not applicable (I exercise)</span></label>
					</div>
				</div>

				<div class="form-footer">
					<button type="submit">Calculate my result</button>
					<button type="button" id="reset-btn">Clear all</button>
				</div>
			</form>

			<div id="results" class="results" hidden>
				<h2>Your DSQ-PEM result</h2>
				<div id="verdict" class="verdict"></div>
				<p id="score-interpretation" class="score-interp"></p>

				<h3>Symptom breakdown</h3>
				<table class="breakdown-table">
					<thead>
						<tr>
							<th>Symptom</th>
							<th>Frequency</th>
							<th>Severity</th>
							<th>Threshold met?</th>
						</tr>
					</thead>
					<tbody id="breakdown-rows"></tbody>
				</table>

				<h3>Recovery and trigger pattern</h3>
				<div id="pattern" class="pattern"></div>

				<div class="results-disclaimer">
					<!-- REVIEW: the scoring explanation and next steps moved to the "Understanding your DSQ-PEM result" section below; the unsourced claim about ordinary fatigue resolving within a few hours was removed. -->
					<p>How the result is worked out, and what to take to your GP, is explained <a href="#understanding-dsq-pem">below the results</a>.</p>
					<p>Your headline result is saved on this device only, never sent anywhere, so that the <a href="/tools/exercise-readiness/">exercise readiness screen</a> can pick it up automatically.</p>
					<p><strong>This is not a diagnosis.</strong> It reflects the symptom pattern you have reported. Discuss your results with your doctor or specialist.</p>
				</div>

				<ScoreHistory toolId="dsq-pem" toolName="DSQ-PEM" />

				<button type="button" id="back-btn" class="back-btn">Edit answers</button>
			</div>

			<SharedResults toolId="dsq-pem" />

			<DsqPemInterpretation>
				<div class="disclaimer" slot="disclaimer"><strong>This is not a diagnostic tool.</strong> A positive result means your reported pattern is consistent with PEM, not that you have ME/CFS or any other condition. Discuss your results with your doctor.</div>
				<p class="citation" slot="citation">Based on: Cotler J, Holtzman C, Dudun C, Jason LA. <em>A Brief Questionnaire to Assess Post-Exertional Malaise.</em> Diagnostics. 2018;8(3):66. DePaul University makes the DSQ instruments free to use.</p>
			</DsqPemInterpretation>
</Page>

<script>
import { dsqPem, dsqPemOutcome } from '../../tools/dsq-pem';
import { mountScoreHistory, mountSharedResults } from '../../scripts/results/scoreHistory';

const history = mountScoreHistory(dsqPem);
mountSharedResults(dsqPem);

const ITEMS = [
	{ id: 'dead', text: 'A dead, heavy feeling after starting to exercise' },
	{ id: 'nextday', text: 'Next-day soreness or fatigue after non-strenuous, everyday activities' },
	{ id: 'mentaltired', text: 'Mentally tired after the slightest effort' },
	{ id: 'minexercise', text: 'A minimum of exercise makes you physically tired' },
	{ id: 'drained', text: 'Physically drained or sick after mild activity' },
];
const FREQ_LABELS = ['None of the time', 'A little of the time', 'Half of the time', 'Most of the time', 'All of the time'];
const SEV_LABELS = ['Not present', 'Mild', 'Moderate', 'Severe', 'Very severe'];
const DURATION_LABELS = [
	'I do not feel worse after activities',
	'Less than 1 hour',
	'2–3 hours',
	'4–10 hours',
	'11–13 hours',
	'14–23 hours',
	'24 hours or more',
];

const form = document.getElementById('pem-form') as HTMLFormElement;
const results = document.getElementById('results') as HTMLElement;

function getVal(name: string): string | null {
	const checked = form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
	return checked ? checked.value : null;
}
function getNum(name: string): number | null {
	const v = getVal(name);
	return v === null ? null : parseInt(v, 10);
}

// Auto-set severity to 0 when frequency is 0.
form.addEventListener('change', (e) => {
	const target = e.target as HTMLInputElement;
	if (!target?.name?.endsWith('_f')) return;
	const id = target.name.slice(0, -2);
	const sevGroup = form.querySelector(`.symptom[data-id="${id}"] .rating-group:last-child .segmented`);
	if (!sevGroup) return;
	if (getNum(`${id}_f`) === 0) {
		const zero = form.querySelector<HTMLInputElement>(`input[name="${id}_s"][value="0"]`);
		if (zero) zero.checked = true;
		sevGroup.classList.add('auto-zero');
	} else {
		sevGroup.classList.remove('auto-zero');
	}
});

function flagMissing(id: string) {
	const el = form.querySelector<HTMLElement>(`.symptom[data-id="${id}"]`);
	el?.classList.add('missing');
	el?.scrollIntoView({ behavior: 'smooth', block: 'center' });
	setTimeout(() => el?.classList.remove('missing'), 2500);
}

form.addEventListener('submit', (e) => {
	e.preventDefault();

	for (const item of ITEMS) {
		if (getNum(`${item.id}_f`) === null || getNum(`${item.id}_s`) === null) { flagMissing(item.id); return; }
	}
	for (const name of ['quickrecovery', 'physworse', 'mentworse', 'duration', 'noexercise']) {
		if (getVal(name) === null) { flagMissing(name); return; }
	}

	const rows = ITEMS.map(item => {
		const f = getNum(`${item.id}_f`)!;
		const s = getNum(`${item.id}_s`)!;
		return { item, f, s, met: f >= 2 && s >= 2 };
	});
	const metCount = rows.filter(r => r.met).length;
	const pemIndicated = metCount >= 1;

	// Save the headline result on this device so the exercise readiness screen
	// can pick it up. Nothing is sent anywhere.
	try {
		localStorage.setItem('pvr-dsq-pem-result', JSON.stringify({ date: new Date().toISOString(), pemIndicated }));
	} catch { /* storage unavailable; the tool still works */ }

	const physworse = getVal('physworse') === 'yes';
	const mentworse = getVal('mentworse') === 'yes';
	const quickrecovery = getVal('quickrecovery') === 'yes';
	const noexercise = getVal('noexercise');
	const duration = getNum('duration')!;
	const longRecovery = duration >= 5; // 14-23 hours or 24+ hours

	const verdict = document.getElementById('verdict') as HTMLElement;
	verdict.className = `verdict ${pemIndicated ? 'positive' : 'negative'}`;
	verdict.textContent = pemIndicated
		? `PEM indicated: ${metCount} of 5 symptoms met the threshold`
		: 'PEM not indicated: no symptom met the threshold';

	// REVIEW: Layer 1 copy, following the two scoring steps in Cotler et al. 2018,
	// Appendix B. interpretResult adds nothing here: there is no total, no bands
	// and no published minimal important change, so the page writes it all.
	// "lasting 2–3 hours" etc. reads correctly with every duration label except
	// the first, which is handled on its own.
	const effort = physworse && mentworse ? 'physical and mental' : physworse ? 'physical' : 'mental';
	const lasting = DURATION_LABELS[duration].toLowerCase();
	let interp = '';
	if (pemIndicated) {
		interp = `${metCount === 1 ? 'One of the five PEM symptoms' : metCount === 5 ? 'All five PEM symptoms' : `${['', '', 'Two', 'Three', 'Four'][metCount]} of the five PEM symptoms`} occurred at least half the time at moderate or worse severity over the past six months, so step 1 of the scoring indicates PEM. `;
		if ((physworse || mentworse) && longRecovery) {
			interp += `You also report worsening after minimal ${effort} effort, lasting ${lasting}: in the published scoring, that combination is the pattern that points to ME/CFS rather than the other illnesses it was compared with.`;
		} else if ((physworse || mentworse) && duration === 0) {
			interp += `You report worsening after minimal ${effort} effort, but also that you do not feel worse after activities; check that answer, because how long the worsening lasts is the most informative question here.`;
		} else if (physworse || mentworse) {
			interp += `You report worsening after minimal ${effort} effort, lasting ${lasting}. The published scoring looks for worsening that lasts 14 hours or more, so that part is not met, but the pattern is worth tracking.`;
		} else {
			interp += 'You did not report worsening after minimal physical or mental effort, so step 2 of the scoring is not met. If larger efforts set you off, track the pattern over a few weeks.';
		}
		if (noexercise === 'yes') {
			interp += ' You also avoid exercise because it makes your symptoms worse, which is useful for a clinician to know.';
		}
	} else {
		interp = 'None of the five PEM symptoms met the threshold of at least half the time and at least moderate over the past six months. ';
		if (!quickrecovery || physworse || mentworse) {
			interp += 'Some of your other answers still point to slow recovery or worsening after effort; if that is affecting your life, track activity and symptoms for a few weeks and discuss the pattern with your doctor.';
		} else {
			interp += 'Your answers about recovery do not suggest PEM either. If fatigue is still a problem, the Fatigue Severity Scale measures its impact on daily life.';
		}
	}
	(document.getElementById('score-interpretation') as HTMLElement).textContent = interp;

	(document.getElementById('breakdown-rows') as HTMLElement).innerHTML = rows.map(r => `
		<tr>
			<td>${r.item.text}</td>
			<td>${FREQ_LABELS[r.f]}</td>
			<td>${SEV_LABELS[r.s]}</td>
			<td>${r.met ? '<strong>Yes</strong>' : 'No'}</td>
		</tr>
	`).join('');

	(document.getElementById('pattern') as HTMLElement).innerHTML = [
		{ q: 'Recovers within an hour or two of exhausting activity', a: quickrecovery ? 'Yes' : 'No' },
		{ q: 'Worse after minimal physical effort', a: physworse ? 'Yes' : 'No' },
		{ q: 'Worse after mental effort', a: mentworse ? 'Yes' : 'No' },
		{ q: 'How long the worsening lasts', a: DURATION_LABELS[duration] },
		{ q: 'Avoids exercise because it worsens symptoms', a: noexercise === 'na' ? 'Not applicable' : noexercise === 'yes' ? 'Yes' : 'No' },
	].map(row => `
		<div class="pattern-row">
			<span class="pattern-q">${row.q}</span>
			<span class="pattern-a">${row.a}</span>
		</div>
	`).join('');

	const subscores = {
		symptoms: metCount,
		longrecovery: longRecovery ? 1 : 0,
		pem: pemIndicated ? 1 : 0,
		physical: physworse ? 1 : 0,
		mental: mentworse ? 1 : 0,
	};
	history.record({ total: null, subscores, band: dsqPemOutcome({ subscores }) });

	form.hidden = true;
	results.hidden = false;
	results.scrollIntoView({ behavior: 'smooth', block: 'start' });
});

document.getElementById('reset-btn')?.addEventListener('click', () => {
	form.reset();
	form.querySelectorAll('.segmented.auto-zero').forEach(el => el.classList.remove('auto-zero'));
});
document.getElementById('back-btn')?.addEventListener('click', () => {
	results.hidden = true;
	form.hidden = false;
	form.scrollIntoView({ behavior: 'smooth', block: 'start' });
});
</script>

<style>
	.tool-header {
		padding-bottom: 1.5em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2em;
	}
	.tool-header h1 { margin: 0.3em 0 0.1em; }
	.subtitle { color: rgb(var(--gray)); font-size: 1.05em; margin: 0 0 0.75em; }
	.description { margin-bottom: 1em; }

	.form-section-title { font-size: 1.2em; margin: 1.5em 0 0.4em; }
	.form-instructions {
		font-size: 0.88em;
		color: rgb(var(--gray-dark));
		border-radius: 3px;
		padding: 0.7em 1.1em;
		margin-bottom: 1.25em;
		border: 1px solid rgb(var(--gray-light));
	}

	.symptom {
		border-top: 1px solid rgb(var(--gray-light));
		padding: 1.1em 0;
		margin-bottom: 0.85em;
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.symptom.missing { border-color: #c0392b; box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.12); }
	.symptom-text { margin: 0 0 0.9em; font-weight: 700; font-size: 0.98em; line-height: 1.4; }
	.ratings { display: flex; flex-direction: column; gap: 0.8em; }
	.rating-group { display: flex; flex-direction: column; gap: 0.35em; }
	.rating-label { font-size: 0.75em; font-weight: 700; color: rgb(var(--gray)); }

	.segmented { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.35em; }
	.segmented.yesno { grid-template-columns: repeat(2, minmax(0, 8em)); }
	.segmented.yesno.wide { grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 30em; }
	.segmented.vertical { grid-template-columns: 1fr; gap: 0.5em; max-width: 24em; }
	.segmented label {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		font-size: 0.82em;
		line-height: 1.2;
		padding: 0.5em 0.3em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 3px;
		cursor: pointer;
		transition: background 0.1s, border-color 0.1s;
		min-height: 2.6em;
	}
	.segmented.vertical label { justify-content: flex-start; text-align: left; padding: 0.6em 1em; min-height: 0; font-size: 0.9em; }
	.segmented label:hover { border-color: var(--accent); }
	.segmented input { position: absolute; opacity: 0; width: 0; height: 0; }
	.segmented label:has(input:checked) { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 700; }
	.segmented.auto-zero { opacity: 0.55; }

	.form-footer { display: flex; gap: 1em; padding: 1.75em 0 1em; }
	button[type="submit"] {
		background: var(--accent); color: #fff; border: none;
		padding: 0.75em 2em; border-radius: 3px; font-size: 1em; font-weight: 700;
		cursor: pointer; font-family: inherit;
	}
	button[type="submit"]:hover { background: var(--accent-dark); }
	button[type="button"] {
		background: none; border: 1px solid rgb(var(--gray-light));
		padding: 0.75em 1.5em; border-radius: 3px; font-size: 0.95em;
		cursor: pointer; color: rgb(var(--gray)); font-family: inherit;
	}

	/* Results */
	.results { padding-top: 1em; }
	.results h2 { margin-bottom: 0.75em; }
	.results h3 { margin-top: 1.75em; margin-bottom: 0.5em; }
	.verdict {
		font-size: 1.1em;
		font-weight: 700;
		display: block;
		padding: 0;
		margin: 0 0 0.75em;
	}
	.verdict.positive { color: #9a5b13; }
	.verdict.negative { color: #1e6b3c; }
	.score-interp {
		font-size: 1em; line-height: 1.6; margin: 0 0 1em;
		padding: 0;
	}
	.breakdown-table { margin: 0.5em 0 1em; font-size: 0.88em; }

	.pattern { display: flex; flex-direction: column; }
	/* Injected by script: anchor to the static .pattern container. */
	.pattern :global(.pattern-row) {
		display: flex; justify-content: space-between; gap: 1em;
		padding: 0.55em 0; border-bottom: 1px solid rgb(var(--gray-light));
		font-size: 0.92em;
	}
	.pattern :global(.pattern-q) { color: rgb(var(--gray-dark)); }
	.pattern :global(.pattern-a) { font-weight: 700; white-space: nowrap; }

	.results-disclaimer {
		font-size: 0.88em; color: rgb(var(--gray-dark));
		border-top: 1px solid rgb(var(--gray-light)); padding-top: 1.5em;
		margin-top: 2em; line-height: 1.6;
	}
	.results-disclaimer h3 { font-size: 1em; color: rgb(var(--black)); margin-top: 0; margin-bottom: 0.5em; }
	.results-disclaimer a { color: var(--accent); }
	.back-btn {
		background: none; border: 1px solid rgb(var(--gray-light));
		padding: 0.6em 1.25em; border-radius: 3px; font-size: 0.95em;
		cursor: pointer; color: rgb(var(--gray)); font-family: inherit;
		margin-top: 1.5em;
	}
	.back-btn:hover { border-color: var(--accent); color: var(--accent); }

	@media (max-width: 600px) {
		.symptom { padding: 0.9em 0; }
		.segmented { gap: 0.25em; }
		.segmented label { font-size: 0.72em; padding: 0.45em 0.15em; min-height: 3em; }
		.segmented.vertical label { font-size: 0.85em; min-height: 0; }
		.pattern :global(.pattern-row) { flex-direction: column; gap: 0.15em; }
		.pattern :global(.pattern-a) { white-space: normal; }
	}
</style>
