---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const scaleItems = [
	{ value: 100, description: 'No symptoms at rest or with exercise. Normal overall activity. Able to work full-time without difficulty.' },
	{ value: 90, description: 'No symptoms at rest. Mild symptoms with exercise. Normal activity. Able to work full-time with some difficulty.' },
	{ value: 80, description: 'Mild symptoms at rest. Symptoms worsened by exercise. Reduced activity level. Able to work full-time with difficulty.' },
	{ value: 70, description: 'Mild to moderate symptoms at rest. Some daily activity reduced. Able to work part-time or full-time with significant difficulty.' },
	{ value: 60, description: 'Moderate symptoms at rest. Daily activity reduced to 70–80% of expected. Unable to work full-time. Difficulty with most tasks.' },
	{ value: 50, description: 'Moderate symptoms at rest. Daily activity reduced to 50–70%. Unable to perform strenuous duties. Able to do light work 4–5 hours a day.' },
	{ value: 40, description: 'Moderate symptoms at rest. Daily activity limited. Unable to do strenuous work. Able to do light work 3–4 hours a day with rest periods. Mostly housebound.' },
	{ value: 30, description: 'Moderate to severe symptoms at rest. Able to do only light tasks. Housebound most of the time. Unable to do concentrated effort.' },
	{ value: 20, description: 'Moderate to severe symptoms. Unable to carry out most daily activities. Housebound most of the time. Occasional short outings.' },
	{ value: 10, description: 'Severe symptoms. Bedridden most of the time. Cognitive symptoms limiting ability to read or converse.' },
	{ value: 0, description: 'Severe symptoms on a continuous basis. Bedridden and unable to care for self.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Bell CFIDS Disability Scale — free online functional capacity assessment"
			description="Complete the Bell CFIDS Disability Scale online for free. A quick functional capacity rating from 0 to 100 used in ME/CFS and post-viral communities. Instant result with interpretation."
		/>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.postviralrecovery.com/"},
        {"@type": "ListItem", "position": 2, "name": "Tools", "item": "https://www.postviralrecovery.com/tools/"},
        {"@type": "ListItem", "position": 3, "name": "Bell CFIDS Disability Scale", "item": "https://www.postviralrecovery.com/tools/bell-scale/"}
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What does the Bell CFIDS Disability Scale measure?",
          "acceptedAnswer": {"@type": "Answer", "text": "The Bell CFIDS Disability Scale is a 0–100 functional capacity rating used in ME/CFS and post-viral communities. Higher scores indicate better functioning. It is designed as a quick, repeatable snapshot of overall activity level and symptom impact."}
        }
      ]
    }
  ]
}
</script>
	</head>
	<body>
		<Header />
		<main>
			<div class="tool-header">
				<a href="/tools" class="section-label tools">Tools</a>
				<h1>Bell CFIDS Disability Scale</h1>
				<p class="subtitle">Functional Capacity Rating 0–100</p>
				<p class="description">
  The Bell CFIDS Disability Scale is a functional capacity rating developed by Dr David Bell, a clinician and researcher who spent decades working with ME/CFS patients. It provides a single score from 0 to 100 that describes your overall level of functioning and activity limitation, where 100 represents no symptoms and full normal activity, and 0 represents severe symptoms with the patient bedridden and unable to care for themselves.
</p>
<p class="description">
  Unlike multi-item questionnaires, the Bell scale works by asking you to select the description that best matches your current level of functioning. This makes it very quick to complete and easy to understand. It is widely referenced in ME/CFS patient communities and advocacy literature, and is sometimes used informally alongside more formal instruments like the FSS.
</p>
<p class="description">
  The Bell scale is particularly useful as a simple, repeatable snapshot of functional status. Because it takes only a minute to complete, it lends itself to regular tracking. Many people with post-viral conditions use it weekly or monthly to maintain a record of their overall trajectory.
</p>
<p class="description">
  This is a free, interactive version. Select the description that best fits your current situation and see your score immediately. No sign-up or email is required.
</p>
<div class="disclaimer">
  <strong>This is not a diagnostic tool.</strong> Your score is a self-assessed measure of functional capacity and does not constitute a clinical diagnosis. Discuss your results with your doctor.
</div>
			</div>

			<form id="bell-form" novalidate>
				<p class="form-instructions">Select the description that best matches your current overall level of functioning:</p>

				<div class="scale-list">
					{scaleItems.map(item => (
						<label class="scale-item">
							<input type="radio" name="bell" value={item.value} required />
							<div class="scale-item-content">
								<span class="scale-score">{item.value}</span>
								<span class="scale-description">{item.description}</span>
							</div>
						</label>
					))}
				</div>

				<div class="form-footer">
					<button type="submit">See my score</button>
					<button type="button" id="reset-btn">Clear</button>
				</div>
			</form>

			<div id="results" class="results" hidden>
				<h2>Your Bell CFIDS Disability Scale score</h2>
				<div class="total-score">
					<span id="total-score-value">—</span>
					<span class="total-score-label">out of 100</span>
				</div>
				<p id="score-description" class="score-description-text"></p>

				<div class="results-disclaimer">
  <h3>Understanding your score</h3>
  <p>The Bell CFIDS Disability Scale runs from 0 to 100 in increments of 10. Each level has a specific description of symptom severity and functional capacity. Higher scores indicate better functioning.</p>
  <p>The scale is most useful as a tracking tool. Noting your score at regular intervals gives you a record that can reveal gradual improvement or decline that might not be obvious day to day. A sustained shift of 10 or more points is generally considered meaningful.</p>
  <p>This is a self-assessed measure of functional capacity. It is not a clinical diagnosis or measurement. Discuss your results with your doctor.</p>
</div>

				<button type="button" id="back-btn" class="back-btn">Edit selection</button>
			</div>
		</main>
		<Footer />
	</body>
</html>

<script>
	const SCALE_ITEMS: { value: number; description: string }[] = [
		{ value: 100, description: 'No symptoms at rest or with exercise. Normal overall activity. Able to work full-time without difficulty.' },
		{ value: 90, description: 'No symptoms at rest. Mild symptoms with exercise. Normal activity. Able to work full-time with some difficulty.' },
		{ value: 80, description: 'Mild symptoms at rest. Symptoms worsened by exercise. Reduced activity level. Able to work full-time with difficulty.' },
		{ value: 70, description: 'Mild to moderate symptoms at rest. Some daily activity reduced. Able to work part-time or full-time with significant difficulty.' },
		{ value: 60, description: 'Moderate symptoms at rest. Daily activity reduced to 70–80% of expected. Unable to work full-time. Difficulty with most tasks.' },
		{ value: 50, description: 'Moderate symptoms at rest. Daily activity reduced to 50–70%. Unable to perform strenuous duties. Able to do light work 4–5 hours a day.' },
		{ value: 40, description: 'Moderate symptoms at rest. Daily activity limited. Unable to do strenuous work. Able to do light work 3–4 hours a day with rest periods. Mostly housebound.' },
		{ value: 30, description: 'Moderate to severe symptoms at rest. Able to do only light tasks. Housebound most of the time. Unable to do concentrated effort.' },
		{ value: 20, description: 'Moderate to severe symptoms. Unable to carry out most daily activities. Housebound most of the time. Occasional short outings.' },
		{ value: 10, description: 'Severe symptoms. Bedridden most of the time. Cognitive symptoms limiting ability to read or converse.' },
		{ value: 0, description: 'Severe symptoms on a continuous basis. Bedridden and unable to care for self.' },
	];

	const form = document.getElementById('bell-form') as HTMLFormElement;
	const results = document.getElementById('results') as HTMLElement;
	const totalEl = document.getElementById('total-score-value') as HTMLElement;
	const descEl = document.getElementById('score-description') as HTMLElement;

	form.addEventListener('submit', (e) => {
		e.preventDefault();

		const checked = document.querySelector<HTMLInputElement>('input[name="bell"]:checked');
		if (!checked) {
			alert('Please select a description before continuing.');
			return;
		}

		const value = parseInt(checked.value);
		const item = SCALE_ITEMS.find(s => s.value === value);

		totalEl.textContent = String(value);
		descEl.textContent = item ? item.description : '';

		form.hidden = true;
		results.hidden = false;
		results.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});

	document.getElementById('reset-btn')?.addEventListener('click', () => form.reset());

	document.getElementById('back-btn')?.addEventListener('click', () => {
		results.hidden = true;
		form.hidden = false;
		form.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});
</script>

<style>
	.tool-header {
		padding-bottom: 1.5em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2.5em;
	}
	.tool-header h1 { margin: 0.3em 0 0.1em; }
	.subtitle { color: rgb(var(--gray)); font-size: 1.05em; margin: 0 0 0.75em; }

	.form-instructions {
		color: rgb(var(--gray));
		font-style: italic;
		margin-bottom: 1.5em;
		font-size: 0.95em;
	}

	.scale-list {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.scale-item {
		display: flex;
		align-items: flex-start;
		gap: 0;
		cursor: pointer;
		padding: 0.9em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
		transition: background 0.1s;
	}
	.scale-item:has(input:checked) {
		background: var(--accent-light);
		border-radius: 4px;
		padding-left: 0.5em;
		padding-right: 0.5em;
	}
	.scale-item input[type="radio"] { display: none; }

	.scale-item-content {
		display: flex;
		gap: 1em;
		align-items: flex-start;
		width: 100%;
	}
	.scale-score {
		font-size: 1.4em;
		font-weight: 700;
		color: var(--accent);
		min-width: 2.5em;
		line-height: 1.3;
	}
	.scale-item:has(input:checked) .scale-score {
		color: var(--accent-dark);
	}
	.scale-description {
		font-size: 0.93em;
		line-height: 1.5;
		color: rgb(var(--gray-dark));
	}
	.scale-item:has(input:checked) .scale-description {
		color: rgb(var(--black));
		font-weight: 600;
	}

	.form-footer {
		display: flex;
		gap: 1em;
		padding: 2em 0 1em;
	}
	button[type="submit"] {
		background: var(--accent);
		color: #fff;
		border: none;
		padding: 0.75em 2em;
		border-radius: 5px;
		font-size: 1em;
		font-weight: 700;
		cursor: pointer;
		font-family: inherit;
	}
	button[type="submit"]:hover { background: var(--accent-dark); }
	button[type="button"] {
		background: none;
		border: 1px solid rgb(var(--gray-light));
		padding: 0.75em 1.5em;
		border-radius: 5px;
		font-size: 0.95em;
		cursor: pointer;
		color: rgb(var(--gray));
		font-family: inherit;
	}

	/* Results */
	.results { padding-top: 1em; }
	.results h2 { margin-bottom: 0.5em; }
	.total-score {
		display: flex;
		align-items: baseline;
		gap: 0.5em;
		margin: 1em 0;
	}
	#total-score-value {
		font-size: 3.5em;
		font-weight: 700;
		color: var(--accent);
		line-height: 1;
	}
	.total-score-label { color: rgb(var(--gray)); font-size: 1.1em; }
	.score-description-text {
		font-size: 1em;
		line-height: 1.6;
		margin: 0 0 2em;
		padding: 1em 1.25em;
		background: var(--accent-light);
		border-left: 4px solid var(--accent);
		border-radius: 4px;
	}
	.results-disclaimer {
		font-size: 0.88em;
		color: rgb(var(--gray-dark));
		border-top: 1px solid rgb(var(--gray-light));
		padding-top: 1.5em;
		line-height: 1.6;
	}
	.results-disclaimer h3 { font-size: 1em; color: rgb(var(--black)); margin-bottom: 0.5em; }
	.back-btn {
		background: none;
		border: 1px solid rgb(var(--gray-light));
		padding: 0.6em 1.25em;
		border-radius: 5px;
		font-size: 0.95em;
		cursor: pointer;
		color: rgb(var(--gray));
		font-family: inherit;
		margin-top: 1em;
	}
	.back-btn:hover { border-color: var(--accent); color: var(--accent); }

	@media (max-width: 600px) {
		.form-footer { flex-direction: column; }
	}
</style>
