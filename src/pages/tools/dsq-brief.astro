---
import LastReviewed from '../../components/LastReviewed.astro';
import Page from '../../layouts/Page.astro';
import ScoreHistory from '../../components/ScoreHistory.astro';
import SharedResults from '../../components/SharedResults.astro';
import DsqBriefInterpretation from '../../components/interpretation/DsqBrief.astro';
import { FAQ, FAQ_ORDER } from '../../tools/dsq-brief.content';

const freqOptions = [
	{ value: 0, short: 'None of the time', full: 'None of the time' },
	{ value: 1, short: 'A little of the time', full: 'A little of the time' },
	{ value: 2, short: 'Half of the time', full: 'Half of the time' },
	{ value: 3, short: 'Most of the time', full: 'Most of the time' },
	{ value: 4, short: 'All of the time', full: 'All of the time' },
];
const sevOptions = [
	{ value: 0, short: 'Symptom not present', full: 'Symptom not present' },
	{ value: 1, short: 'Mild', full: 'Mild' },
	{ value: 2, short: 'Moderate', full: 'Moderate' },
	{ value: 3, short: 'Severe', full: 'Severe' },
	{ value: 4, short: 'Very severe', full: 'Very severe' },
];

// REVIEW: item wording now matches DePaul's published DSQ-Brief form. Items 3
// and 4 were previously two post-exertional malaise items from the DSQ-PEM,
// which are not in the DSQ-Brief. Keep in step with ITEMS in the script below.
const items = [
	{ id: 'fatigue', text: 'Fatigue/extreme tiredness' },
	{ id: 'minexercise', text: 'Minimum exercise makes you physically tired' },
	{ id: 'unrefreshed', text: 'Feeling unrefreshed after you wake up in the morning' },
	{ id: 'memory', text: 'Problems remembering things' },
];

const faqs = FAQ_ORDER.map(k => FAQ[k]);

// Shown under the heading and used as the sitemap lastmod.
const lastReviewed = '2026-10-16';
---

<Page
	breadcrumb="ME/CFS screening (DSQ-Brief)"
	faqs={faqs}
	title="ME/CFS screening questionnaire: free 4-question self-check"
	description="Free ME/CFS screening questionnaire with an instant score, no sign-up. Four questions from the DePaul Symptom Questionnaire Brief, in under two minutes."
>
			<div class="tool-header">
				<a href="/tools/" class="section-label tools">Tools</a>
				<h1>ME/CFS screening questionnaire</h1>
				<LastReviewed date={lastReviewed} />
				<p class="subtitle">The DSQ-Brief: a 4-item self-check</p>
				<p class="description">
					This is a free, interactive version of the <strong>DSQ-Brief</strong>, a short screening scale for myalgic encephalomyelitis / chronic fatigue syndrome (ME/CFS) developed by Leonard Jason and colleagues at DePaul University and published in 2023. It was drawn from the much longer DePaul Symptom Questionnaire: the authors picked the four symptom questions that identify people who meet the Institute of Medicine (IOM) case definition for ME/CFS.
				</p>
				<p class="description">
					<!-- REVIEW: rewritten; the four published items cover more than fatigue and post-exertional malaise. -->
					Those four items cover <strong>fatigue</strong>, tiredness after minimal exercise (a sign of <strong>post-exertional malaise</strong>), <strong>unrefreshing sleep</strong> and <strong>memory problems</strong>. In the validation study of 3,427 people, the four questions told people with ME/CFS apart from healthy controls with 96% accuracy (94% sensitivity, 98% specificity).
				</p>
				<p class="description">
					It is intended for anyone with persistent fatigue, a post-viral illness, or suspected ME/CFS who wants a quick, structured self-check before deciding whether to look into things further. It takes under two minutes. Answer each item for how it has been over the <strong>past six months</strong>, and you will get an immediate result with a per-symptom breakdown. No sign-up or email is required, and nothing you enter leaves your device. To characterise your post-activity symptom pattern in more depth, the <a href="/tools/dsq-pem/">DSQ-PEM</a> adds recovery time and triggers; for the complete assessment, take the full <a href="/tools/dsq-2/">DSQ-2</a>.
				</p>
			</div>

			<form id="dsq-form" novalidate>
				<div class="scale-key">
					<p>For each symptom, rate <strong>how often</strong> you have had it and <strong>how severe</strong> it has been, over the past six months.</p>
				</div>

				{items.map((item, i) => (
					<div class="symptom" data-id={item.id}>
						<p class="symptom-text"><span class="symptom-num">{i + 1}</span>{item.text}</p>
						<div class="ratings">
							<div class="rating-group">
								<span class="rating-label">How often</span>
								<div class="segmented">
									{freqOptions.map(opt => (
										<label title={opt.full}>
											<input type="radio" name={`${item.id}_f`} value={opt.value} required />
											<span>{opt.short}</span>
										</label>
									))}
								</div>
							</div>
							<div class="rating-group">
								<span class="rating-label">How severe</span>
								<div class="segmented">
									{sevOptions.map(opt => (
										<label title={opt.full}>
											<input type="radio" name={`${item.id}_s`} value={opt.value} required />
											<span>{opt.short}</span>
										</label>
									))}
								</div>
							</div>
						</div>
					</div>
				))}

				<div class="form-footer">
					<button type="submit" id="submit-btn">See my result</button>
					<button type="button" id="reset-btn">Clear all</button>
				</div>
			</form>

			<!-- Results panel -->
			<div id="results" class="results" hidden>
				<h2>Your DSQ-Brief result</h2>
				<div id="verdict" class="verdict"></div>
				<p id="summary-statement" class="score-interp"></p>

				<h3>Symptom breakdown</h3>
				<table class="item-table">
					<thead>
						<tr>
							<th>Symptom</th>
							<th>Frequency</th>
							<th>Severity</th>
							<th>Score</th>
							<th>Threshold</th>
						</tr>
					</thead>
					<tbody id="item-rows"></tbody>
				</table>
				<p class="table-note">Score is a 0–100 composite: (frequency + severity) ÷ 2 × 25. The threshold column shows whether the symptom met the 2/2 rule (both frequency and severity rated 2 or higher).</p>

				<div class="bridge">
					<h3>Why the full questionnaire matters</h3>
					<!-- REVIEW: accuracy figures corrected to the validation study (84% against other illnesses combined); the 93–94% figures belong to the DSQ-1 and DSQ-SF, not the DSQ-2. -->
					<p>The DSQ-Brief does well at telling ME/CFS apart from health: 96% accuracy against healthy controls in its validation study. Against a group with <em>other</em> illnesses that also cause fatigue (long COVID, multiple sclerosis or post-polio syndrome), accuracy fell to 84%. Four questions can only tell you so much.</p>
					<p>The full <strong>DePaul Symptom Questionnaire (DSQ-2)</strong> captures symptoms across eight domains, including orthostatic intolerance, cognitive impairment, pain, sleep disruption, and immune and temperature symptoms. Together these build a far more complete picture. In the same study, the longer DSQ-1 (54 items) and DSQ-SF (14 items) reached 94% and 93% accuracy against the other illnesses, and the authors suggest following the DSQ-Brief with a longer questionnaire.</p>
					<p>If you have time for something longer, the full version asks all 79 DSQ-2 symptom questions and checks your answers against four ME/CFS case definitions, which gives you a detailed record to take to a clinical appointment.</p>
					<a href="/tools/dsq-2/" class="cta-button">Take the full DSQ-2 questionnaire</a>
				</div>

				<div class="results-disclaimer">
					<!-- REVIEW: the old explanation said the 4-of-4 rule came from the validation study, which it does not; the scoring explanation is now in the section below the results. -->
					<p>How the verdict is worked out, and how accurate the screen is, is explained <a href="#understanding-dsq-brief">below the results</a>. If your symptoms clearly worsen in the hours or days after activity that used to be manageable, that is worth raising with a clinician whatever this screen says.</p>
					<p><strong>This result is not a diagnosis.</strong> It reflects what you have reported about your own symptoms. Discuss it with your doctor or specialist.</p>
				</div>

				<ScoreHistory toolId="dsq-brief" toolName="DSQ-Brief" />

				<button type="button" id="back-btn" class="back-btn">Edit answers</button>
			</div>

			<SharedResults toolId="dsq-brief" />

			<DsqBriefInterpretation>
				<div class="disclaimer" slot="disclaimer"><strong>This is not a diagnostic tool.</strong> A screening result reflects self-reported symptoms and is not a diagnosis of ME/CFS or any other condition. The DSQ-Brief is very good at telling ME/CFS apart from health, but less so from other fatiguing illnesses, so a result here is a starting point for a conversation with your doctor, not a conclusion.</div>
				<p class="citation" slot="citation">Based on: Jason LA, Benner S, Furst J, Cathey P. <em>Developing and validating a brief screening scale for ME/CFS.</em> Fatigue: Biomedicine, Health &amp; Behavior. 2023;11(2–4):176–87.</p>
			</DsqBriefInterpretation>
</Page>

<script>
import { dsqBrief, dsqBriefOutcome } from '../../tools/dsq-brief';
import { mountScoreHistory, mountSharedResults } from '../../scripts/results/scoreHistory';

const history = mountScoreHistory(dsqBrief);
mountSharedResults(dsqBrief);

// Same wording as the form above (DePaul's published DSQ-Brief).
const ITEMS: { id: string; text: string }[] = [
	{ id: 'fatigue', text: 'Fatigue/extreme tiredness' },
	{ id: 'minexercise', text: 'Minimum exercise makes you physically tired' },
	{ id: 'unrefreshed', text: 'Feeling unrefreshed after you wake up in the morning' },
	{ id: 'memory', text: 'Problems remembering things' },
];

const FREQ_LABELS = ['None of the time', 'A little of the time', 'Half of the time', 'Most of the time', 'All of the time'];
const SEV_LABELS = ['Symptom not present', 'Mild', 'Moderate', 'Severe', 'Very severe'];

function getVal(name: string): number | null {
	const checked = document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
	return checked ? parseInt(checked.value, 10) : null;
}

// When frequency is set to 0 (none of the time), the symptom is absent, so
// severity is automatically set to 0 and its buttons are disabled.
function wireAutoSeverity() {
	for (const item of ITEMS) {
		const freqInputs = document.querySelectorAll<HTMLInputElement>(`input[name="${item.id}_f"]`);
		freqInputs.forEach(inp => {
			inp.addEventListener('change', () => {
				const sevGroup = document.querySelector(`.symptom[data-id="${item.id}"] .rating-group:last-child .segmented`);
				if (!sevGroup) return;
				if (inp.checked && inp.value === '0') {
					const zero = document.querySelector<HTMLInputElement>(`input[name="${item.id}_s"][value="0"]`);
					if (zero) zero.checked = true;
					sevGroup.classList.add('auto-zero');
				} else if (inp.checked) {
					sevGroup.classList.remove('auto-zero');
				}
			});
		});
	}
}

const form = document.getElementById('dsq-form') as HTMLFormElement;
const resultsPanel = document.getElementById('results') as HTMLElement;
const verdictEl = document.getElementById('verdict') as HTMLElement;
const summaryEl = document.getElementById('summary-statement') as HTMLElement;
const itemRowsEl = document.getElementById('item-rows') as HTMLElement;

wireAutoSeverity();

form.addEventListener('submit', (e) => {
	e.preventDefault();

	const results = ITEMS.map(item => {
		const f = getVal(`${item.id}_f`);
		const s = getVal(`${item.id}_s`);
		return { item, f, s };
	});

	// Find first unanswered
	const missing = results.find(r => r.f === null || r.s === null);
	if (missing) {
		alert('Please rate both frequency and severity for all four symptoms.');
		document.querySelector(`.symptom[data-id="${missing.item.id}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
		return;
	}

	const scored = results.map(r => {
		const f = r.f as number;
		const s = r.s as number;
		const composite = ((f + s) / 2) * 25;
		const meets = f >= 2 && s >= 2;
		return { ...r, f, s, composite, meets };
	});

	const metCount = scored.filter(r => r.meets).length;

	// Verdict badge
	let verdictClass = 'neg';
	let verdictText = '';
	if (metCount === 4) {
		verdictClass = 'pos';
		verdictText = 'Screen positive: all 4 core symptoms met the threshold';
	} else if (metCount >= 1) {
		verdictClass = 'partial';
		verdictText = `Partial: ${metCount} of 4 core symptoms met the threshold`;
	} else {
		verdictClass = 'neg';
		verdictText = 'Screen negative: the threshold was not met';
	}
	verdictEl.className = `verdict ${verdictClass}`;
	verdictEl.textContent = verdictText;

	// Summary statement
	let summary = '';
	// REVIEW: Layer 1 copy. interpretResult adds nothing here (no total, no
	// bands, no published minimal important change), so the page writes it all.
	// The old text said the threshold came from the validation study; it does not.
	if (metCount === 4) {
		summary = 'All four symptoms (fatigue, tiredness after minimal exercise, unrefreshing sleep and memory problems) were reported at least half the time and at moderate severity or worse over the past six months, so the screen is positive. These are the core symptoms the screen was built around. It is a screen, not a diagnosis: the next step is the fuller questionnaire below and a conversation with your doctor.';
	} else if (metCount >= 1) {
		summary = `${metCount} of the 4 symptoms reached the threshold of at least half the time and at least moderate. This site counts the screen as positive only when all four do, but a partial result may still be worth discussing with your doctor, especially if tiredness after minimal exercise is one of them.`;
	} else {
		summary = 'None of the four symptoms reached the threshold of at least half the time and at least moderate, so the screen is negative. That does not rule out ME/CFS or another post-viral condition; if fatigue or worsening after activity is affecting your life, it is still worth raising with a clinician.';
	}
	summaryEl.textContent = summary;

	// Per-item table
	itemRowsEl.innerHTML = scored.map(r => `
		<tr class="${r.meets ? 'row-met' : ''}">
			<td>${r.item.text}</td>
			<td>${FREQ_LABELS[r.f]}</td>
			<td>${SEV_LABELS[r.s]}</td>
			<td>${Math.round(r.composite)}</td>
			<td>${r.meets ? '<span class="met">✓ Met</span>' : '<span class="notmet">Not met</span>'}</td>
		</tr>
	`).join('');

	const subscores: Record<string, number> = Object.fromEntries(scored.map(r => [r.item.id, Math.round(r.composite)]));
	subscores.met = metCount;
	history.record({ total: null, subscores, band: dsqBriefOutcome({ subscores }) });

	form.hidden = true;
	resultsPanel.hidden = false;
	resultsPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
});

document.getElementById('reset-btn')?.addEventListener('click', () => {
	form.reset();
	document.querySelectorAll('.segmented.auto-zero').forEach(el => el.classList.remove('auto-zero'));
});

document.getElementById('back-btn')?.addEventListener('click', () => {
	resultsPanel.hidden = true;
	form.hidden = false;
	form.scrollIntoView({ behavior: 'smooth', block: 'start' });
});
</script>

<style>
	.tool-header {
		padding-bottom: 1.5em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2.5em;
	}
	.tool-header h1 { margin: 0.3em 0 0.1em; }
	.subtitle { color: rgb(var(--gray)); font-size: 1.05em; margin: 0 0 0.75em; }
	.description { margin-bottom: 1em; }

	.scale-key {
		font-size: 0.9em;
		color: rgb(var(--gray-dark));
		border-radius: 3px;
		padding: 0.75em 1.25em;
		margin-bottom: 1.5em;
		border: 1px solid rgb(var(--gray-light));
	}
	.scale-key p { margin: 0; }

	/* Symptom cards with dual rating */
	.symptom {
		border-top: 1px solid rgb(var(--gray-light));
		padding: 1.25em 0;
		margin-bottom: 1em;
	}
	.symptom-text {
		margin: 0 0 1em;
		font-weight: 700;
		font-size: 1em;
		line-height: 1.4;
		display: flex;
		align-items: baseline;
		gap: 0.6em;
	}
	.symptom-num {
		flex-shrink: 0;
		font-weight: 700;
		color: rgb(var(--gray));
		font-variant-numeric: tabular-nums;
	}
	.ratings {
		display: flex;
		flex-direction: column;
		gap: 0.9em;
	}
	.rating-group {
		display: flex;
		flex-direction: column;
		gap: 0.4em;
	}
	.rating-label {
		font-size: 0.78em;
		font-weight: 700;
		color: rgb(var(--gray));
	}
	.segmented {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 0.35em;
	}
	.segmented label {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		font-size: 0.82em;
		line-height: 1.2;
		padding: 0.5em 0.3em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 3px;
		cursor: pointer;
		transition: background 0.1s, border-color 0.1s;
		min-height: 2.6em;
	}
	.segmented label:hover { border-color: var(--accent); }
	.segmented input { position: absolute; opacity: 0; width: 0; height: 0; }
	.segmented label:has(input:checked) {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
		font-weight: 700;
	}
	.segmented input:focus-visible + span {
		outline: 2px solid var(--accent-dark);
		outline-offset: 3px;
		border-radius: 2px;
	}
	.segmented.auto-zero { opacity: 0.55; }

	/* Form footer */
	.form-footer { display: flex; gap: 1em; padding: 2em 0 1em; }
	button[type="submit"] {
		background: var(--accent);
		color: #fff;
		border: none;
		padding: 0.75em 2em;
		border-radius: 3px;
		font-size: 1em;
		font-weight: 700;
		cursor: pointer;
		font-family: inherit;
	}
	button[type="submit"]:hover { background: var(--accent-dark); }
	button[type="button"] {
		background: none;
		border: 1px solid rgb(var(--gray-light));
		padding: 0.75em 1.5em;
		border-radius: 3px;
		font-size: 0.95em;
		cursor: pointer;
		color: rgb(var(--gray));
		font-family: inherit;
	}
	button[type="button"]:hover { border-color: rgb(var(--gray)); color: rgb(var(--black)); }

	/* Results */
	.results { padding-top: 1em; }
	.results h2 { margin-bottom: 0.75em; }
	.verdict {
		font-weight: 700;
		font-size: 1.02em;
		line-height: 1.35;
		display: block;
		padding: 0;
		margin: 0 0 0.75em;
	}
	.verdict.pos { color: #1e6b3c; }
	.verdict.partial { color: #9a6a12; }
	.verdict.neg { color: rgb(var(--gray-dark)); }
	.score-interp {
		font-size: 1.02em;
		line-height: 1.6;
		margin: 0 0 2em;
		padding: 0;
	}
	.item-table { margin: 1em 0 0.5em; font-size: 0.9em; }
	.item-table td, .item-table th { padding: 0.5em 0.6em; }
	/* Injected by script: anchor to the static .item-table container. */
	.item-table :global(.row-met) { background: transparent; }
	.item-table :global(.met) { color: #1e6b3c; font-weight: 700; white-space: nowrap; }
	.item-table :global(.notmet) { color: rgb(var(--gray)); white-space: nowrap; }
	.table-note { font-size: 0.82em; color: rgb(var(--gray)); margin: 0.5em 0 2em; }

	.bridge {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 3px;
		padding: 1.5em 1.75em;
		margin: 0 0 2em;
	}
	.bridge h3 { margin-top: 0; }
	.bridge p { font-size: 0.95em; line-height: 1.6; }
	.cta-button {
		display: inline-block;
		background: var(--accent);
		color: #fff;
		text-decoration: none;
		padding: 0.75em 1.5em;
		border-radius: 3px;
		font-weight: 700;
		font-size: 0.98em;
		margin-top: 0.5em;
	}
	.cta-button:hover { background: var(--accent-dark); color: #fff; }

	.results-disclaimer {
		font-size: 0.88em;
		color: rgb(var(--gray));
		border-top: 1px solid rgb(var(--gray-light));
		padding-top: 1.5em;
		line-height: 1.6;
	}
	.results-disclaimer h3 { color: rgb(var(--black)); }
	.back-btn {
		background: none;
		border: 1px solid rgb(var(--gray-light));
		padding: 0.6em 1.25em;
		border-radius: 3px;
		font-size: 0.95em;
		cursor: pointer;
		color: rgb(var(--gray));
		font-family: inherit;
		margin-top: 1.5em;
	}
	.back-btn:hover { border-color: var(--accent); color: var(--accent); }

	@media (max-width: 600px) {
		.symptom { padding: 1em 0; }
		.segmented { gap: 0.25em; }
		.segmented label { font-size: 0.72em; padding: 0.45em 0.15em; min-height: 3em; }
		.form-footer { flex-direction: column; }
		button[type="submit"], button[type="button"] { width: 100%; text-align: center; }
		.item-table { font-size: 0.82em; }
		.item-table td, .item-table th { padding: 0.4em 0.4em; }
	}
</style>
