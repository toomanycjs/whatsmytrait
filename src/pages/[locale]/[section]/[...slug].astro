---
// Translated posts. A content entry saved under a locale folder
// (src/content/testing/de/nurosym-week-1.md) renders here at
// /de/testing/nurosym-week-1/. English entries keep their existing routes.
import { getCollection, render } from 'astro:content';
import Post from '../../../layouts/Post.astro';
import { isLocale, localeOfId, ui, DEFAULT_LOCALE, type Locale } from '../../../i18n/config';
import { localizedPath } from '../../../i18n/registry';

type Section = 'testing' | 'evidence' | 'low-spoon-cooking';

export async function getStaticPaths() {
	// getStaticPaths is hoisted, so the section list must live inside it.
	const sections: Section[] = ['testing', 'evidence', 'low-spoon-cooking'];
	const paths = [];
	for (const section of sections) {
		const posts = await getCollection(section, (p) => !p.data.draft);
		for (const post of posts) {
			const { locale, rest } = localeOfId(post.id);
			if (locale === DEFAULT_LOCALE) continue;
			paths.push({ params: { locale, section, slug: rest }, props: { post, section } });
		}
	}
	return paths;
}

const { post, section } = Astro.props as { post: Awaited<ReturnType<typeof getCollection<Section>>>[number]; section: Section };
const locale: Locale = isLocale(Astro.params.locale) ? Astro.params.locale : DEFAULT_LOCALE;
const t = ui(locale);
const sectionHref = await localizedPath(locale, `/${section}/`);
const { Content } = await render(post);
---

<Post
	title={post.data.title}
	description={post.data.description}
	pubDate={post.data.pubDate}
	updatedDate={post.data.updatedDate}
	section={section}
	sectionLabel={t.nav[section]}
	sectionHref={sectionHref}
	series={post.data.series}
	ogImage={post.data.ogImage}
	lastModified={post.data.lastModified}
>
	<Content />
</Post>
