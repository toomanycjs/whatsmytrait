---
// The long-form template for methodology, about, licences and privacy: a
// page head, a table of contents in the margin column that follows the
// reader, and sections of prose. Pass `sections` for the contents; each
// section is a <section id="..."> in the slot with an h2.
import Page from './Page.astro';

interface Props {
	title: string;
	description: string;
	heading: string;
	subtitle?: string;
	breadcrumb?: string;
	sections: { id: string; title: string }[];
	sectionName?: string;
}

const { title, description, heading, subtitle, breadcrumb, sections, sectionName } = Astro.props;
---

<Page title={title} description={description} breadcrumb={breadcrumb ?? heading}>
	<section class="page-head">
		<div class="wrap row">
			<div class="aside"><p class="section-name">{sectionName ?? 'About the site'}</p></div>
			<div class="main">
				<h1>{heading}</h1>
				{subtitle && <p class="subtitle">{subtitle}</p>}
				<slot name="lead" />
			</div>
		</div>
	</section>
	<div class="wrap row longform">
		<nav class="aside toc" aria-label="Contents">
			<p class="toc-title">Contents</p>
			<ol>
				{sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
			</ol>
		</nav>
		<div class="main prose">
			<slot />
		</div>
	</div>
</Page>

<style is:global>
	.longform { padding-bottom: var(--s6); }
	.toc { position: sticky; top: var(--s4); }
	.toc-title { font-weight: 600; color: var(--ink); margin: 0 0 var(--s2); }
	.toc ol { list-style: none; margin: 0; padding: 0; }
	.toc li { margin: 0 0 var(--s1); }
	.toc a { color: var(--quiet); text-decoration: none; }
	.toc a:hover { color: var(--ink); text-decoration: underline; }
	.prose section { padding: var(--s4) 0; border-top: 1px solid var(--hair); }
	.prose section:first-child { border-top: 0; padding-top: 0; }
	.prose h2 { margin-bottom: var(--s3); scroll-margin-top: var(--s4); }
	.prose h3 { margin: var(--s4) 0 var(--s2); }
	@media (max-width: 760px) {
		.toc { position: static; margin-bottom: var(--s4); }
		.toc ol { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s3); }
	}
</style>
