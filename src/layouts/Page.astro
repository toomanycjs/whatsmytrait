---
// Shared shell for every page. Owns the <html lang>, the head (metadata,
// canonical, Open Graph), the header, the footer and the structured data
// (breadcrumb on every page, FAQPage when `faqs` is passed, WebSite on the
// homepage), so a page only supplies its title, description and content.
// Anything else for <head> goes in the "head" slot.
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import JsonLd from '../components/JsonLd.astro';
import { breadcrumbList, crumbsFor, faqPage, websiteNode, type FaqPair } from '../lib/schema';

interface Props {
	title: string;
	description: string;
	/** Override the generated /og/<path>.png image; an empty string sends none. */
	ogImage?: string;
	ogType?: 'website' | 'article';
	/** Name of this page in the breadcrumb; defaults to the title up to its first colon. */
	breadcrumb?: string;
	/** Questions and answers shown on the page, output as FAQPage. */
	faqs?: FaqPair[];
	/** False for pages that should carry no structured data (404). */
	structuredData?: boolean;
}

const { title, description, ogImage, ogType, breadcrumb, faqs, structuredData = true } = Astro.props;
const slug = Astro.url.pathname.replace(/^\/|\/$/g, '') || 'home';
const resolvedOgImage = ogImage === '' ? undefined : (ogImage ?? new URL(`/og/${slug}.png`, Astro.site).href);

const crumbs = crumbsFor(Astro.url.pathname, breadcrumb ?? title.split(':')[0].trim());
const schemaNodes = !structuredData
	? []
	: [
			crumbs.length === 1 ? websiteNode() : breadcrumbList(crumbs),
			...(faqs?.length ? [faqPage(faqs)] : []),
		];
---

<!doctype html>
<html lang="en-GB">
	<head>
		<BaseHead title={title} description={description} ogImage={resolvedOgImage} ogType={ogType} />
		<JsonLd nodes={schemaNodes} />
		<slot name="head" />
	</head>
	<body>
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
