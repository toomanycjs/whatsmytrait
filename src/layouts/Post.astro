---
import BaseHead from '../components/BaseHead.astro';
import JsonLd from '../components/JsonLd.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { DEFAULT_LOCALE, isLocale, ui } from '../i18n/config';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	lastModified?: Date;
	section: 'testing' | 'evidence' | 'tools' | 'nhs';
	sectionLabel: string;
	sectionHref: string;
	series?: string;
	ogImage?: string;
}

const { title, description, pubDate, updatedDate, lastModified, section, sectionLabel, sectionHref, series, ogImage } = Astro.props;

const lang = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const t = ui(lang);
const slug = Astro.url.pathname.replace(/^\//, '').replace(/\/$/, '');
const generatedOgImage = new URL(`/og/${slug}.png`, Astro.site).href;
const resolvedOgImage = ogImage ?? generatedOgImage;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const schemaType = section === 'evidence' ? 'MedicalWebPage' as const : 'BlogPosting' as const;
const effectiveModified = lastModified ?? updatedDate;
---

<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} ogImage={resolvedOgImage} ogType="article" />
		<JsonLd
			type={schemaType}
			title={title}
			description={description}
			pubDate={pubDate}
			updatedDate={effectiveModified}
			url={canonicalURL}
			image={resolvedOgImage}
			lang={lang}
		/>
	</head>
	<body>
		<Header />
		<main id="main">
			<article>
				<header class="post-header">
					<div class="meta">
						<a href={sectionHref} class={`section-label ${section}`}>{sectionLabel}</a>
						{series && <span class="series-tag">{series} series</span>}
					</div>
					<h1>{title}</h1>
					<p class="post-description">{description}</p>
					<div class="dates">
						<FormattedDate date={pubDate} locale={lang} />
						{updatedDate && (
							<span class="updated">· {t.updated} <FormattedDate date={updatedDate} locale={lang} /></span>
						)}
					</div>
					<hr />
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-header {
		margin-bottom: 2em;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.5em;
		margin-bottom: 0.75em;
	}
	.series-tag {
		font-size: 0.82em;
		color: rgb(var(--gray));
	}
	.series-tag::before {
		content: "·";
		margin-right: 0.5em;
	}
	h1 {
		margin: 0 0 0.4em;
		line-height: 1.2;
	}
	.post-description {
		color: rgb(var(--gray));
		font-size: 1.05em;
		margin: 0 0 0.75em;
		line-height: 1.5;
		text-wrap: pretty;
	}
	.dates {
		font-size: 0.88em;
		color: rgb(var(--gray));
	}
	.updated {
		opacity: 0.8;
	}
	.prose {
		max-width: 100%;
	}
	.prose :global(h2) { margin-top: 2em; }
	.prose :global(h3) { margin-top: 1.5em; }
</style>
