---
// Results opened from a share link (#r=...). Hidden unless the page loads with
// a valid fragment; mountSharedResults(config) fills it. Place it after the
// results panel so nothing new appears above the questionnaire.
import '../styles/score-history.css';

interface Props {
	toolId: string;
}

const { toolId } = Astro.props;
---

<section class="shared-results score-history" data-tool={toolId} hidden>
	<h2 tabindex="-1">Shared results (not saved on this device)</h2>
	<p class="sh-comparison"></p>
	<div class="sh-table-slot"></div>
	<div class="sh-chart-slot"></div>
	<div class="sh-actions">
		<button type="button" class="sh-btn" data-save>Save these to this device</button>
	</div>
	<p class="sh-save-status" role="status"></p>
</section>
