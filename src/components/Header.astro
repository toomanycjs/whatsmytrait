---
// Masthead: skip link, the site name in the margin column, the section links
// in the main column, one hairline under. Nothing sticky, no hamburger.
import { NAV, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="mast">
	<a href="#main" class="skip-link">Skip to content</a>
	<div class="wrap row">
		<a href="/" class="site-title">{SITE_TITLE}</a>
		{NAV.length > 0 && (
			<nav class="main-nav" aria-label="Main">
				<ul>
					{NAV.map((n) => <li><HeaderLink href={n.path}>{n.label}</HeaderLink></li>)}
				</ul>
			</nav>
		)}
	</div>
</header>
