---
// Skip link, site name and the section links from src/consts.ts. Unstyled
// until the style tile is approved; the structure is what the tile dresses.
import { NAV, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<a href="#main" class="skip-link">Skip to content</a>
	<nav aria-label="Main">
		<a href="/" class="site-title">{SITE_TITLE}</a>
		{NAV.length > 0 && (
			<ul class="nav-links">
				{NAV.map((n) => <li><HeaderLink href={n.path}>{n.label}</HeaderLink></li>)}
			</ul>
		)}
	</nav>
</header>
