---
import { SITE_TITLE } from '../consts';
import { DEFAULT_LOCALE, isLocale, ui } from '../i18n/config';
import { getAlternates, localizedPath } from '../i18n/registry';
import HeaderLink from './HeaderLink.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const t = ui(locale);

// Navigation stays in the visitor's language wherever a translated page
// exists and falls back to the English page otherwise, so it never 404s.
const NAV = [
	{ path: '/testing/', label: t.nav.testing },
	{ path: '/evidence/', label: t.nav.evidence },
	{ path: '/tools/', label: t.nav.tools },
	{ path: '/low-spoon-cooking/', label: t.nav['low-spoon-cooking'] },
	{ path: '/about/', label: t.nav.about },
	{ path: '/contact/', label: t.nav.contact },
];
const [homeHref, ...navHrefs] = await Promise.all([
	localizedPath(locale, '/'),
	...NAV.map((n) => localizedPath(locale, n.path)),
]);
const nav = NAV.map((n, i) => ({ ...n, href: navHrefs[i] }));
const alternates = await getAlternates(Astro.url.pathname);
const hasTranslations = alternates.length > 1;
---

<header>
	<a href="#main" class="skip-link">{t.skipLink}</a>
	<nav aria-label={t.mainNav}>
		<a href={homeHref} class="site-title">{SITE_TITLE}</a>
		<div class="nav-links">
			{nav.map((n) => <HeaderLink href={n.href}>{n.label}</HeaderLink>)}
		</div>
		{hasTranslations && <LanguageSwitcher class="lang-desktop" alternates={alternates} locale={locale} />}
		<button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
			<span></span><span></span><span></span>
		</button>
	</nav>
	{hasTranslations && (
		<div class="lang-strip">
			<LanguageSwitcher alternates={alternates} locale={locale} />
		</div>
	)}
	<div class="mobile-menu" id="mobile-menu" hidden>
		{nav.map((n) => <a href={n.href}>{n.label}</a>)}
	</div>
</header>

<script>
	const toggle = document.querySelector('.menu-toggle') as HTMLButtonElement;
	const menu = document.getElementById('mobile-menu');
	toggle?.addEventListener('click', () => {
		const open = toggle.getAttribute('aria-expanded') === 'true';
		toggle.setAttribute('aria-expanded', String(!open));
		if (menu) menu.hidden = open;
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: #fff;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	nav {
		width: 740px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 0 1em;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	.site-title {
		font-family: var(--font-serif);
		font-weight: 600;
		font-size: 1.2em;
		letter-spacing: -0.01em;
		color: rgb(var(--black));
		text-decoration: none;
		white-space: nowrap;
		flex-shrink: 0;
	}
	.site-title:hover { color: var(--accent); }
	.nav-links {
		display: flex;
		gap: 0.1em;
		align-items: center;
	}
	.nav-links :global(a) {
		padding: 0.4em 0.5em;
		white-space: nowrap;
		color: rgb(var(--gray));
		text-decoration: none;
		font-size: 0.9em;
		line-height: 1;
		border-bottom: 2px solid transparent;
		transition: color 0.15s, border-color 0.15s;
	}
	.nav-links :global(a:hover) {
		color: rgb(var(--black));
	}
	.nav-links :global(a.active) {
		color: rgb(var(--black));
		font-weight: 700;
		border-bottom-color: var(--accent);
	}
	/* Desktop: switcher sits in the bar. Mobile: a slim strip under the bar,
	   visible without opening the menu, since most tool use is on phones. */
	header :global(.lang-desktop) { margin-left: auto; }
	.lang-strip {
		display: none;
		width: 740px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 0.35em 1em;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 4px;
	}
	.menu-toggle span {
		display: block;
		width: 22px;
		height: 2px;
		background: rgb(var(--gray-dark));
	}
	.mobile-menu {
		border-top: 1px solid rgb(var(--gray-light));
		padding: 0.75em 1em;
		display: flex;
		flex-direction: column;
		gap: 0.25em;
	}
	.mobile-menu[hidden] { display: none; }
	.mobile-menu a {
		padding: 0.5em 0.25em;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 0.95em;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.mobile-menu a:last-child { border-bottom: none; }
	.mobile-menu a:hover { color: var(--accent); }
	/* The bar is full with six links; below ~820px the switcher moves to the strip. */
	@media (max-width: 820px) {
		header :global(.lang-desktop) { display: none; }
		.lang-strip { display: block; }
	}
	/* "Low Spoon Cooking" makes the links too long for one line below ~780px,
	   so the menu button takes over there rather than at phone width. */
	@media (max-width: 780px) {
		.nav-links { display: none; }
		.menu-toggle { display: flex; }
	}
</style>
