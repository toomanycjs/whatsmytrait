---
// A recipe's spoon rating as a row of spoons: the rated number drawn solid,
// the rest of the five in outline. Screen readers get the words instead.
interface Props {
	spoons: number;
	of?: number;
	size?: 'small' | 'large';
	/** Set when the rating is already written out in words next to it. */
	decorative?: boolean;
	class?: string;
}

const { spoons, of = 5, size = 'small', decorative = false, class: className } = Astro.props;
const label = `${spoons} out of ${of} spoons`;
---

<span
	class:list={['spoons', size, className]}
	{...(decorative ? { 'aria-hidden': 'true' } : { role: 'img', 'aria-label': label, title: label })}
>
	{Array.from({ length: of }, (_, i) => (
		<svg viewBox="0 0 12 32" aria-hidden="true" class:list={[{ on: i < spoons }]}>
			<ellipse cx="6" cy="7.5" rx="4.6" ry="6.5" />
			<rect x="4.9" y="13.5" width="2.2" height="17" rx="1.1" />
		</svg>
	))}
</span>

<style>
	.spoons {
		display: inline-flex;
		align-items: flex-end;
		gap: 0.18em;
		color: var(--cooking);
		vertical-align: middle;
		line-height: 1;
	}
	svg {
		height: 1.25em;
		width: auto;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.1;
		opacity: 0.45;
	}
	svg.on {
		fill: currentColor;
		opacity: 1;
	}
	.large svg { height: 2em; }
</style>
