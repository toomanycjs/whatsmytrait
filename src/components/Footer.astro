---
// Footer: the site name in the margin column; one sentence, the trust links
// and the year in the main column. No email box: nothing is collected.
import { FOOTER_NAV, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap row">
		<div class="aside"><p>{SITE_TITLE}</p></div>
		<div class="main">
			<p>Free, open tests. Scored on your device. Results describe tendencies and are not a diagnosis.</p>
			{FOOTER_NAV.length > 0 && (
				<nav aria-label="Site">
					{FOOTER_NAV.map((n) => <a href={n.path}>{n.label}</a>)}
				</nav>
			)}
			<p>&copy; {year} {SITE_TITLE}</p>
		</div>
	</div>
</footer>
