---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p class="tagline">One person's documented experience of post-viral syndrome.</p>
		<p class="disclaimer-note">
			Nothing here is medical advice. I'm not a clinician; I'm a patient trying to make sense of my own condition. Always discuss any intervention with your doctor.
		</p>
		<div class="signup-block">
			<p class="signup-label">Get new posts by email</p>
			<form
				action="https://buttondown.email/api/emails/embed-subscribe/postviralrecovery"
				method="post"
				target="popupwindow"
				class="signup-form"
			>
				<input type="email" name="email" placeholder="your@email.com" required />
				<button type="submit">Subscribe</button>
			</form>
			<p class="signup-note">No spam. Unsubscribe any time.</p>
		</div>
		<nav class="footer-links">
			<a href="/testing">Testing</a>
			<a href="/evidence">Evidence</a>
			<a href="/tools">Tools</a>
			<a href="/nhs">NHS</a>
			<a href="/about">About</a>
			<a href="/contact">Contact</a>
		</nav>
		<p class="copyright">&copy; {today.getFullYear()} Post Viral Recovery</p>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid rgb(var(--gray-light));
		margin-top: 4em;
		padding: 2.5em 1em;
		color: rgb(var(--gray));
		font-size: 0.88em;
	}
	.footer-inner {
		width: 740px;
		max-width: calc(100% - 2em);
		margin: auto;
		display: flex;
		flex-direction: column;
		gap: 0.5em;
	}
	.tagline {
		font-weight: 700;
		color: rgb(var(--gray-dark));
		margin: 0;
	}
	.disclaimer-note {
		margin: 0;
		line-height: 1.5;
	}
	.footer-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25em 1em;
		margin: 0.5em 0 0;
	}
	.footer-links a {
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.footer-links a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.signup-block {
		border-top: 1px solid rgb(var(--gray-light));
		margin-top: 0.75em;
		padding-top: 1.25em;
		display: flex;
		flex-direction: column;
		gap: 0.4em;
	}
	.signup-label {
		margin: 0;
		font-weight: 600;
		color: rgb(var(--gray-dark));
	}
	.signup-form {
		display: flex;
		gap: 0.5em;
		flex-wrap: wrap;
	}
	.signup-form input[type="email"] {
		flex: 1;
		min-width: 200px;
		padding: 0.45em 0.75em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 4px;
		font-size: 0.95em;
		font-family: inherit;
		color: rgb(var(--gray-dark));
		background: #fff;
	}
	.signup-form input[type="email"]:focus {
		outline: 2px solid var(--accent);
		border-color: transparent;
	}
	.signup-form button {
		padding: 0.45em 1.1em;
		background: var(--accent);
		color: #fff;
		border: none;
		border-radius: 4px;
		font-size: 0.95em;
		font-family: inherit;
		cursor: pointer;
	}
	.signup-form button:hover {
		opacity: 0.88;
	}
	.signup-note {
		margin: 0;
		font-size: 0.82em;
		color: rgb(var(--gray));
	}
	.copyright {
		margin: 0.25em 0 0;
		font-size: 0.9em;
	}
</style>
