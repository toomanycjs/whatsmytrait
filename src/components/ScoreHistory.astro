---
// Saved-results block for a tool page: the "saved on this device" notice,
// history (comparison sentence, table, line chart, delete), retake reminder,
// export controls and privacy note. Goes inside the results panel, after the
// score breakdown; the page's script calls mountScoreHistory(config) and then
// controller.record(result) when a score is produced. The reminder row works
// even when localStorage is unavailable; everything else stays hidden then.
import ClinicianSummary from './ClinicianSummary.astro';
import '../styles/score-history.css';

interface Props {
	toolId: string;
	toolName: string;
	/** Reminder repeat interval in months; must match the tool config. */
	reminderMonths?: number;
}

const { toolId, toolName, reminderMonths = 1 } = Astro.props;
const monthly = reminderMonths === 1;
const reminderCopy = monthly
	? 'Symptom scores change slowly. A monthly retake is enough to see a trend.'
	: `Symptom scores change slowly. Retaking the ${toolName} every ${reminderMonths} months is enough to see a trend.`;
const icsLabel = monthly ? 'Add a monthly reminder (.ics)' : `Add a reminder every ${reminderMonths} months (.ics)`;
---

<section class="score-history" data-tool={toolId}>
	<p class="sh-notice" role="status" tabindex="-1"></p>

	<div class="sh-history" hidden>
		<h3 class="sh-heading" tabindex="-1">Your results over time</h3>
		<p class="sh-first" hidden>Complete this again in a few weeks and the change will show here.</p>
		<p class="sh-comparison" hidden></p>
		<div class="sh-table-slot"></div>
		<div class="sh-chart-slot"></div>
		<div class="sh-delete-all"></div>
	</div>

	<div class="sh-reminder">
		<p>{reminderCopy}</p>
		<div class="sh-actions">
			<button type="button" class="sh-btn" data-reminder="ics">{icsLabel}</button>
			<a class="sh-btn" data-reminder="google" href="https://calendar.google.com/calendar/render" target="_blank" rel="noopener">Add to Google Calendar</a>
		</div>
	</div>

	<div class="sh-export" hidden>
		<div class="sh-actions">
			<button type="button" class="sh-btn" data-export="text">Copy as text</button>
			<button type="button" class="sh-btn" data-export="csv">Download CSV</button>
			<button type="button" class="sh-btn" data-export="link">Share link</button>
		</div>
		<p class="sh-export-status" role="status"></p>
	</div>

	<ClinicianSummary toolId={toolId} path={`/tools/${toolId}/`} />

	<p class="sh-my-results" hidden><a href="/tools/my-results/">See all your saved results</a></p>

	<!-- REVIEW: privacy wording from the brief, for Craig to approve. -->
	<p class="sh-privacy" hidden>Your results are stored only in this browser, on this device. Nothing is sent to us or to anyone else. They will be lost if you clear this site's data, use a private window, or switch browser or device. You can delete them at any time.</p>
</section>
