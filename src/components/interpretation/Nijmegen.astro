---
// REVIEW: Layer 2 interpretation for the Nijmegen Questionnaire, drafted for
// Craig's review. FAQ answers come from nijmegen.content.ts and are shown word
// for word (they also feed the page's FAQPage JSON-LD).
import { FAQ, REFERENCE, SOURCES } from '../../tools/nijmegen.content';
import '../../styles/interpretation.css';
const s = SOURCES;
---

<section class="interpretation" aria-labelledby="understanding-nijmegen">
	<h2 id="understanding-nijmegen">Understanding your Nijmegen score</h2>

	<h3 id="what-it-measures">What the score measures</h3>
	<p>{FAQ.measures.a}</p>
	<p>
		In the 1985 validation it separated 75 patients diagnosed with hyperventilation syndrome from 80 health care
		workers with 91% sensitivity and 95% specificity
		(<a href={s.vanDixhoorn1985.href} rel="noopener">{s.vanDixhoorn1985.label}</a>). It is free to use
		(<a href={s.vanDixhoorn2015.href} rel="noopener">{s.vanDixhoorn2015.label}</a>).
	</p>

	<h3 id="score-bands">Score bands</h3>
	<p>{FAQ.normal.a}</p>
	<table class="interp-table">
		<caption>Nijmegen reference points from the authors' validation data</caption>
		<thead>
			<tr><th scope="col">Score</th><th scope="col">What it is</th></tr>
		</thead>
		<tbody>
			{REFERENCE.map(r => <tr><th scope="row">{r.score}</th><td>{r.finding}</td></tr>)}
		</tbody>
	</table>
	<p>{FAQ.score23.a}</p>

	<h3 id="change">What a change in score means</h3>
	<p>{FAQ.change.a}</p>
	<p>
		Researchers have asked for a minimal important change to be worked out
		(<a href={s.thomas2015.href} rel="noopener">{s.thomas2015.label}</a>).
	</p>

	<h3 id="what-it-does-not-measure">What it does not measure</h3>
	<p>{FAQ.diagnosis.a}</p>
	<p>
		The <a href="/tools/self-evaluation-of-breathing-questionnaire/">SEBQ</a> covers restricted, effortful breathing
		better. The <a href="/evidence/breathing-pattern-disorder-vs-autonomic-breathlessness/">breathing pattern disorder
		versus autonomic breathlessness explainer</a> covers the overlap with POTS, and
		<a href="/testing/diaphragmatic-breathing/">diaphragmatic breathing</a> describes one approach to retraining.
	</p>

	<h3 id="taking-it-to-your-gp">Taking this to your GP or consultant</h3>
	<p>
		Bring the total, the date, which symptoms you scored 3 or 4, and the trend from your saved results. Describe it as a
		16-item symptom questionnaire widely used in clinical practice to screen for breathing pattern disorder
		(<a href={s.bondarenko2026.href} rel="noopener">{s.bondarenko2026.label}</a>). It can support a request for referral to respiratory physiotherapy. New, worsening or severe
		breathlessness, or breathlessness with chest pain, needs a medical assessment whatever the score. See
		<a href="/nhs/preparing-for-gp-appointment/">preparing for a GP appointment</a>.
	</p>

	<h3 id="sources">Sources</h3>
	<ul class="interp-sources">
		<li>van Dixhoorn J, Duivenvoorden HJ. Efficacy of Nijmegen Questionnaire in recognition of the hyperventilation syndrome. <em>J Psychosom Res</em> 1985;29(2):199–206. <a href={s.vanDixhoorn1985.href} rel="noopener">Article</a></li>
		<li>van Dixhoorn J, Folgering H. The Nijmegen Questionnaire and dysfunctional breathing. <em>ERJ Open Res</em> 2015;1:00001-2015. <a href={s.vanDixhoorn2015.href} rel="noopener">Full text</a></li>
		<li>Thomas M, Bruton A, Ainsworth B. Use of the Nijmegen Questionnaire in asthma. <em>ERJ Open Res</em> 2015;1:00033-2015. <a href={s.thomas2015.href} rel="noopener">Full text</a></li>
		<li>Bondarenko J, Grillo L, Denton E, Button B, Hew M, Holland A. Breathing pattern disorder: assessment and diagnosis. <em>ERJ Open Res</em> 2026. <a href={s.bondarenko2026.href} rel="noopener">Full text</a></li>
	</ul>
</section>
