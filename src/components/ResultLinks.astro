---
// Score-dependent links inside a results panel. Empty and hidden until a
// result is produced; src/scripts/results/resultLinks.ts fills it from
// ScoreHistory's record(), so the page needs no script of its own.
import '../styles/related.css';

interface Props {
	toolId: string;
}

const { toolId } = Astro.props;
---

<div class="result-links" data-tool={toolId} hidden></div>
