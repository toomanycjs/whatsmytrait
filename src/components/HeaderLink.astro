---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

const trim = (p: string) => p.replace(/\/+$/, '') || '/';
const current = trim(Astro.url.pathname);
const target = trim(String(href ?? ''));
const isActive = target === current || (target !== '/' && current.startsWith(`${target}/`));
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}>
	<slot />
</a>
