---
// "Summary for your clinician": the button and optional name/date-of-birth
// fields in a results panel, and the one-page print-only sheet they print.
// Rendered by ScoreHistory for tools with an entry in
// src/tools/clinician-summary.ts; renders nothing otherwise. The static parts
// (instrument details, citation, URL, QR code) are built here; the result,
// history and patient details are filled in by
// src/scripts/results/clinicianSummary.ts at print time, in the browser only.
import QRCode from 'qrcode';
import { SUMMARIES } from '../tools/clinician-summary';
import '../styles/clinician-summary.css';

interface Props {
	toolId: string;
	/** Site path of the tool page, e.g. "/tools/compass-31/". */
	path: string;
}

const { toolId, path } = Astro.props;
const s = SUMMARIES[toolId];
const url = new URL(path, Astro.site).href;
const qr = s ? await QRCode.toString(url, { type: 'svg', errorCorrectionLevel: 'M', margin: 0, color: { dark: '#000000', light: '#ffffff' } }) : '';
---

{s && (
	<Fragment>
		<div class="cs-controls" data-tool={toolId}>
			<h3>Summary for your clinician</h3>
			<p class="cs-lead">A one-page printout of this result and any earlier saved results, with the instrument's reference. Choose "Save as PDF" in the print dialog to keep a copy.</p>
			<div class="cs-fields">
				<label>Name <span class="cs-optional">(optional)</span><input type="text" name="cs-name" autocomplete="off" /></label>
				<label>Date of birth <span class="cs-optional">(optional)</span><input type="text" name="cs-dob" autocomplete="off" inputmode="numeric" /></label>
			</div>
			<p class="cs-note">These two fields go on the printout only. They are not saved or sent anywhere.</p>
			<button type="button" class="sh-btn cs-print">Print summary for your clinician</button>
		</div>

		<section class="cs-sheet" data-tool={toolId} aria-hidden="true">
			<header class="cs-head">
				<div>
					<p class="cs-title">{s.fullName}{s.abbreviation && ` (${s.abbreviation})`}</p>
					<p class="cs-sub">Patient-completed self-report</p>
				</div>
				<dl class="cs-meta">
					<div><dt>Date completed</dt><dd data-cs="date"></dd></div>
					<div><dt>Name</dt><dd data-cs="name"></dd></div>
					<div><dt>Date of birth</dt><dd data-cs="dob"></dd></div>
				</dl>
			</header>

			<h2>Result</h2>
			<div class="cs-result">
				<div>
					<p class="cs-total" data-cs="total"></p>
					<p class="cs-outcome" data-cs="outcome"></p>
				</div>
				<table class="cs-table" data-cs="subscores"></table>
			</div>

			<div data-cs="history">
				<h2>Change over time</h2>
				<p class="cs-small" data-cs="history-note"></p>
				<table class="cs-table cs-history" data-cs="history-table"></table>
				<div data-cs="chart"></div>
			</div>

			<h2>About this instrument</h2>
			{s.about.map(line => <p class="cs-about">{line}</p>)}

			<h2>Reference</h2>
			<p class="cs-ref">{s.citation}{s.doi && ` doi:${s.doi}`}</p>
			{s.attribution && <p class="cs-ref">{s.attribution}</p>}

			<footer class="cs-foot">
				<div>
					<p class="cs-caveat">Not a diagnosis. Scores reflect the patient's own report.</p>
					<p class="cs-url">Free online version with automatic scoring: {url}</p>
				</div>
				<div class="cs-qr" set:html={qr} />
			</footer>
		</section>
	</Fragment>
)}
