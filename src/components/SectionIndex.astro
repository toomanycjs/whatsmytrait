---
import FormattedDate from './FormattedDate.astro';

interface Post {
	id: string;
	data: {
		title: string;
		description: string;
		pubDate: Date;
		series?: string;
		draft?: boolean;
	};
	href: string;
}

interface Props {
	title: string;
	description: string;
	section: 'testing' | 'evidence' | 'tools' | 'nhs';
	posts: Post[];
	intro?: string;
}

const { title, description: desc, section, posts, intro } = Astro.props;

// Group by series for testing section
const seriesGroups = new Map<string, Post[]>();
const unserialized: Post[] = [];
for (const post of posts) {
	if (post.data.series) {
		const key = post.data.series;
		if (!seriesGroups.has(key)) seriesGroups.set(key, []);
		seriesGroups.get(key)!.push(post);
	} else {
		unserialized.push(post);
	}
}
const hasSeries = seriesGroups.size > 0;
---

<style>
	.section-header {
		padding-bottom: 1.5em;
		border-bottom: 1px solid rgb(var(--gray-light));
		margin-bottom: 2em;
	}
	.section-header h1 { margin-bottom: 0.25em; }
	.section-intro { color: rgb(var(--gray)); font-size: 1em; margin: 0; }

	.series-group { margin-bottom: 2.5em; }
	.series-title {
		font-size: 0.8em;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgb(var(--gray));
		margin-bottom: 0.75em;
	}

	.post-list { list-style: none; margin: 0; padding: 0; }
	.post-item {
		display: block;
		padding: 1em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
		text-decoration: none;
	}
	.post-item:hover h3 { color: var(--accent); }
	.post-meta {
		display: flex;
		align-items: center;
		gap: 0.5em;
		margin-bottom: 0.2em;
	}
	.post-date { font-size: 0.82em; color: rgb(var(--gray)); }
	.post-item h3 { margin: 0 0 0.2em; font-size: 1em; color: rgb(var(--black)); }
	.post-item p { margin: 0; font-size: 0.88em; color: rgb(var(--gray)); line-height: 1.5; }

	.empty { color: rgb(var(--gray)); font-style: italic; padding: 2em 0; }
</style>

<div class="section-header">
	<span class={`section-label ${section}`}>{title}</span>
	<h1>{title}</h1>
	{intro && <p class="section-intro">{intro}</p>}
</div>

{posts.length === 0 ? (
	<p class="empty">No posts yet — check back soon.</p>
) : hasSeries ? (
	<>
		{[...seriesGroups.entries()].map(([series, seriesPosts]) => (
			<div class="series-group">
				<p class="series-title">{series}</p>
				<ul class="post-list">
					{seriesPosts.map(post => (
						<li>
							<a href={post.href} class="post-item">
								<div class="post-meta">
									<time class="post-date"><FormattedDate date={post.data.pubDate} /></time>
								</div>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</a>
						</li>
					))}
				</ul>
			</div>
		))}
		{unserialized.length > 0 && (
			<div class="series-group">
				<p class="series-title">Other posts</p>
				<ul class="post-list">
					{unserialized.map(post => (
						<li>
							<a href={post.href} class="post-item">
								<div class="post-meta">
									<time class="post-date"><FormattedDate date={post.data.pubDate} /></time>
								</div>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</a>
						</li>
					))}
				</ul>
			</div>
		)}
	</>
) : (
	<ul class="post-list">
		{posts.map(post => (
			<li>
				<a href={post.href} class="post-item">
					<div class="post-meta">
						<time class="post-date"><FormattedDate date={post.data.pubDate} /></time>
					</div>
					<h3>{post.data.title}</h3>
					<p>{post.data.description}</p>
				</a>
			</li>
		))}
	</ul>
)}
