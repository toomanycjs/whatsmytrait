---
// Renders a recipe's ingredient groups from its frontmatter (see
// src/lib/recipe.ts). Use in a recipe's MDX body as
// <RecipeIngredients groups={frontmatter.recipe.ingredients} />
import { inline, slug, type IngredientGroup } from '../lib/recipe';

interface Props {
	groups: IngredientGroup[];
}

const { groups } = Astro.props;
---

{groups.map((g) => (
	<Fragment>
		{g.heading && <h3 id={slug(g.heading)}>{g.heading}</h3>}
		{g.intro && <p set:html={inline(g.intro)} />}
		<ul>
			{g.items.map((item) => <li set:html={inline(item)} />)}
		</ul>
		{g.note && <p set:html={inline(g.note)} />}
	</Fragment>
))}
